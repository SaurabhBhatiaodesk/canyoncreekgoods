{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign seo_title = page_title | default: shop.name
  assign seo_description = page_description
  if seo_description == blank
    case request.page_type
      when 'product'
        assign seo_description = product.description | strip_html | strip_newlines | strip | truncate: 160
      when 'collection'
        assign seo_description = collection.description | strip_html | strip_newlines | strip | truncate: 160
        if seo_description == blank
          if collection.handle == 'all'
            assign seo_description = 'Browse all Canyon Creek Goods products, including wool cowls, sling bags, denim outerwear, sweatshirts and western accessories.'
          else
            assign seo_description = 'Explore the ' | append: collection.title | append: ' collection at ' | append: shop.name | append: '. View product details and current availability.'
          endif
        endif
      when 'page'
        assign seo_description = page.content | strip_html | strip_newlines | strip | truncate: 160
      when 'article'
        assign seo_description = article.excerpt_or_content | strip_html | strip_newlines | strip | truncate: 160
      when 'blog'
        assign seo_description = 'Read ' | append: blog.title | append: ' from ' | append: shop.name | append: '.'
      when 'list-collections'
        assign seo_description = 'Explore Canyon Creek Goods collections, including wool cowls, sling bags, denim outerwear, sweatshirts and western accessories.'
      when 'search'
        assign seo_description = 'Search Canyon Creek Goods products, collections and pages.'
      when 'cart'
        assign seo_description = 'Review the items in your Canyon Creek Goods shopping cart.'
      when '404'
        assign seo_description = 'This page could not be found. Explore the Canyon Creek Goods shop or contact us for help.'
    endcase
  endif
  assign og_title = seo_title
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url | escape }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ seo_title | escape }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' | escape }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless seo_title contains shop.name %} &ndash; {{ shop.name | escape }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url | escape }}"
>

{% if seo_description != blank %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}
