{%- doc -%}
  Continuously scrolling announcement ticker. Type matches client mockup: Barlow Condensed 14px.
{%- enddoc -%}

{% liquid
  assign items = 'Free shipping, no minimum|Hand cut in Snowflake, Arizona|One of one — never made twice|Premium US-milled wool|Melissa answers her own email' | split: '|'
%}

<div class="ccg-marquee">
  <div class="ccg-marquee__track">
    <div class="ccg-marquee__group">
      {%- for item in items -%}
        <span class="ccg-marquee__item">
          <span class="ccg-marquee__text">{{ item }}</span>
          <span class="ccg-marquee__dot" aria-hidden="true"></span>
        </span>
      {%- endfor -%}
    </div>
    <div class="ccg-marquee__group" aria-hidden="true">
      {%- for item in items -%}
        <span class="ccg-marquee__item">
          <span class="ccg-marquee__text">{{ item }}</span>
          <span class="ccg-marquee__dot"></span>
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  .ccg-marquee {
    background: #f8f5ee;
    overflow: hidden;
    padding: 12px 0;
    border-bottom: 1px solid rgba(33, 28, 23, 0.14);
  }

  .ccg-marquee__track {
    display: flex;
    width: max-content;
    animation: ccg-marquee-scroll 40s linear infinite;
  }

  .ccg-marquee__group {
    display: flex;
    flex: none;
  }

  .ccg-marquee__item {
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 0 26px;
    flex-shrink: 0;
  }

  .ccg-marquee__text {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.2em;
    color: #5c5145;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ccg-marquee__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #b98a52;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .ccg-marquee__track {
      animation: none;
    }
  }

  @keyframes ccg-marquee-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }
{% endstyle %}
