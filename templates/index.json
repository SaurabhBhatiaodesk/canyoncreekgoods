    "1789970456d7dd69fc": {
      "type": "_blocks",
      "blocks": {
        "custom_liquid_kdwMTB": {
          "type": "custom-liquid",
          "name": "t:names.custom_liquid",
          "settings": {
            "custom_liquid": "<section class=\"ccg-gift-section\">\n  <div class=\"ccg-gift-inner\">\n    <div class=\"ccg-gift-intro\">\n      <p class=\"ccg-gift-tagline\">\n        Handmade. Western. Ready to gift.\n      </p>\n\n      <h2 class=\"ccg-gift-heading\">\n        Gift the Crew\n      </h2>\n\n      <p class=\"ccg-gift-description\">\n        Our wool cowls make an easy and genuinely useful gift this winter.\n        No sizing, no guessing, just premium cozy wool. Each cowl comes\n        individually packaged and gift-ready with wool care instructions and\n        a QR code linking to our cowl-wearing tutorial video. All you have to\n        do is hand them out!\n      </p>\n    </div>\n\n    <div class=\"ccg-gift-offers\">\n      <div class=\"ccg-gift-offer\">\n        <div class=\"ccg-gift-offer-header\">\n          <h3>Gift 10 cowls</h3>\n\n          <p>\n            Easy, thoughtful gifts for your small crew, office, shop, team or clients.\n          </p>\n        </div>\n\n        <div class=\"ccg-gift-widget\">\n          <mbc-bundles-widget data-bundle-id=\"127991\"></mbc-bundles-widget>\n        </div>\n      </div>\n\n      <div class=\"ccg-gift-offer\">\n        <div class=\"ccg-gift-offer-header\">\n          <h3>Gift 20 cowls</h3>\n\n          <p>\n            For the whole dang crew, plus a few extras.\n          </p>\n        </div>\n\n        <div class=\"ccg-gift-widget\">\n          <mbc-bundles-widget data-bundle-id=\"127993\"></mbc-bundles-widget>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ccg-gift-contact\">\n      <h3>Got a big crew?</h3>\n\n      <p>\n        No worries,\n        <a href=\"mailto:canyoncreekgoods@gmail.com\">\n          send me an email\n        </a>\n        and I'll sort out the rest.\n      </p>\n    </div>\n  </div>\n</section>\n\n<style>\n  .ccg-gift-section {\n    width: 100%;\n    background: #F8F5EE;\n    color: var(--ccg-ink);\n    font-family: 'Karla', system-ui, sans-serif;\n  }\n\n  .ccg-gift-inner {\n    width: 100%;\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 64px 24px;\n  }\n\n  .ccg-gift-intro {\n    max-width: 820px;\n    margin-bottom: 44px;\n  }\n\n  .ccg-gift-tagline {\n    margin: 0 0 10px;\n    color: var(--ccg-tan);\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 15px;\n    font-weight: 400;\n    line-height: 1.5;\n    letter-spacing: 0.24em;\n    text-transform: uppercase;\n  }\n\n  .ccg-gift-heading {\n    max-width: 700px;\n    margin: 0 0 24px;\n    color: var(--ccg-ink);\n    font-family: 'Rye', serif;\n    font-size: 40px;\n    font-weight: 400;\n    line-height: 1.3;\n  }\n\n  .ccg-gift-description {\n    max-width: 760px;\n    margin: 0;\n    color: var(--ccg-muted);\n    font-family: 'Karla', system-ui, sans-serif;\n    font-size: 17px;\n    font-weight: 300;\n    line-height: 1.75;\n    text-wrap: pretty;\n  }\n\n  .ccg-gift-offers {\n    display: flex;\n    flex-direction: column;\n    gap: 40px;\n  }\n\n  .ccg-gift-offer {\n    padding: 28px;\n    border: 1px solid rgba(92, 81, 69, 0.3);\n    background: transparent;\n  }\n\n  .ccg-gift-offer-header {\n    margin-bottom: 24px;\n  }\n\n  .ccg-gift-offer-header h3,\n  .ccg-gift-contact h3 {\n    margin: 0 0 10px;\n    color: var(--ccg-ink);\n    font-family: 'Rye', serif;\n    font-size: 25px;\n    font-weight: 400;\n    line-height: 1.3;\n  }\n\n  .ccg-gift-offer-header p,\n  .ccg-gift-contact p {\n    margin: 0;\n    color: var(--ccg-muted);\n    font-family: 'Karla', system-ui, sans-serif;\n    font-size: 17px;\n    font-weight: 300;\n    line-height: 1.6;\n  }\n\n  .ccg-gift-widget,\n  .ccg-gift-widget mbc-bundles-widget {\n    display: block;\n    width: 100%;\n    color: var(--ccg-ink);\n    font-family: 'Karla', system-ui, sans-serif;\n  }\n\n  .ccg-gift-contact {\n    margin-top: 40px;\n    padding-top: 28px;\n    border-top: 1px solid rgba(92, 81, 69, 0.3);\n  }\n\n  .ccg-gift-contact a {\n    padding-bottom: 2px;\n    border-bottom: 1px solid var(--ccg-ink);\n    color: var(--ccg-ink);\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 18px;\n    font-weight: 400;\n    letter-spacing: 0.08em;\n    text-decoration: none;\n    text-transform: uppercase;\n    transition:\n      color 0.2s ease,\n      border-color 0.2s ease;\n  }\n\n  .ccg-gift-contact a:hover {\n    color: var(--ccg-tan);\n    border-color: var(--ccg-tan);\n  }\n\n  @media screen and (max-width: 989px) {\n    .ccg-gift-inner {\n      padding: 56px 40px;\n    }\n\n    .ccg-gift-heading {\n      font-size: 32px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .ccg-gift-inner {\n      padding: 48px 16px;\n    }\n\n    .ccg-gift-intro {\n      margin-bottom: 32px;\n    }\n\n    .ccg-gift-heading {\n      font-size: 28px;\n    }\n\n    .ccg-gift-description,\n    .ccg-gift-offer-header p,\n    .ccg-gift-contact p {\n      font-size: 16px;\n    }\n\n    .ccg-gift-offers {\n      gap: 28px;\n    }\n\n    .ccg-gift-offer {\n      padding: 20px 16px;\n    }\n\n    .ccg-gift-offer-header h3,\n    .ccg-gift-contact h3 {\n      font-size: 22px;\n    }\n\n    .ccg-gift-contact a {\n      font-size: 16px;\n    }\n  }\n</style>"
