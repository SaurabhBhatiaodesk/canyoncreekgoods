{%- liquid
  assign description_text = page_description | strip
-%}

{%- if description_text != blank -%}
  <div
    class="ccg-product-description"
    style="--ccg-product-description-color: {{ block.settings.text_color }};"
    {{ block.shopify_attributes }}
  >
    {{ description_text }}
  </div>
{%- endif -%}

{% stylesheet %}
  .ccg-product-description {
    max-width: 640px;
    font-family: 'Karla', system-ui, sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ccg-product-description-color);
  }

  @media screen and (max-width: 749px) {
    .ccg-product-description {
      font-size: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Product Description",
  "tag": null,
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#5c5145"
    }
  ],
  "presets": [
    {
      "name": "CCG Product Description",
      "category": "Product"
    }
  ]
}
{% endschema %}
