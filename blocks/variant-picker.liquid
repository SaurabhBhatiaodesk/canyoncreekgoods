

{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{% unless product_resource == blank %}
  {% render 'variant-main-picker', product_resource: product_resource, section: section, product: product %}
{% endunless %}

{% stylesheet %}
  .product-details .variant-picker {
    font-family: 'Barlow Condensed', sans-serif;
  }

  .product-details .variant-option--buttons {
    gap: 12px;
  }

  .product-details .variant-option--equal-width-buttons {
    display: flex;
    flex-wrap: wrap;
  }

  .product-details .variant-option--buttons legend,
  .product-details .variant-option--dropdowns > label,
  .product-details .variant-option[data-testid='variant-option-single'] {
    margin-block-end: 12px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ccg-ink);
  }

  .product-details .variant-option__button-label:not(.variant-option__button-label--has-swatch) {
    min-width: 120px;
    min-height: 52px;
    padding: 0 24px;
    border: 1px solid #b9b0a4;
    border-radius: 0;
    background: transparent;
    color: rgb(92, 81, 69);
    font-family: 'Barlow Condensed', sans-serif;
    font-size:17px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .product-details .variant-option__button-label:not(.variant-option__button-label--has-swatch)::before,
  .product-details .variant-option__button-label:not(.variant-option__button-label--has-swatch)::after {
    border-radius: 0;
  }

  .product-details .variant-option__button-label__pill {
    border-radius: 0;
  }

  .product-details .variant-option__button-label:has(:checked):not(.variant-option__button-label--has-swatch) {
    border-color: var(--ccg-ink);
    background: var(--ccg-ink);
    color: var(--ccg-cream);
  }

  .product-details .variant-option__button-label:has(:checked):not(.variant-option__button-label--has-swatch)::before {
    border-color: var(--ccg-ink);
  }

  .product-details .variant-option__button-label:has(:checked):not(.variant-option__button-label--has-swatch) .variant-option__button-label__pill {
    background: var(--ccg-ink);
  }

  .product-details .variant-option__button-label__text {
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .product-details .variant-option--buttons {
      gap: 10px;
    }

    .product-details .variant-option__button-label:not(.variant-option__button-label--has-swatch) {
      min-width: 92px;
      min-height: 46px;
      padding: 0 18px;
      font-size: 17px;
      letter-spacing: 0.14em;
    }

    .product-details .variant-option--buttons legend,
    .product-details .variant-option--dropdowns > label,
    .product-details .variant-option[data-testid='variant-option-single'] {
      font-size: 16px;
      letter-spacing: 0.16em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_variant_picker",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.type"
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "dropdowns",
          "label": "t:options.dropdowns"
        },
        {
          "value": "buttons",
          "label": "t:options.buttons"
        }
      ],
      "default": "buttons"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:settings.swatches",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "option_label_text_color",
      "label": "t:settings.text_color",
      "alpha": true
    },
    {
      "type": "select",
      "id": "variant_style_class",
      "label": "t:settings.variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "info": "t:info.edit_variants_in_theme_settings"
    },
    {
      "type": "color",
      "id": "custom_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "select",
      "id": "selected_variant_style_class",
      "label": "t:settings.selected_variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.variant_style == 'buttons' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_variant_picker",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
