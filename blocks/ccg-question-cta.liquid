{% liquid
  assign product_resource = closest.product | default: product
  assign current_variant = product_resource.selected_or_first_available_variant
  assign low_stock_threshold = block.settings.low_stock_threshold | default: 5

  assign custom_product_tag_metafield = product_resource.metafields.custom.product_tag
  assign custom_product_tag_value = custom_product_tag_metafield.value
  assign custom_product_tag_text = ''

  if custom_product_tag_value != blank
    if custom_product_tag_metafield.type contains 'list.'
      assign custom_product_tag_text = custom_product_tag_value | join: ' · '
    else
      assign custom_product_tag_text = custom_product_tag_value | append: '' | strip
    endif
  endif

  assign has_custom_product_tag = false
  if custom_product_tag_text != blank
    assign has_custom_product_tag = true
  endif

  assign show_low_stock = false
  if has_custom_product_tag == false and current_variant.available
    if current_variant.inventory_management != blank and current_variant.inventory_policy != 'continue'
      if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= low_stock_threshold
        assign show_low_stock = true
      endif
    endif
  endif
%}

<div
  class="ccg-question-cta"
  style="
    --ccg-question-cta-ink: {{ block.settings.text_color }};
    --ccg-question-cta-tan: {{ block.settings.note_color }};
    --ccg-question-cta-border: {{ block.settings.border_color }};
    --ccg-question-cta-badge-bg: {{ block.settings.badge_background }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.button_label != blank -%}
    <a
      class="ccg-question-cta__button"
      href="{{ block.settings.button_link | default: '/pages/contact' }}"
    >
      {{ block.settings.button_label | escape }}
    </a>
  {%- endif -%}

  {%- if product_resource != blank -%}
    <ccg-product-badge
      class="ccg-question-cta__badge{% unless has_custom_product_tag or show_low_stock %} is-hidden{% endunless %}"
      data-has-custom-tag="{{ has_custom_product_tag }}"
      data-low-stock-threshold="{{ low_stock_threshold }}"
      data-low-stock-label="{{ block.settings.low_stock_label | escape }}"
      data-low-stock-message="{{ block.settings.low_stock_message | escape }}"
      data-show-exact-quantity="{{ block.settings.show_exact_quantity }}"
      aria-live="polite"
      {% unless has_custom_product_tag or show_low_stock %}hidden{% endunless %}
    >
      <span class="ccg-question-cta__badge-mark" aria-hidden="true"></span>

      <span class="ccg-question-cta__badge-copy">
        <strong class="ccg-question-cta__badge-label">
          {%- if has_custom_product_tag -%}
            {{ custom_product_tag_text | escape }}
          {%- elsif show_low_stock -%}
            {{ block.settings.low_stock_label | escape }}
          {%- endif -%}
        </strong>

        <span class="ccg-question-cta__badge-message">
          {%- if has_custom_product_tag -%}
            {{ block.settings.custom_tag_message | escape }}
          {%- elsif show_low_stock -%}
            {%- if block.settings.show_exact_quantity -%}
              Only {{ current_variant.inventory_quantity }} left ·
            {%- endif -%}
            {{ block.settings.low_stock_message | escape }}
          {%- endif -%}
        </span>
      </span>

      <script type="application/json" data-ccg-variant-inventory>
        [
          {%- for variant in product_resource.variants -%}
            {
              "id": {{ variant.id | json }},
              "available": {{ variant.available | json }},
              "quantity": {{ variant.inventory_quantity | default: 0 | json }},
              "tracked": {% if variant.inventory_management != blank %}true{% else %}false{% endif %},
              "continueSelling": {% if variant.inventory_policy == 'continue' %}true{% else %}false{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
    </ccg-product-badge>
  {%- endif -%}
</div>

{% stylesheet %}
  .ccg-question-cta {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    font-family: 'Barlow Condensed', sans-serif;
  }

  .ccg-question-cta__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border: 1px solid var(--ccg-question-cta-border);
    color: var(--ccg-question-cta-ink);
    background: transparent;
    font-weight: 400;
    line-height: 1.1;
    text-align: center;
    text-decoration: none;
    padding: 17px 0;
    font-size: 19px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .ccg-question-cta__button:hover,
  .ccg-question-cta__button:focus-visible {
    background: var(--ccg-question-cta-ink);
    border-color: var(--ccg-question-cta-ink);
    color: var(--ccg-cream);
  }

  .ccg-question-cta__badge {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    padding: 14px 18px;
    border: 1px solid color-mix(in srgb, var(--ccg-question-cta-tan) 28%, transparent);
    background: var(--ccg-question-cta-badge-bg);
    color: var(--ccg-question-cta-ink);
  }

  .ccg-question-cta__badge[hidden],
  .ccg-question-cta__badge.is-hidden {
    display: none;
  }

  .ccg-question-cta__badge-mark {
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    margin-top: 6px;
    border-radius: 50%;
    background: var(--ccg-question-cta-tan);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ccg-question-cta-tan) 12%, transparent);
  }

  .ccg-question-cta__badge-copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .ccg-question-cta__badge-label {
    color: var(--ccg-question-cta-tan);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ccg-question-cta__badge-message {
    color: var(--ccg-question-cta-ink);
    font-family: 'Karla', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.45;
    text-transform: none;
  }

  @media screen and (max-width: 749px) {
    .ccg-question-cta {
      gap: 14px;
    }

    .ccg-question-cta__button {
      min-height: 50px;
      padding-inline: 16px;
      font-size: 16px;
      letter-spacing: 0.14em;
    }

    .ccg-question-cta__badge {
      padding: 13px 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ccg-question-cta__button {
      transition: none;
    }
  }
{% endstylesheet %}

<script>
  if (!customElements.get('ccg-product-badge')) {
    customElements.define(
      'ccg-product-badge',
      class extends HTMLElement {
        connectedCallback() {
          const inventoryData = this.querySelector('[data-ccg-variant-inventory]');

          try {
            this.variants = JSON.parse(inventoryData?.textContent || '[]');
          } catch (error) {
            this.variants = [];
          }

          this.productScope = this.closest('product-information, .product-information, section');
          this.handleVariantEvent = this.handleVariantEvent.bind(this);
          this.handleProductChange = this.handleProductChange.bind(this);

          document.addEventListener('variant:update', this.handleVariantEvent);
          document.addEventListener('product:variant-change', this.handleVariantEvent);
          this.productScope?.addEventListener('change', this.handleProductChange);
        }

        disconnectedCallback() {
          document.removeEventListener('variant:update', this.handleVariantEvent);
          document.removeEventListener('product:variant-change', this.handleVariantEvent);
          this.productScope?.removeEventListener('change', this.handleProductChange);
        }

        handleVariantEvent(event) {
          const variantId =
            event.detail?.variant?.id ||
            event.detail?.resource?.id ||
            event.detail?.id;

          if (variantId) this.updateBadge(variantId);
        }

        handleProductChange() {
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              const selectedVariantInput = this.productScope?.querySelector(
                'form[action*="/cart/add"] input[name="id"]'
              );

              if (selectedVariantInput?.value) {
                this.updateBadge(selectedVariantInput.value);
              }
            });
          });
        }

        updateBadge(variantId) {
          /* A populated Custom Product Tag always takes priority over low stock. */
          if (this.dataset.hasCustomTag === 'true') return;

          const variant = this.variants.find((item) => String(item.id) === String(variantId));
          if (!variant) return;

          const threshold = Number(this.dataset.lowStockThreshold || 5);
          const isLowStock =
            variant.available &&
            variant.tracked &&
            !variant.continueSelling &&
            variant.quantity > 0 &&
            variant.quantity <= threshold;

          this.hidden = !isLowStock;
          this.classList.toggle('is-hidden', !isLowStock);

          if (!isLowStock) return;

          const showExactQuantity = this.dataset.showExactQuantity === 'true';
          const quantityText = showExactQuantity ? `Only ${variant.quantity} left · ` : '';

          this.querySelector('.ccg-question-cta__badge-label').textContent =
            this.dataset.lowStockLabel || 'Low stock';
          this.querySelector('.ccg-question-cta__badge-message').textContent =
            `${quantityText}${this.dataset.lowStockMessage || ''}`;
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "CCG Question CTA",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Ask Melissa A Question"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Product badge"
    },
    {
      "type": "paragraph",
      "content": "The Custom Product Tag metafield value is displayed as the badge. If that metafield is empty, low stock is shown only when tracked inventory is at or below the threshold."
    },
    {
      "type": "text",
      "id": "custom_tag_message",
      "label": "Custom Product Tag supporting message",
      "default": "Handmade in a limited run · Never mass-produced."
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low-stock threshold",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_exact_quantity",
      "label": "Show exact remaining quantity",
      "default": true
    },
    {
      "type": "text",
      "id": "low_stock_label",
      "label": "Low-stock label",
      "default": "Low stock"
    },
    {
      "type": "text",
      "id": "low_stock_message",
      "label": "Low-stock message",
      "default": "Handmade in a limited run."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Button text color",
      "default": "#211c17"
    },
    {
      "type": "color",
      "id": "note_color",
      "label": "Badge accent color",
      "default": "#8a5a32"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#8f877b"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#ede7dc"
    }
  ],
  "presets": [
    {
      "name": "CCG Question CTA",
      "category": "Product"
    }
  ]
}
{% endschema %}
