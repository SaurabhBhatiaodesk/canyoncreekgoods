{% liquid
  assign material = closest.product.metafields.custom.material.value
  assign lining = closest.product.metafields.custom.lining.value
  assign dimensions = closest.product.metafields.custom.dimensions.value
  assign care = closest.product.metafields.custom.care.value
  assign made = closest.product.metafields.custom.made.value
%}

{% if material != blank or lining != blank or dimensions != blank or care != blank or made != blank %}
  <div class="ccg-product-details" {{ block.shopify_attributes }}>
    {% if material != blank %}
      <div class="ccg-product-details__row">
        <div class="ccg-product-details__label">{{ block.settings.material_label | escape }}</div>
        <div class="ccg-product-details__value">{{ material | escape }}</div>
      </div>
    {% endif %}
    {% if lining != blank %}
      <div class="ccg-product-details__row">
        <div class="ccg-product-details__label">{{ block.settings.lining_label | escape }}</div>
        <div class="ccg-product-details__value">{{ lining | escape }}</div>
      </div>
    {% endif %}
    {% if dimensions != blank %}
      <div class="ccg-product-details__row">
        <div class="ccg-product-details__label">{{ block.settings.dimensions_label | escape }}</div>
        <div class="ccg-product-details__value">{{ dimensions | escape }}</div>
      </div>
    {% endif %}
    {% if care != blank %}
      <div class="ccg-product-details__row">
        <div class="ccg-product-details__label">{{ block.settings.care_label | escape }}</div>
        <div class="ccg-product-details__value">{{ care | escape }}</div>
      </div>
    {% endif %}
    {% if made != blank %}
      <div class="ccg-product-details__row">
        <div class="ccg-product-details__label">{{ block.settings.made_label | escape }}</div>
        <div class="ccg-product-details__value">{{ made | escape }}</div>
      </div>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .ccg-product-details {
    width: 100%;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
  }

  .ccg-product-details__row {
    display: grid;
    grid-template-columns: minmax(120px, 180px) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    padding: 20px 0;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
  }

  .ccg-product-details__label {
    color: rgb(var(--color-foreground-rgb) / 0.58);
    font-family: var(--font-body--family);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ccg-product-details__value {
    color: rgb(var(--color-foreground-rgb));
    font-size: var(--font-paragraph--size);
    line-height: 1.55;
  }

  @media screen and (max-width: 749px) {
    .ccg-product-details__row {
      grid-template-columns: 100px minmax(0, 1fr);
      gap: 16px;
      padding: 16px 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product details",
  "settings": [
    {
      "type": "text",
      "id": "material_label",
      "label": "Material label",
      "default": "Material"
    },
    {
      "type": "text",
      "id": "lining_label",
      "label": "Lining label",
      "default": "Lining"
    },
    {
      "type": "text",
      "id": "dimensions_label",
      "label": "Dimensions label",
      "default": "Dimensions"
    },
    {
      "type": "text",
      "id": "care_label",
      "label": "Care label",
      "default": "Care"
    },
    {
      "type": "text",
      "id": "made_label",
      "label": "Made label",
      "default": "Made"
    }
  ],
  "presets": [
    {
      "name": "Product details"
    }
  ]
}
{% endschema %}