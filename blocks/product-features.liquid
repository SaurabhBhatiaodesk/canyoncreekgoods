{% liquid
  assign product_resource = closest.product | default: product
  assign feature_entries = product_resource.metafields.custom.product_features.value
%}

{% if feature_entries != blank %}
  <div class="ccg-product-details" {{ block.shopify_attributes }}>
    {% for feature_entry in feature_entries %}
      {% assign packed_description = feature_entry.description.value | default: feature_entry.description %}
      {% liquid
        assign feature_keys = 'material,lining,dimensions,care,made' | split: ','
        assign has_structured_features = false
        for feature_key in feature_keys
          if feature_entry[feature_key].value != blank
            assign has_structured_features = true
            break
          endif
        endfor
      %}
      {% if has_structured_features %}
        {% for feature_key in feature_keys %}
          {% assign feature_value = feature_entry[feature_key].value | strip %}
          {% if feature_value != blank %}
            <div class="ccg-product-details__row">
              <span class="ccg-product-details__label">{{ feature_key | capitalize }}</span>
              <span class="ccg-product-details__value">{{ feature_value | escape | newline_to_br }}</span>
            </div>
          {% endif %}
        {% endfor %}
      {% elsif packed_description contains '||' %}
        {% assign feature_rows = packed_description | split: '||' %}
        {% for feature_row in feature_rows %}
          {% assign feature_parts = feature_row | split: '|' %}
          {% assign feature_label = feature_parts[0] | strip %}
          {% assign feature_value = feature_parts[1] | strip %}
          {% if feature_value != blank %}
            <div class="ccg-product-details__row">
              <span class="ccg-product-details__label">{{ feature_label }}</span>
              <span class="ccg-product-details__value">{{ feature_value }}</span>
            </div>
          {% endif %}
        {% endfor %}
      {% elsif feature_entry.label != blank and packed_description != blank %}
        <div class="ccg-product-details__row">
          <span class="ccg-product-details__label">{{ feature_entry.label.value | default: feature_entry.label }}</span>
          <span class="ccg-product-details__value">{{ packed_description }}</span>
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

{% stylesheet %}

.ccg-product-details {
  width: 100%;
  margin-top: 1.5rem;
  border-top: 1px solid rgba(var(--color-foreground), 0.16);
}

.ccg-product-details__row {
  display: grid;
  grid-template-columns: minmax(8rem, 0.36fr) minmax(0, 1fr);
  gap: 1.5rem;
  align-items: start;
  padding: 1.25rem 0;
  border-bottom:1px solid #ddd;
}

.ccg-product-details__label {
  color: rgba(var(--color-foreground), 0.62);
  font-size: 0.82rem;
  letter-spacing: 0.15em;
  line-height: 1.5;
  text-transform: uppercase;
}

.ccg-product-details__value {
  color: rgb(var(--color-foreground));
  line-height: 1.55;
}

@media screen and (max-width: 749px) {
  .ccg-product-details__row {
    grid-template-columns: minmax(6rem, 0.34fr) minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Product features",
  "tag": null,
  "settings": [],
  "presets": [{ "name": "Product features" }]
}
{% endschema %}