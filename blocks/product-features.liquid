{%- liquid
  assign product_resource = closest.product | default: product
  assign feature_entries = product_resource.metafields.custom.product_features.value
-%}

{%- if feature_entries != blank -%}
  <div class="product-features" {{ block.shopify_attributes }}>
    {%- for feature in feature_entries -%}
      {%- assign feature_label = feature.label.value | default: feature.label -%}
      {%- assign feature_description = feature.description.value | default: feature.description -%}

      {%- if feature_label != blank or feature_description != blank -%}
        <div class="product-features__row">
          <div class="product-features__label">
            {{ feature_label | escape }}
          </div>

          <div class="product-features__description">
            {{ feature_description | escape | newline_to_br }}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .product-features {
    width: 100%;
  }

    .product-features__row {
        display: grid;
        grid-template-columns: 28% 72%;
        padding: 18px 0;
        border-top: 1px solid rgba(33, 28, 23, 0.12);
    }
  .product-features__row:last-child {
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }
    .product-features__label {
        font-family: "Barlow Condensed", sans-serif;
        font-size: 16px;
        letter-spacing: 0.14em;
        color: rgb(122, 109, 93);
        text-transform: uppercase;
    }

    .product-features__description {
        font-size: 16px;
        line-height: 1.55;
        color: rgb(33, 28, 23);
    }

  .product-features__description p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .product-features__row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .product-features__label {
      font-size: 14px;
    }

    .product-features__description {
      font-size: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product features",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows product metafield custom.product_features. Add Product Features entries to the product to display this block."
    }
  ],
  "presets": [
    {
      "name": "Product features",
      "category": "Product"
    }
  ]
}
{% endschema %}
