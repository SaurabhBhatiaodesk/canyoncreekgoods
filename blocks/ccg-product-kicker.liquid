{%- liquid
  assign product_resource = closest.product
  assign kicker_text = ''

  if product_resource != blank
    for tag in product_resource.tags limit: 2
      assign clean_tag = tag | strip

      if clean_tag != blank
        if kicker_text != blank
          assign kicker_text = kicker_text | append: ' ' | append: block.settings.separator | append: ' '
        endif

        assign kicker_text = kicker_text | append: clean_tag
      endif
    endfor
  endif

  if kicker_text == blank
    assign kicker_text = block.settings.fallback_text
  endif
-%}

{%- if kicker_text != blank -%}
  <p
    class="ccg-product-kicker ccg-product-kicker--{{ block.settings.alignment }}"
    style="--ccg-product-kicker-color: {{ block.settings.text_color }};"
    {{ block.shopify_attributes }}
  >
    {{ kicker_text }}
  </p>
{%- endif -%}

{% stylesheet %}
  .ccg-product-kicker {
    width: 100%;
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 400;
    font-size: 15px;
    letter-spacing: 0.22em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--ccg-product-kicker-color);
  }

  .ccg-product-kicker--left {
    text-align: left;
  }

  .ccg-product-kicker--center {
    text-align: center;
  }

  .ccg-product-kicker--right {
    text-align: right;
  }

  @media screen and (max-width: 749px) {
    .ccg-product-kicker {
      font-size: 15px;
      letter-spacing: 0.15em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Product Kicker",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the first two tags from the current product. Fallback text appears only when the product has no tags."
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Tag separator",
      "default": "·"
    },
    {
      "type": "text",
      "id": "fallback_text",
      "label": "Fallback text",
      "default": "One of one · Never made again"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#8a5a32"
    }
  ],
  "presets": [
    {
      "name": "CCG Product Kicker",
      "category": "Product"
    }
  ]
}
{% endschema %}
