{% comment %}
  Canyon Creek Goods — Gift the Crew
  Shopify OS 2.0 section
  Save as: sections/ccg-gift-the-crew.liquid
{% endcomment %}

<section
  id="CCGGiftCrew-{{ section.id }}"
  class="ccg-gift-crew ccg-gift-crew--{{ section.settings.width_mode }}"
  style="
    --ccg-bg: {{ section.settings.background_color }};
    --ccg-ink: {{ section.settings.text_color }};
    --ccg-muted: {{ section.settings.muted_text_color }};
    --ccg-tan: {{ section.settings.accent_color }};
    --ccg-max-width: {{ section.settings.max_width }}px;
    --ccg-content-width: {{ section.settings.content_width }}px;
    --ccg-pad-top: {{ section.settings.padding_top }}px;
    --ccg-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ccg-text-align: {{ section.settings.text_alignment }};
  "
>
  <div class="ccg-gift-crew__inner">
    <header class="ccg-gift-crew__header">
      {% if section.settings.eyebrow != blank %}
        <p class="ccg-gift-crew__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="ccg-gift-crew__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.intro != blank %}
        <div class="ccg-gift-crew__intro rte">{{ section.settings.intro }}</div>
      {% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <div class="ccg-gift-crew__offers">
        {% for block in section.blocks %}
          <div class="ccg-gift-crew__offer" {{ block.shopify_attributes }}>
            <div class="ccg-gift-crew__offer-copy" aria-hidden="true">
              {% if block.settings.heading != blank %}
                <h3 class="ccg-gift-crew__offer-heading">{{ block.settings.heading | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <div class="ccg-gift-crew__offer-description rte">{{ block.settings.description }}</div>
              {% endif %}
            </div>

            {% if block.settings.bundle_id != blank %}
              <div class="ccg-gift-crew__widget">
                <mbc-bundles-widget data-bundle-id="{{ block.settings.bundle_id | escape }}"></mbc-bundles-widget>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <button type="button" class="ccg-gift-crew__cta">
        <span>Choose a product</span>
        <span class="ccg-gift-crew__cta-arrow" aria-hidden="true">→</span>
      </button>
    {% endif %}

    {% if section.settings.show_contact %}
      <div class="ccg-gift-crew__contact">
        {% if section.settings.contact_heading != blank %}
          <h3 class="ccg-gift-crew__contact-heading">{{ section.settings.contact_heading | escape }}</h3>
        {% endif %}
        {% if section.settings.contact_text != blank %}
          <div class="ccg-gift-crew__contact-text rte">{{ section.settings.contact_text }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<script type="application/json" id="CCGGiftCrewData-{{ section.id }}">
{
  "images": [
    {%- assign card_collection = section.settings.card_collection -%}
    {%- if card_collection != blank -%}
      {%- assign rendered_images = 0 -%}
      {%- for card_product in card_collection.products limit: 4 -%}
        {%- if card_product.featured_image != blank -%}
          {%- if rendered_images > 0 -%},{%- endif -%}
          {
            "src": {{ card_product.featured_image | image_url: width: 700 | json }},
            "alt": {{ card_product.featured_image.alt | default: card_product.title | json }}
          }
          {%- assign rendered_images = rendered_images | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  ],
  "tiers": [
    {%- for block in section.blocks -%}
      {%- unless forloop.first -%},{%- endunless -%}
      {
        "heading": {{ block.settings.heading | json }},
        "description": {{ block.settings.description | strip_html | strip | json }}
      }
    {%- endfor -%}
  ]
}
</script>

<script>
  (function () {
    var section = document.getElementById('CCGGiftCrew-{{ section.id }}');
    var dataEl = document.getElementById('CCGGiftCrewData-{{ section.id }}');
    if (!section || !dataEl) return;

    var data = { images: [], tiers: [] };
    try { data = JSON.parse(dataEl.textContent); } catch (e) {}

    function getTierInfo(card, index) {
      var raw = (card.innerText || card.textContent || '').replace(/\s+/g, ' ').trim();
      var qtyMatch = raw.match(/gift\s*(\d+)/i) || raw.match(/\b(10|20)\b/);
      var discountMatch = raw.match(/(\d+)\s*%\s*off/i);
      var tier = data.tiers[index] || {};

      var qty = qtyMatch ? qtyMatch[1] : (index === 1 ? '20' : '10');
      var discount = discountMatch ? discountMatch[1] : (qty === '20' ? '15' : '10');
      var description = tier.description || (qty === '20'
        ? 'Great for larger teams, events or special occasions.'
        : 'Perfect for small teams, offices or client gifts.');

      return {
        qty: qty,
        discount: discount,
        description: description
      };
    }

    function addMedia(card, index) {
      if (card.querySelector('.ccg-gift-tier__media')) return;
      if (!data.images || !data.images.length) return;

      var media = document.createElement('span');
      media.className = 'ccg-gift-tier__media';

      for (var i = 0; i < 2; i += 1) {
        var imageData = data.images[(index * 2 + i) % data.images.length];
        if (!imageData) continue;

        var img = document.createElement('img');
        img.className = 'ccg-gift-tier__image';
        img.src = imageData.src;
        img.alt = imageData.alt || '';
        img.loading = 'lazy';
        media.appendChild(img);
      }

      card.prepend(media);
    }

    function addDesignedCopy(card, index) {
      if (card.querySelector('.ccg-gift-tier__copy')) return;

      var info = getTierInfo(card, index);
      var original = document.createElement('span');
      original.className = 'ccg-gift-tier__original';

      Array.prototype.slice.call(card.childNodes).forEach(function (node) {
        if (node.nodeType === 1 && node.classList && node.classList.contains('ccg-gift-tier__media')) return;
        if (node.nodeType === 1 && node.matches && node.matches('input, button, label, select, a')) return;
        original.appendChild(node.cloneNode(true));
      });
      card.appendChild(original);

      var copy = document.createElement('span');
      copy.className = 'ccg-gift-tier__copy';
      copy.innerHTML =
        '<span class="ccg-gift-tier__eyebrow">GIFT ' + info.qty + '</span>' +
        '<span class="ccg-gift-tier__discount">' + info.discount + '% off</span>' +
        '<span class="ccg-gift-tier__rule"></span>' +
        '<span class="ccg-gift-tier__description"></span>';

      copy.querySelector('.ccg-gift-tier__description').textContent = info.description;
      card.appendChild(copy);
    }

    function enhanceCards() {
      var cards = section.querySelectorAll('.mbc-bundles-quantity-breaks__item');
      if (!cards.length) return;

      cards.forEach(function (card, index) {
        card.classList.add('ccg-gift-tier');
        addMedia(card, index);
        addDesignedCopy(card, index);
      });

      section.classList.add('ccg-gift-crew--ready');
    }

    function clickNativeChooseButton() {
      var candidates = section.querySelectorAll('button, [role="button"], a');
      for (var i = 0; i < candidates.length; i += 1) {
        var el = candidates[i];
        if (el.classList && el.classList.contains('ccg-gift-crew__cta')) continue;
        var text = (el.innerText || el.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase();
        if (text.indexOf('choose a product') !== -1 || text.indexOf('add product') !== -1 || text === 'choose product') {
          el.click();
          return;
        }
      }

      var firstCard = section.querySelector('.mbc-bundles-quantity-breaks__item');
      if (firstCard) firstCard.click();
    }

    var cta = section.querySelector('.ccg-gift-crew__cta');
    if (cta) cta.addEventListener('click', clickNativeChooseButton);

    enhanceCards();
    new MutationObserver(function () {
      window.requestAnimationFrame(enhanceCards);
    }).observe(section, { childList: true, subtree: true });
  })();
</script>

{% style %}
  #CCGGiftCrew-{{ section.id }} {
    width: 100%;
    background: var(--ccg-bg);
    font-family: 'Karla', system-ui, sans-serif;
    padding: var(--ccg-pad-top) 18px var(--ccg-pad-bottom);
    box-sizing: border-box;
  }

  #CCGGiftCrew-{{ section.id }},
  #CCGGiftCrew-{{ section.id }} * { box-sizing: border-box; }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__inner {
    width: 100%;
    max-width: var(--ccg-max-width);
    margin: 0 auto;
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__header {
    width: 100%;
    max-width: var(--ccg-content-width);
    margin: 0 auto 44px;
    text-align: var(--ccg-text-align);
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__eyebrow {
    margin: 0 0 12px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--ccg-tan);
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 400;
    line-height: 1.15;
    color: var(--ccg-ink);
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__intro {
    max-width: 820px;
    margin: 22px auto 0;
    color: var(--ccg-muted);
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__intro p {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__intro p + p { margin-top: 14px; }

  /* The app remains the source of truth. We only restyle its generated bundle cards. */
  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__offers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    width: 100%;
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__offer { min-width: 0; }
  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__offer-copy { display: none !important; }
  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__widget,
  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__widget mbc-bundles-widget {
    display: block;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  #CCGGiftCrew-{{ section.id }} .mbc-bundles-quantity-breaks {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px !important;
    width: 100% !important;
  }

  /* If each block/widget contains only one tier, keep that one tier full width in its half. */
  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__offer .mbc-bundles-quantity-breaks:has(.mbc-bundles-quantity-breaks__item:only-child) {
    grid-template-columns: 1fr;
  }

  #CCGGiftCrew-{{ section.id }} .mbc-bundles-quantity-breaks__item.ccg-gift-tier {
    position: relative;
    display: grid !important;
    grid-template-columns: minmax(250px, 1.35fr) minmax(210px, .95fr);
    align-items: stretch !important;
    gap: 0 !important;
    min-height: 238px;
    margin: 0 !important;
    padding: 16px !important;
    overflow: hidden;
    border: 0 !important;
    border-radius: 10px !important;
    background: rgba(255,255,255,.56) !important;
    box-shadow: 0 2px 16px rgba(51, 39, 29, .07) !important;
    color: var(--ccg-ink) !important;
    cursor: pointer;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  #CCGGiftCrew-{{ section.id }} .mbc-bundles-quantity-breaks__item.ccg-gift-tier:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(51, 39, 29, .10) !important;
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__media {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    min-width: 0;
    height: 100%;
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 206px;
    object-fit: cover;
    border-radius: 6px;
    background: #eee6da;
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    min-width: 0;
    padding: 18px 24px 18px 30px;
    text-align: left;
    pointer-events: none;
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__eyebrow {
    display: block;
    margin-bottom: 8px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: .25em;
    text-transform: uppercase;
    color: #5f3f2c;
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__discount {
    display: block;
    font-family: 'Rye', Georgia, serif;
    font-size: clamp(34px, 3vw, 45px);
    font-weight: 400;
    line-height: 1.05;
    color: #2f211c;
    white-space: nowrap;
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__rule {
    display: block;
    width: 30px;
    height: 1px;
    margin: 20px 0 17px;
    background: #8f6349;
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__description {
    display: block;
    max-width: 220px;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: .01em;
    color: #756b63;
  }

  /* Keep all app inputs/selection behavior alive, but hide its old visual copy. */
  #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__original {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0,0,0,0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  /* Hide the app's duplicate CTA; our button below triggers the original action. */
  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__widget button:not(.mbc-bundles-quantity-breaks__item),
  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__widget a[class*="button"] {
    margin-top: 0;
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 51px;
    margin: 18px 0 0;
    padding: 14px 22px;
    border: 0;
    border-radius: 7px;
    background: var(--ccg-tan);
    box-shadow: 0 3px 10px rgba(61, 39, 22, .14);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: .21em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
    transition: filter .2s ease, transform .2s ease;
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__cta:hover {
    filter: brightness(.96);
    transform: translateY(-1px);
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__cta-arrow {
    font-size: 20px;
    line-height: 1;
    letter-spacing: 0;
    transform: translateY(-1px);
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__contact {
    width: 100%;
    max-width: var(--ccg-content-width);
    margin: 58px auto 0;
    text-align: var(--ccg-text-align);
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__contact-heading {
    margin: 0 0 10px;
    font-family: 'Rye', serif;
    font-size: 28px;
    font-weight: 400;
    color: var(--ccg-ink);
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__contact-text,
  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__contact-text p {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ccg-muted);
  }

  #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__contact a {
    color: var(--ccg-ink);
    text-underline-offset: 3px;
  }

  @media screen and (min-width: 990px) {
    /* Common MBC case: one widget creates both Gift 10 and Gift 20 cards. */
    #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__offer:only-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 1199px) {
    #CCGGiftCrew-{{ section.id }} .mbc-bundles-quantity-breaks__item.ccg-gift-tier {
      grid-template-columns: minmax(210px, 1.15fr) minmax(190px, .85fr);
    }
    #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__copy { padding: 16px 18px 16px 22px; }
    #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__description { font-size: 15px; }
  }

  @media screen and (max-width: 989px) {
    #CCGGiftCrew-{{ section.id }} { padding-left: 16px; padding-right: 16px; }
    #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__offers,
    #CCGGiftCrew-{{ section.id }} .mbc-bundles-quantity-breaks {
      grid-template-columns: 1fr !important;
    }
  }

  @media screen and (max-width: 749px) {
    #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__header { margin-bottom: 32px; }
    #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__heading { font-size: 32px; }
    #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__intro p { font-size: 16px; }

    #CCGGiftCrew-{{ section.id }} .mbc-bundles-quantity-breaks__item.ccg-gift-tier {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 12px !important;
    }

    #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__media { min-height: 0; }
    #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__image {
      min-height: 0;
      aspect-ratio: 1 / 1.12;
    }
    #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__copy { padding: 22px 8px 14px; }
    #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__discount { font-size: 36px; }
    #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__rule { margin: 16px 0 14px; }
    #CCGGiftCrew-{{ section.id }} .ccg-gift-tier__description { max-width: none; font-size: 15px; }
    #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__cta { min-height: 48px; font-size: 13px; }
    #CCGGiftCrew-{{ section.id }} .ccg-gift-crew__contact { margin-top: 44px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Gift the Crew",
  "tag": "section",
  "class": "section-ccg-gift-crew",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Handmade. Western. Ready to gift."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gift the Crew"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Our wool cowls make an easy and genuinely useful gift this winter. No sizing, no guessing, just premium cozy wool.</p><p>Each cowl comes individually packaged and gift-ready with wool care instructions and a QR code linking to our cowl-wearing tutorial video. All you have to do is hand them out!</p>"
    },
    {
      "type": "collection",
      "id": "card_collection",
      "label": "Bundle card image collection",
      "info": "The first four product images are used dynamically in the Gift 10 and Gift 20 cards."
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show contact section",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Got a big crew?"
    },
    {
      "type": "richtext",
      "id": "contact_text",
      "label": "Contact text",
      "default": "<p>No worries, <a href=\"mailto:canyoncreekgoods@gmail.com\">send me an email</a> and I'll sort out the rest.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F8F5EE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#2F2923"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Body text color",
      "default": "#5C5145"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / button color",
      "default": "#B98A52"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "width_mode",
      "label": "Section width",
      "options": [
        { "value": "contained", "label": "Contained" },
        { "value": "full", "label": "Full page width" }
      ],
      "default": "contained"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Section content width",
      "default": 1440
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Text content width",
      "default": 900
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
