                        {%- assign card_collection = section.settings.card_collection -%}

                        {%- if card_collection != blank -%}

                          \<script type="application/json" id="CCGGiftCrewImages-{{ section.id }}">

                            [

                              {%- assign rendered_images = 0 -%}

                              {%- for card_product in card_collection.products limit: 4 -%}

                                {%- if card_product.featured_image != blank -%}

                                  {%- if rendered_images > 0 -%},{%- endif -%}

                                  {

                                    "src": {{ card_product.featured_image | image_url: width: 500 | json }},

                                    "alt": {{ card_product.featured_image.alt | default: card_product.title | json }}

                                  }

                                  {%- assign rendered_images = rendered_images | plus: 1 -%}

                                {%- endif -%}

                              {%- endfor -%}

                            ]

                          \</script>



                          \<script>

                            (function () {

                              var section = document.getElementById('CCGGiftCrew-{{ section.id }}');

                              var data = document.getElementById('CCGGiftCrewImages-{{ section.id }}');

                              if (!section || !data) return;



                              var images;

                              try { images = JSON.parse(data.textContent); } catch (error) { return; }

                              if (!images.length) return;



                              function enhanceTierCards() {

                                var cards = section.querySelectorAll('.mbc-bundles-quantity-breaks__item');

                                cards.forEach(function (card, cardIndex) {

                                  if (card.querySelector('.ccg-gift-tier__media')) return;



                                  var media = document.createElement('span');

                                  media.className = 'ccg-gift-tier__media';



                                  for (var imageIndex = 0; imageIndex < 2; imageIndex += 1) {

                                    var imageData = images[(cardIndex \* 2 + imageIndex) % images.length];

                                    var image = document.createElement('img');

                                    image.className = 'ccg-gift-tier__image';

                                    image.src = imageData.src;

                                    image.alt = imageData.alt || '';

                                    image.loading = 'lazy';

                                    media.appendChild(image);

                                  }



                                  card.classList.add('ccg-gift-tier');

                                  card.prepend(media);

                                });

                              }



                              enhanceTierCards();

                              new MutationObserver(enhanceTierCards).observe(section, { childList: true, subtree: true });

                            })();

                          \</script>

                        {%- endif -%}



                        {% style %}
  #CCGGiftCrew-{{ section.id }} {
