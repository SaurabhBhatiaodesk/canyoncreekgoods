{% render 'ccg-section-spacing' %}

<div class="ccg-bundles section">
  <div class="ccg-bundles__inner">
  <div class="ccg-bundles__head">
    <div class="ccg-bundles__head-text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ccg-bundles__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ccg-bundles__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.quote != blank -%}
      <p class="ccg-bundles__quote">{{ section.settings.quote }}</p>
    {%- endif -%}
  </div>

  {%- liquid
    assign filter_ids = ''
    for block in section.blocks
      if block.settings.bundle_id != blank
        assign filter_ids = filter_ids | append: block.settings.bundle_id | append: '|||'
      endif
    endfor
  -%}
  <div
    class="ccg-bundles__grid"
    data-bundler-grid="{{ section.id }}"
    data-bundler-filter="{{ filter_ids | escape }}"
  ></div>
  </div>
</div>

<script>
  (function () {
    var grid = document.querySelector('[data-bundler-grid="{{ section.id }}"]');
    if (!grid) return;

    var filterIds = (grid.getAttribute('data-bundler-filter') || '')
      .split('|||')
      .map(function (s) { return s.trim(); })
      .filter(Boolean);

    var money = function (cents) {
      return '$' + (cents / 100).toFixed(2);
    };

    function fetchProduct(handle) {
      return fetch('/products/' + handle + '.js', { credentials: 'same-origin' }).then(function (r) {
        if (!r.ok) throw new Error('Failed to fetch product: ' + handle);
        return r.json();
      });
    }

    function buildCard(bundle, products) {
      var regularCents = 0;
      products.forEach(function (p) { regularCents += p.price; });

      var discountPercent = parseFloat(bundle.percentage_value) || 0;
      var fixedAmount = parseFloat(bundle.fixed_amount_value) || 0;
      var priceCents = regularCents;
      if (bundle.discount_type === 'percentage' && discountPercent > 0) {
        priceCents = Math.round(regularCents * (100 - discountPercent) / 100);
      } else if (bundle.discount_type === 'fixed_amount' && fixedAmount > 0) {
        priceCents = Math.max(regularCents - Math.round(fixedAmount * 100), 0);
      }
      var saveCents = regularCents - priceCents;

      var title = bundle.name || products.map(function (p) { return p.title; }).join(' + ');

      var card = document.createElement('div');
      card.className = 'ccg-bundle-card';

      var media = document.createElement('div');
      media.className = 'ccg-bundle-card__media';

      products.forEach(function (p) {
        var hasAlt = !!(p.images && p.images[1]);
        var slot = document.createElement('span');
        slot.className = 'ccg-bundle-card__img' + (hasAlt ? ' ccg-bundle-card__img--has-alt' : '');

        var primary = document.createElement('img');
        primary.className = 'ccg-bundle-card__photo ccg-bundle-card__photo--primary';
        primary.src = p.featured_image || (p.images && p.images[0]) || '';
        primary.alt = p.title || title;
        primary.loading = 'lazy';
        slot.appendChild(primary);

        if (hasAlt) {
          var secondary = document.createElement('img');
          secondary.className = 'ccg-bundle-card__photo ccg-bundle-card__photo--secondary';
          secondary.src = p.images[1];
          secondary.alt = p.title || title;
          secondary.loading = 'lazy';
          slot.appendChild(secondary);
        }

        media.appendChild(slot);
      });

      var body = document.createElement('div');
      body.className = 'ccg-bundle-card__body';

      var titleEl = document.createElement('h3');
      titleEl.className = 'ccg-bundle-card__title';
      titleEl.textContent = title;
      body.appendChild(titleEl);

      var priceWrap = document.createElement('div');
      priceWrap.className = 'ccg-bundle-card__price';

      var priceNow = document.createElement('span');
      priceNow.className = 'ccg-bundle-card__price-now';
      priceNow.textContent = money(priceCents);
      priceWrap.appendChild(priceNow);

      if (saveCents > 0) {
        var priceWas = document.createElement('span');
        priceWas.className = 'ccg-bundle-card__price-was';
        priceWas.textContent = money(regularCents);
        priceWrap.appendChild(priceWas);
      }
      body.appendChild(priceWrap);

      if (saveCents > 0) {
        var saveEl = document.createElement('span');
        saveEl.className = 'ccg-bundle-card__save';
        saveEl.textContent = 'Save ' + money(saveCents);
        body.appendChild(saveEl);
      }

      card.appendChild(media);
      card.appendChild(body);
      return card;
    }

    function renderBundles(bundles) {
      if (!Array.isArray(bundles) || !bundles.length) return;

      var enabled = bundles.filter(function (b) {
        return !b.status || b.status === 'enabled' || b.status === 'active';
      });

      if (!filterIds.length) return;

      var active = filterIds
        .map(function (id) {
          return enabled.find(function (b) { return String(b.id) === id; });
        })
        .filter(Boolean);
      if (!active.length) return;

      Promise.all(
        active.map(function (bundle) {
          var handles = Object.values(bundle.products || {})
            .map(function (p) { return p.handle; })
            .filter(Boolean);
          if (!handles.length) return null;
          return Promise.all(handles.map(fetchProduct)).then(function (products) {
            return buildCard(bundle, products);
          });
        })
      )
        .then(function (cards) {
          grid.innerHTML = '';
          cards.forEach(function (card) {
            if (card) grid.appendChild(card);
          });
        })
        .catch(function (e) {
          console.warn('[ccg-bundles] Failed to render bundles:', e);
        });
    }

    function showDesignModeHelper(bundles) {
      if (!window.Shopify || !window.Shopify.designMode) return;
      if (!Array.isArray(bundles)) return;
      var old = document.querySelector('[data-bundler-helper="' + grid.getAttribute('data-bundler-grid') + '"]');
      if (old) old.remove();

      var helper = document.createElement('div');
      helper.setAttribute('data-bundler-helper', grid.getAttribute('data-bundler-grid'));
      helper.style.cssText = 'margin-bottom:16px;padding:12px 16px;background:#fff8e6;border:1px dashed #c4a177;font-family:monospace;font-size:13px;line-height:1.7;color:#4a3d31;';

      var title = document.createElement('div');
      title.style.cssText = 'font-weight:700;margin-bottom:6px;';
      title.textContent = 'Bundle IDs (live from Bundler — only visible while editing):';
      helper.appendChild(title);

      bundles.forEach(function (b) {
        var row = document.createElement('div');
        row.textContent = (b.name || 'Untitled') + '  =  ' + b.id + '  (' + (b.status || 'unknown') + ')';
        helper.appendChild(row);
      });

      grid.parentElement.insertBefore(helper, grid);
    }

    var attempts = 0;
    var maxAttempts = 100;
    var rendered = false;

    (function waitForBundler() {
      attempts++;
      if (window.bndlr && typeof window.bndlr.getBundles === 'function') {
        try {
          var result = window.bndlr.getBundles();
          if (result && typeof result.then === 'function') {
            result.then(function (bundles) {
              if (Array.isArray(bundles) && bundles.length) {
                rendered = true;
                showDesignModeHelper(bundles);
                renderBundles(bundles);
              }
            }).catch(function () {});
          } else if (Array.isArray(result) && result.length) {
            rendered = true;
            showDesignModeHelper(result);
            renderBundles(result);
          }
        } catch (e) {
          console.warn('[ccg-bundles] Bundler getBundles() failed:', e);
        }
      }
      if (!rendered && attempts < maxAttempts) {
        setTimeout(waitForBundler, 300);
      }
    })();
  })();
</script>

{% stylesheet %}
  .ccg-bundles {
    font-family: 'Karla', system-ui, sans-serif;
    background: var(--ccg-cream);
  }

  .ccg-bundles__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .ccg-bundles__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .ccg-bundles__head-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ccg-bundles__eyebrow {
    margin: 0;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ccg-tan);
  }

  .ccg-bundles__heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 33px;
    color: var(--ccg-ink);
  }

  .ccg-bundles__quote {
    margin: 0;
    font-size: 16px;
    font-style: normal;
    color: var(--ccg-stone);
    max-width: 300px;
    text-align: right;
    line-height: 1.55;
  }

  .ccg-bundles__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .ccg-bundle-card {
    display: flex;
    gap: 24px;
    align-items: center;
    border: 1px solid var(--ccg-hairline);
    padding: 24px;
    background: var(--ccg-cream-soft);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ccg-bundle-card:hover {
    border-color: var(--ccg-tan);
    box-shadow: 0 4px 16px rgba(33, 28, 23, 0.08);
  }

  .ccg-bundle-card:hover .ccg-bundle-card__img img {
    transform: scale(1.03);
  }

  .ccg-bundle-card__media {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .ccg-bundle-card__img {
    position: relative;
    width: 124px;
    height: 158px;
    overflow: hidden;
    background: var(--ccg-sand);
  }

  .ccg-bundle-card__img img,
  .ccg-bundle-card__img svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .ccg-bundle-card__img--has-alt .ccg-bundle-card__photo {
    position: absolute;
    inset: 0;
    transition: transform 0.5s ease, opacity 0.4s ease;
  }

  .ccg-bundle-card__img--has-alt .ccg-bundle-card__photo--secondary {
    opacity: 0;
  }

  .ccg-bundle-card:hover .ccg-bundle-card__img--has-alt .ccg-bundle-card__photo--primary {
    opacity: 0;
  }

  .ccg-bundle-card:hover .ccg-bundle-card__img--has-alt .ccg-bundle-card__photo--secondary {
    opacity: 1;
  }

  .ccg-bundle-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .ccg-bundle-card__title {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.38;
    color: var(--ccg-ink);
  }

  .ccg-bundle-card__description {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ccg-stone);
  }

  .ccg-bundle-card__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 2px;
  }

  .ccg-bundle-card__price-now {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 22px;
    letter-spacing: 0.04em;
    color: var(--ccg-ink);
  }

  .ccg-bundle-card__price-was {
    font-size: 15px;
    color: #a2957f;
    text-decoration: line-through;
  }

  .ccg-bundle-card__save {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    letter-spacing: 0.16em;
    color: var(--ccg-tan);
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .ccg-bundles__grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .ccg-bundles__inner {
      gap: 28px;
    }

    .ccg-bundles__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .ccg-bundles__quote {
      text-align: left;
      max-width: none;
    }

    .ccg-bundles__heading {
      font-size: 26px;
    }

    .ccg-bundle-card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Bundle Cards",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "paragraph",
      "content": "Cards (products, images, price, discount) always come live from the Bundler app — nothing below sets a product, image or price. Nothing shows on the storefront until you add at least one \"Bundle\" block below with its Bundle ID."
    },
    {
      "type": "paragraph",
      "content": "To find a Bundle ID: scroll down on this section's live preview on the right while you're in this editor — a yellow box lists every current Bundler bundle's name, ID and status, pulled live so it's always up to date (that box is only visible here, never on the live site)."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "COMPLETE THE LOOK"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Matched sets, save 10%"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote line",
      "default": "I pair these myself, from the same blanket run. — Melissa"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f5ee"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "text",
          "id": "bundle_id",
          "label": "Bundle ID",
          "info": "Required — the bundle's numeric ID from the Bundler app (find it in the yellow live-preview box on the right). Add one block per bundle you want to feature, in the order you want them shown. No blocks = section shows nothing."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CCG Bundle Cards"
    }
  ]
}
{% endschema %}
