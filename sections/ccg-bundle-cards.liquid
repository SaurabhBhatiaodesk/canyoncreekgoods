{% if section.settings.bundle_layout == 'custom' %}
{% render 'ccg-section-spacing' %}
{%- assign bundle_groups = 'dusters,jackets,slings,cowls' | split: ',' -%}
<ccg-mix-match
  class="ccg-mix section"
  id="ccg-bundles"
  data-current-product="{{ product.id }}"
  data-current-variant="{{ product.selected_or_first_available_variant.id }}"
  data-add-url="{{ routes.cart_add_url }}.js"
  data-cart-url="{{ routes.cart_url }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-discount-dusters="{{ section.settings.custom_discount_dusters }}"
  data-discount-jackets="{{ section.settings.custom_discount_jackets }}"
  data-discount-slings="{{ section.settings.custom_discount_slings }}"
  data-discount-cowls="{{ section.settings.custom_discount_cowls }}"
>
  <div class="ccg-mix__inner">
    <p class="ccg-mix__eyebrow">COMPLETE THE LOOK</p>
    <h2>{{ section.settings.custom_heading | escape }}</h2>
    <p>{{ section.settings.custom_description | escape }}</p>
    <form>
      <label for="BundleType-{{ section.id }}">Choose your pairing</label>
      <select id="BundleType-{{ section.id }}" data-pair-type>
        <option value="dusters">The Canyon Creek Layering Set — Duster + Cowl</option>
        <option value="jackets">The Western Winter Set — Denim Jacket + Cowl</option>
        <option value="slings">Sling Bag + Cowl</option>
        <option value="cowls">Pick any two cowls</option>
      </select>
      <div class="ccg-mix__choices">
        {% for slot in (1..2) %}
          <fieldset data-slot="{{ slot }}">
            <legend>Choose item {{ slot }}</legend>
            <img data-photo hidden width="480" height="480" alt="" loading="lazy">
            <label for="BundleProduct-{{ section.id }}-{{ slot }}">Product</label>
            <select id="BundleProduct-{{ section.id }}-{{ slot }}" data-product required></select>
            <label for="BundleVariant-{{ section.id }}-{{ slot }}">Size / lining / option</label>
            <select id="BundleVariant-{{ section.id }}-{{ slot }}" data-variant required></select>
            <a data-product-link hidden>View product details</a>
          </fieldset>
        {% endfor %}
      </div>
      <div class="ccg-mix__summary">
        <p>Pair subtotal: <strong data-subtotal>Choose two items</strong></p>
        <p data-savings-row hidden>Bundle savings (<span data-discount-percent>0</span>%): <strong data-savings></strong></p>
        <p data-total-row hidden>Bundle total: <strong data-total></strong></p>
        <p class="ccg-mix__small">The selected bundle and savings are attached to both cart items when added.</p>
        <button type="submit" disabled>Add pair to cart</button>
        <p data-status role="status" aria-live="polite"></p>
      </div>
    </form>
    <noscript>Please enable JavaScript to choose a pair. You can also add items individually from their product pages.</noscript>
    {% for group in bundle_groups %}
      {%- assign setting_id = 'custom_' | append: group -%}
      {%- assign source_collection = section.settings[setting_id] -%}
      <template data-group="{{ group }}">
        {% for item in source_collection.products limit: 50 %}
          {% unless item.gift_card or item.requires_selling_plan %}
            <div data-product-data data-id="{{ item.id }}" data-title="{{ item.title | escape }}" data-url="{{ item.url }}" data-alt="{{ item.featured_image.alt | default: item.title | escape }}"{% if item.featured_image %} data-image="{{ item.featured_image | image_url: width: 600 }}"{% endif %}>
              {% for variant in item.variants %}
                <span data-variant-data data-id="{{ variant.id }}" data-title="{{ variant.title | escape }}" data-price="{{ variant.price }}" data-available="{{ variant.available }}" data-min="{{ variant.quantity_rule.min }}" data-increment="{{ variant.quantity_rule.increment }}" data-max="{{ variant.quantity_rule.max }}"{% if variant.inventory_management != blank and variant.inventory_policy == 'deny' %} data-stock="{{ variant.inventory_quantity | at_least: 0 }}"{% endif %}{% if variant.featured_image %} data-image="{{ variant.featured_image | image_url: width: 600 }}" data-alt="{{ variant.featured_image.alt | default: item.title | escape }}"{% endif %}></span>
              {% endfor %}
            </div>
          {% endunless %}
        {% endfor %}
      </template>
      {% if request.design_mode and source_collection.products_count > 50 %}
        <p class="ccg-mix__notice">{{ source_collection.title | escape }} has more than 50 products. This selector currently includes the first 50; extend pagination before launch.</p>
      {% endif %}
    {% endfor %}
  </div>
</ccg-mix-match>
<style>
  .ccg-mix { display:block; background:var(--ccg-cream,#ede7dc); color:var(--ccg-ink,#211c17); font-family:Karla,system-ui,sans-serif; scroll-margin-top:6rem; }
  .ccg-mix__inner { max-width:1200px; margin:auto; }
  .ccg-mix h2 { font:400 clamp(25px,3vw,36px)/1.25 Rye,serif; margin:0 0 16px; }
  .ccg-mix p { line-height:1.6; }
  .ccg-mix__eyebrow { font:400 15px/1.5 'Barlow Condensed',sans-serif; letter-spacing:.18em; color:var(--ccg-tan,#9a623e); }
  .ccg-mix label { display:block; margin:18px 0 8px; }
  .ccg-mix select { width:100%; min-height:48px; padding:10px 36px 10px 12px; border:1px solid var(--ccg-hairline,#b6ac9d); background:#f8f5ee; color:#211c17; font:inherit; border-radius:0; }
  .ccg-mix__choices { display:grid; grid-template-columns:1fr 1fr; gap:28px; margin-top:28px; }
  .ccg-mix fieldset { margin:0; padding:20px; min-width:0; border:1px solid var(--ccg-hairline,#b6ac9d); }
  .ccg-mix legend { padding:0 8px; font:400 21px/1.4 'Barlow Condensed',sans-serif; }
  .ccg-mix img { display:block; width:100%; height:auto; max-height:380px; object-fit:contain; aspect-ratio:1; }
  .ccg-mix [hidden] { display:none; }
  .ccg-mix a { display:inline-block; color:inherit; margin-top:16px; text-underline-offset:4px; }
  .ccg-mix button { padding:16px 28px; min-height:52px; border:1px solid #211c17; background:#211c17; color:#f8f5ee; font:400 18px/1.3 'Barlow Condensed',sans-serif; letter-spacing:.12em; text-transform:uppercase; cursor:pointer; }
  .ccg-mix button:disabled { opacity:.5; cursor:not-allowed; }
  .ccg-mix :focus-visible { outline:2px solid #9a623e; outline-offset:4px; }
  .ccg-mix__notice { padding:12px 16px; border-left:3px solid #9a623e; background:#f8f5ee; }
  .ccg-mix__summary { margin-top:26px; border-top:1px solid var(--ccg-hairline,#b6ac9d); padding-top:12px; }
  .ccg-mix__small { font-size:14px; color:var(--ccg-stone,#645b50); }
  @media(max-width:749px) { .ccg-mix__choices { grid-template-columns:1fr; gap:20px; } .ccg-mix fieldset { padding:16px; } .ccg-mix button { width:100%; } }
</style>
<script>
if (!customElements.get('ccg-mix-match')) {
  customElements.define('ccg-mix-match', class extends HTMLElement {
    connectedCallback() {
      if (this.initialized) return;
      this.initialized = true;
      this.groups = new Map();
      this.querySelectorAll('template[data-group]').forEach(template => {
        this.groups.set(template.dataset.group, Array.from(template.content.querySelectorAll('[data-product-data]')).map(node => ({
          ...node.dataset,
          variants: Array.from(node.querySelectorAll('[data-variant-data]')).map(variant => ({ ...variant.dataset }))
        })));
      });
      this.slots = Array.from(this.querySelectorAll('[data-slot]'));
      this.form = this.querySelector('form');
      this.button = this.querySelector('button[type="submit"]');
      this.status = this.querySelector('[data-status]');
      this.type = this.querySelector('[data-pair-type]');
      this.money = new Intl.NumberFormat(document.documentElement.lang || 'en', {style:'currency', currency:this.dataset.currency});
      this.discounts = {
        dusters: Number(this.dataset.discountDusters || 0),
        jackets: Number(this.dataset.discountJackets || 0),
        slings: Number(this.dataset.discountSlings || 0),
        cowls: Number(this.dataset.discountCowls || 0)
      };
      this.bundleNames = {
        dusters: 'The Canyon Creek Layering Set — Duster + Cowl',
        jackets: 'The Western Winter Set — Denim Jacket + Cowl',
        slings: 'Sling Bag + Cowl',
        cowls: 'Pick any two cowls'
      };
      this.type.addEventListener('change', () => this.populate());
      this.slots.forEach(slot => {
        slot.querySelector('[data-product]').addEventListener('change', () => this.populateVariants(slot));
        slot.querySelector('[data-variant]').addEventListener('change', () => this.update());
      });
      this.form.addEventListener('submit', event => { event.preventDefault(); this.addPair(); });
      const currentGroup = Array.from(this.groups).find(([,products]) => products.some(item => item.id === this.dataset.currentProduct));
      if (currentGroup) this.type.value = currentGroup[0];
      this.populate();
      if (currentGroup) {
        const slot = this.slots[0];
        slot.querySelector('[data-product]').value = this.dataset.currentProduct;
        this.populateVariants(slot);
        const option = Array.from(slot.querySelector('[data-variant]').options).find(item => item.value === this.dataset.currentVariant && !item.disabled);
        if (option) slot.querySelector('[data-variant]').value = option.value;
        this.update();
      }
    }
    purchasable(variant) {
      return variant.available === 'true' && Number(variant.min || 1) <= 1 && Number(variant.increment || 1) === 1;
    }
    populate() {
      this.slots.forEach((slot, index) => {
        slot.products = this.groups.get(index === 0 ? this.type.value : 'cowls') || [];
        const select = slot.querySelector('[data-product]');
        select.replaceChildren(new Option('Choose a product', ''));
        slot.products.forEach(product => {
          const option = new Option(product.title, product.id);
          option.disabled = !product.variants.some(variant => this.purchasable(variant));
          if (option.disabled) option.text += ' — Unavailable';
          select.add(option);
        });
        slot.querySelector('legend').textContent = index === 0 ? ({dusters:'Choose your duster',jackets:'Choose your denim jacket',slings:'Choose your sling bag',cowls:'Choose your first cowl'}[this.type.value]) : 'Choose your cowl';
        this.populateVariants(slot);
      });
      this.update();
    }
    populateVariants(slot) {
      const product = slot.products.find(item => item.id === slot.querySelector('[data-product]').value);
      const select = slot.querySelector('[data-variant]');
      select.replaceChildren(new Option('Choose an option', ''));
      select.disabled = !product;
      if (product) {
        product.variants.forEach(variant => {
          const label = variant.title === 'Default Title' ? 'One option' : variant.title;
          const option = new Option(label + ' — ' + this.money.format(Number(variant.price) / 100), variant.id);
          option.disabled = !this.purchasable(variant);
          if (option.disabled) option.text += ' — Unavailable';
          select.add(option);
        });
        const available = product.variants.filter(variant => this.purchasable(variant));
        if (available.length === 1) select.value = available[0].id;
      }
      this.update();
    }
    selected() {
      return this.slots.map(slot => {
        const product = (slot.products || []).find(item => item.id === slot.querySelector('[data-product]').value);
        const variant = product?.variants.find(item => item.id === slot.querySelector('[data-variant]').value);
        return {product, variant};
      });
    }
    update() {
      const selected = this.selected();
      selected.forEach(({product,variant}, index) => {
        const slot = this.slots[index];
        const photo = slot.querySelector('[data-photo]');
        const src = variant?.image || product?.image;
        photo.hidden = !src;
        if (src) photo.src = src; else photo.removeAttribute('src');
        photo.alt = variant?.alt || product?.alt || '';
        const link = slot.querySelector('[data-product-link]');
        link.hidden = !product;
        if (product) link.href = product.url; else link.removeAttribute('href');
      });
      let valid = selected.every(({variant}) => variant && this.purchasable(variant));
      let error = '';
      if (valid && selected[0].variant.id === selected[1].variant.id) {
        const variant = selected[0].variant;
        if ((variant.stock !== undefined && Number(variant.stock) < 2) || (variant.max && Number(variant.max) < 2)) {
          valid = false;
          error = 'Only one of this option is available. Please choose a different second cowl.';
        }
      }
      const allSelected = selected.every(item => item.variant);
      const subtotalEl = this.querySelector('[data-subtotal]');
      const savingsRow = this.querySelector('[data-savings-row]');
      const savingsEl = this.querySelector('[data-savings]');
      const discountPercentEl = this.querySelector('[data-discount-percent]');
      const totalRow = this.querySelector('[data-total-row]');
      const totalEl = this.querySelector('[data-total]');
      const discountPercent = Math.max(0, Number(this.discounts[this.type.value] || 0));

      if (allSelected) {
        const regularCents = selected.reduce((sum,item) => sum + Number(item.variant.price), 0);
        const savingsCents = Math.round(regularCents * discountPercent / 100);
        const discountedCents = Math.max(regularCents - savingsCents, 0);

        subtotalEl.textContent = this.money.format(regularCents / 100);
        discountPercentEl.textContent = discountPercent;
        savingsEl.textContent = '-' + this.money.format(savingsCents / 100);
        totalEl.textContent = this.money.format(discountedCents / 100);
        savingsRow.hidden = discountPercent <= 0;
        totalRow.hidden = false;
      } else {
        subtotalEl.textContent = 'Choose two items';
        savingsRow.hidden = true;
        totalRow.hidden = true;
      }
      this.button.disabled = !valid || this.busy;
      if (!this.busy) this.status.textContent = error;
    }
    async addPair() {
      this.update();
      if (this.button.disabled) return;
      this.busy = true;
      this.button.disabled = true;
      this.type.disabled = true;
      this.slots.forEach(slot => slot.disabled = true);
      this.status.textContent = 'Adding your pair…';
      const items = [];
      const bundleType = this.type.value;
      const bundleName = this.bundleNames[bundleType] || 'Custom bundle';
      const discountPercent = Math.max(0, Number(this.discounts[bundleType] || 0));
      const bundleKey = 'ccg-' + Date.now() + '-' + Math.random().toString(36).slice(2, 9);

      this.selected().forEach(({variant}) => {
        items.push({
          id: variant.id,
          quantity: 1,
          properties: {
            '_CCG Bundle Key': bundleKey,
            '_CCG Bundle Type': bundleType,
            'Bundle': bundleName,
            'Bundle savings': discountPercent + '%'
          }
        });
      });
      try {
        const response = await fetch(this.dataset.addUrl, {method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json','Accept':'application/json'}, body:JSON.stringify({items})});
        const result = await response.json();
        if (!response.ok) throw new Error(typeof result.description === 'string' ? result.description : 'Unable to add the pair. Please check availability.');
        window.location.assign(this.dataset.cartUrl);
      } catch (error) {
        this.busy = false;
        this.type.disabled = false;
        this.slots.forEach(slot => slot.disabled = false);
        this.update();
        this.status.textContent = error.message + ' Check your cart before retrying; some items may already have been added.';
      }
    }
  });
}
</script>
{% else %}
{% render 'ccg-section-spacing' %}

<div class="ccg-bundles section"{% if section.settings.seo_layout == 'linked' %} id="ccg-bundles" style="scroll-margin-top: 6rem;"{% endif %}>
  <div class="ccg-bundles__inner">
  <div class="ccg-bundles__head">
    <div class="ccg-bundles__head-text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ccg-bundles__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ccg-bundles__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.quote != blank -%}
      <p class="ccg-bundles__quote">{{ section.settings.quote }}</p>
    {%- endif -%}
  </div>

  {%- liquid
    assign filter_ids = ''
    for block in section.blocks
      if block.settings.bundle_id != blank
        assign filter_ids = filter_ids | append: block.settings.bundle_id | append: '|||'
      endif
    endfor
  -%}
  <div
    class="ccg-bundles__grid"
    data-bundler-grid="{{ section.id }}"
    data-bundler-filter="{{ filter_ids | escape }}"
  ></div>
  </div>
</div>

<script>
  (function () {
    var grid = document.querySelector('[data-bundler-grid="{{ section.id }}"]');
    if (!grid) return;

    var filterIds = (grid.getAttribute('data-bundler-filter') || '')
      .split('|||')
      .map(function (s) { return s.trim(); })
      .filter(Boolean);

    var money = function (cents) {
      return '$' + (cents / 100).toFixed(2);
    };

    function fetchProduct(handle) {
      return fetch('/products/' + handle + '.js', { credentials: 'same-origin' }).then(function (r) {
        if (!r.ok) throw new Error('Failed to fetch product: ' + handle);
        return r.json();
      });
    }

    function buildCard(bundle, products) {
      var regularCents = 0;
      products.forEach(function (p) { regularCents += p.price; });

      var discountPercent = parseFloat(bundle.percentage_value) || 0;
      var fixedAmount = parseFloat(bundle.fixed_amount_value) || 0;
      var priceCents = regularCents;
      if (bundle.discount_type === 'percentage' && discountPercent > 0) {
        priceCents = Math.round(regularCents * (100 - discountPercent) / 100);
      } else if (bundle.discount_type === 'fixed_amount' && fixedAmount > 0) {
        priceCents = Math.max(regularCents - Math.round(fixedAmount * 100), 0);
      }
      var saveCents = regularCents - priceCents;

      var title = bundle.name || products.map(function (p) { return p.title; }).join(' + ');

      var card = document.createElement('div');
      card.className = 'ccg-bundle-card';

      var media = document.createElement('div');
      media.className = 'ccg-bundle-card__media';

      products.forEach(function (p) {
        var hasAlt = !!(p.images && p.images[1]);
        var slot = document.createElement('span');
        slot.className = 'ccg-bundle-card__img' + (hasAlt ? ' ccg-bundle-card__img--has-alt' : '');

        var primary = document.createElement('img');
        primary.className = 'ccg-bundle-card__photo ccg-bundle-card__photo--primary';
        primary.src = p.featured_image || (p.images && p.images[0]) || '';
        primary.alt = p.title || title;
        primary.loading = 'lazy';
        slot.appendChild(primary);

        if (hasAlt) {
          var secondary = document.createElement('img');
          secondary.className = 'ccg-bundle-card__photo ccg-bundle-card__photo--secondary';
          secondary.src = p.images[1];
          secondary.alt = p.title || title;
          secondary.loading = 'lazy';
          slot.appendChild(secondary);
        }

        media.appendChild(slot);
      });

      var body = document.createElement('div');
      body.className = 'ccg-bundle-card__body';

      var titleEl = document.createElement('h3');
      titleEl.className = 'ccg-bundle-card__title';
      titleEl.textContent = title;
      body.appendChild(titleEl);

      var priceWrap = document.createElement('div');
      priceWrap.className = 'ccg-bundle-card__price';

      var priceNow = document.createElement('span');
      priceNow.className = 'ccg-bundle-card__price-now';
      priceNow.textContent = money(priceCents);
      priceWrap.appendChild(priceNow);

      if (saveCents > 0) {
        var priceWas = document.createElement('span');
        priceWas.className = 'ccg-bundle-card__price-was';
        priceWas.textContent = money(regularCents);
        priceWrap.appendChild(priceWas);
      }
      body.appendChild(priceWrap);

      if (saveCents > 0) {
        var saveEl = document.createElement('span');
        saveEl.className = 'ccg-bundle-card__save';
        saveEl.textContent = 'Save ' + money(saveCents);
        body.appendChild(saveEl);
      }

      card.appendChild(media);
      card.appendChild(body);
      return card;
    }

    function renderBundles(bundles) {
      if (!Array.isArray(bundles) || !bundles.length) return;

      var enabled = bundles.filter(function (b) {
        return !b.status || b.status === 'enabled' || b.status === 'active';
      });

      if (!filterIds.length) return;

      var active = filterIds
        .map(function (id) {
          return enabled.find(function (b) { return String(b.id) === id; });
        })
        .filter(Boolean);
      if (!active.length) return;

      Promise.all(
        active.map(function (bundle) {
          var handles = Object.values(bundle.products || {})
            .map(function (p) { return p.handle; })
            .filter(Boolean);
          if (!handles.length) return null;
          return Promise.all(handles.map(fetchProduct)).then(function (products) {
            return buildCard(bundle, products);
          });
        })
      )
        .then(function (cards) {
          grid.innerHTML = '';
          cards.forEach(function (card) {
            if (card) grid.appendChild(card);
          });
        })
        .catch(function (e) {
          console.warn('[ccg-bundles] Failed to render bundles:', e);
        });
    }

    function showDesignModeHelper(bundles) {
      if (!window.Shopify || !window.Shopify.designMode) return;
      if (!Array.isArray(bundles)) return;
      var old = document.querySelector('[data-bundler-helper="' + grid.getAttribute('data-bundler-grid') + '"]');
      if (old) old.remove();

      var helper = document.createElement('div');
      helper.setAttribute('data-bundler-helper', grid.getAttribute('data-bundler-grid'));
      helper.style.cssText = 'margin-bottom:16px;padding:12px 16px;background:#fff8e6;border:1px dashed #c4a177;font-family:monospace;font-size:13px;line-height:1.7;color:#4a3d31;';

      var title = document.createElement('div');
      title.style.cssText = 'font-weight:700;margin-bottom:6px;';
      title.textContent = 'Bundle IDs (live from Bundler — only visible while editing):';
      helper.appendChild(title);

      bundles.forEach(function (b) {
        var row = document.createElement('div');
        row.textContent = (b.name || 'Untitled') + '  =  ' + b.id + '  (' + (b.status || 'unknown') + ')';
        helper.appendChild(row);
      });

      grid.parentElement.insertBefore(helper, grid);
    }

    var attempts = 0;
    var maxAttempts = 100;
    var rendered = false;

    (function waitForBundler() {
      attempts++;
      if (window.bndlr && typeof window.bndlr.getBundles === 'function') {
        try {
          var result = window.bndlr.getBundles();
          if (result && typeof result.then === 'function') {
            result.then(function (bundles) {
              if (Array.isArray(bundles) && bundles.length) {
                rendered = true;
                showDesignModeHelper(bundles);
                renderBundles(bundles);
              }
            }).catch(function () {});
          } else if (Array.isArray(result) && result.length) {
            rendered = true;
            showDesignModeHelper(result);
            renderBundles(result);
          }
        } catch (e) {
          console.warn('[ccg-bundles] Bundler getBundles() failed:', e);
        }
      }
      if (!rendered && attempts < maxAttempts) {
        setTimeout(waitForBundler, 300);
      }
    })();
  })();
</script>

{% endif %}
{% stylesheet %}
  .ccg-bundles {
    font-family: 'Karla', system-ui, sans-serif;
    background: var(--ccg-cream);
  }

  .ccg-bundles__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .ccg-bundles__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .ccg-bundles__head-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ccg-bundles__eyebrow {
    margin: 0;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ccg-tan);
  }

  .ccg-bundles__heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 33px;
    color: var(--ccg-ink);
  }

  .ccg-bundles__quote {
    margin: 0;
    font-size: 16px;
    font-style: normal;
    color: var(--ccg-stone);
    max-width: 300px;
    text-align: right;
    line-height: 1.55;
  }

  .ccg-bundles__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .ccg-bundle-card {
    display: flex;
    gap: 24px;
    align-items: center;
    border: 1px solid var(--ccg-hairline);
    padding: 24px;
    background: var(--ccg-cream-soft);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ccg-bundle-card:hover {
    border-color: var(--ccg-tan);
    box-shadow: 0 4px 16px rgba(33, 28, 23, 0.08);
  }

  .ccg-bundle-card:hover .ccg-bundle-card__img img {
    transform: scale(1.03);
  }

  .ccg-bundle-card__media {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .ccg-bundle-card__img {
    position: relative;
    width: 124px;
    height: 158px;
    overflow: hidden;
    background: var(--ccg-sand);
  }

  .ccg-bundle-card__img img,
  .ccg-bundle-card__img svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .ccg-bundle-card__img--has-alt .ccg-bundle-card__photo {
    position: absolute;
    inset: 0;
    transition: transform 0.5s ease, opacity 0.4s ease;
  }

  .ccg-bundle-card__img--has-alt .ccg-bundle-card__photo--secondary {
    opacity: 0;
  }

  .ccg-bundle-card:hover .ccg-bundle-card__img--has-alt .ccg-bundle-card__photo--primary {
    opacity: 0;
  }

  .ccg-bundle-card:hover .ccg-bundle-card__img--has-alt .ccg-bundle-card__photo--secondary {
    opacity: 1;
  }

  .ccg-bundle-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .ccg-bundle-card__title {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.38;
    color: var(--ccg-ink);
  }

  .ccg-bundle-card__description {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ccg-stone);
  }

  .ccg-bundle-card__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 2px;
  }

  .ccg-bundle-card__price-now {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 22px;
    letter-spacing: 0.04em;
    color: var(--ccg-ink);
  }

  .ccg-bundle-card__price-was {
    font-size: 15px;
    color: #a2957f;
    text-decoration: line-through;
  }

  .ccg-bundle-card__save {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    letter-spacing: 0.16em;
    color: var(--ccg-tan);
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .ccg-bundles__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .ccg-bundles__inner {
      gap: 28px;
    }
    .ccg-bundle-card__img{
      aspect-ratio: 1;
      width: 100%;
    }
    .ccg-bundles__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 9px;
    }
    .ccg-bundle-card__media {
        width: 100%;
    }
    .ccg-bundles__quote {
      text-align: left;
      max-width: none;
    }
    .ccg-bundle-card__body{
      gap: 0;
    }
    .ccg-bundles__heading {
      font-size: 22px;
    }
    .ccg-bundle-card__price-now {
      font-size: 18px;
    }
    .ccg-bundle-card__title {
     font-size: 15px;
    }
    .ccg-bundle-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px;
    }
  }
{% endstylesheet %}

