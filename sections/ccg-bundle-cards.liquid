{% render 'ccg-section-spacing' %}

<div class="ccg-bundles section">
  <div class="ccg-bundles__inner">
  <div class="ccg-bundles__head">
    <div class="ccg-bundles__head-text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ccg-bundles__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ccg-bundles__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.quote != blank -%}
      <p class="ccg-bundles__quote">{{ section.settings.quote }}</p>
    {%- endif -%}
  </div>

  <div class="ccg-bundles__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign product_1 = block.settings.product_1
        assign product_2 = block.settings.product_2
        assign card_image_1 = block.settings.image_1 | default: product_1.featured_image
        assign card_image_2 = block.settings.image_2 | default: product_2.featured_image
        assign card_title = block.settings.title
        if card_title == blank
          if product_1 != blank and product_2 != blank
            assign card_title = product_1.title | append: ' + ' | append: product_2.title
          elsif product_1 != blank
            assign card_title = product_1.title
          endif
        endif

        assign regular_cents = 0
        assign has_product_pricing = false
        if product_1 != blank
          assign has_product_pricing = true
          assign regular_cents = regular_cents | plus: product_1.price
        endif
        if product_2 != blank
          assign has_product_pricing = true
          assign regular_cents = regular_cents | plus: product_2.price
        endif

        assign discount_percent = block.settings.discount_percent
        assign card_price = block.settings.price
        assign card_compare_at_price = block.settings.compare_at_price
        assign card_save_text = block.settings.save_text
        if has_product_pricing and discount_percent > 0
          assign discount_factor = 100 | minus: discount_percent
          assign discounted_cents = regular_cents | times: discount_factor | divided_by: 100
          assign save_cents = regular_cents | minus: discounted_cents
          assign save_money = save_cents | money
          assign card_price = discounted_cents | money
          assign card_compare_at_price = regular_cents | money
          assign card_save_text = 'Save ' | append: save_money
        elsif has_product_pricing
          assign card_price = regular_cents | money
          assign card_compare_at_price = blank
          assign card_save_text = blank
        endif

        assign card_image_1_hover = product_1.images[1]
        assign card_image_2_hover = product_2.images[1]
      -%}
      <div class="ccg-bundle-card" {{ block.shopify_attributes }}>
        <div class="ccg-bundle-card__media">
          <span class="ccg-bundle-card__img{% if card_image_1_hover != blank %} ccg-bundle-card__img--has-alt{% endif %}">
            {%- if card_image_1 != blank -%}
              {{
                card_image_1
                | image_url: width: 400
                | image_tag: widths: '200, 300, 400', alt: card_title, class: 'ccg-bundle-card__photo ccg-bundle-card__photo--primary'
              }}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
            {%- if card_image_1_hover != blank -%}
              {{
                card_image_1_hover
                | image_url: width: 400
                | image_tag: widths: '200, 300, 400', alt: card_title, class: 'ccg-bundle-card__photo ccg-bundle-card__photo--secondary'
              }}
            {%- endif -%}
          </span>
          <span class="ccg-bundle-card__img{% if card_image_2_hover != blank %} ccg-bundle-card__img--has-alt{% endif %}">
            {%- if card_image_2 != blank -%}
              {{
                card_image_2
                | image_url: width: 400
                | image_tag: widths: '200, 300, 400', alt: card_title, class: 'ccg-bundle-card__photo ccg-bundle-card__photo--primary'
              }}
            {%- else -%}
              {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
            {%- if card_image_2_hover != blank -%}
              {{
                card_image_2_hover
                | image_url: width: 400
                | image_tag: widths: '200, 300, 400', alt: card_title, class: 'ccg-bundle-card__photo ccg-bundle-card__photo--secondary'
              }}
            {%- endif -%}
          </span>
        </div>

        <div class="ccg-bundle-card__body">
          <h3 class="ccg-bundle-card__title">{{ card_title }}</h3>
          {%- if block.settings.description != blank -%}
            <p class="ccg-bundle-card__description">{{ block.settings.description }}</p>
          {%- endif -%}
          <div class="ccg-bundle-card__price">
            {%- if card_price != blank -%}
              <span class="ccg-bundle-card__price-now">{{ card_price }}</span>
            {%- endif -%}
            {%- if card_compare_at_price != blank -%}
              <span class="ccg-bundle-card__price-was">{{ card_compare_at_price }}</span>
            {%- endif -%}
          </div>
          {%- if card_save_text != blank -%}
            <span class="ccg-bundle-card__save">{{ card_save_text }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
  </div>
</div>

{% stylesheet %}
  .ccg-bundles {
    font-family: 'Karla', system-ui, sans-serif;
    background: var(--ccg-cream);
  }

  .ccg-bundles__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .ccg-bundles__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .ccg-bundles__head-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ccg-bundles__eyebrow {
    margin: 0;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ccg-tan);
  }

  .ccg-bundles__heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 33px;
    color: var(--ccg-ink);
  }

  .ccg-bundles__quote {
    margin: 0;
    font-size: 16px;
    font-style: normal;
    color: var(--ccg-stone);
    max-width: 300px;
    text-align: right;
    line-height: 1.55;
  }

  .ccg-bundles__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .ccg-bundle-card {
    display: flex;
    gap: 24px;
    align-items: center;
    border: 1px solid var(--ccg-hairline);
    padding: 24px;
    background: var(--ccg-cream-soft);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ccg-bundle-card:hover {
    border-color: var(--ccg-tan);
    box-shadow: 0 4px 16px rgba(33, 28, 23, 0.08);
  }

  .ccg-bundle-card:hover .ccg-bundle-card__img img {
    transform: scale(1.03);
  }

  .ccg-bundle-card__media {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .ccg-bundle-card__img {
    position: relative;
    width: 124px;
    height: 158px;
    overflow: hidden;
    background: var(--ccg-sand);
  }

  .ccg-bundle-card__img img,
  .ccg-bundle-card__img svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .ccg-bundle-card__img--has-alt .ccg-bundle-card__photo {
    position: absolute;
    inset: 0;
    transition: transform 0.5s ease, opacity 0.4s ease;
  }

  .ccg-bundle-card__img--has-alt .ccg-bundle-card__photo--secondary {
    opacity: 0;
  }

  .ccg-bundle-card:hover .ccg-bundle-card__img--has-alt .ccg-bundle-card__photo--primary {
    opacity: 0;
  }

  .ccg-bundle-card:hover .ccg-bundle-card__img--has-alt .ccg-bundle-card__photo--secondary {
    opacity: 1;
  }

  .ccg-bundle-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .ccg-bundle-card__title {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.38;
    color: var(--ccg-ink);
  }

  .ccg-bundle-card__description {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ccg-stone);
  }

  .ccg-bundle-card__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 2px;
  }

  .ccg-bundle-card__price-now {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 22px;
    letter-spacing: 0.04em;
    color: var(--ccg-ink);
  }

  .ccg-bundle-card__price-was {
    font-size: 15px;
    color: #a2957f;
    text-decoration: line-through;
  }

  .ccg-bundle-card__save {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    letter-spacing: 0.16em;
    color: var(--ccg-tan);
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .ccg-bundles__grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .ccg-bundles__inner {
      gap: 28px;
    }

    .ccg-bundles__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .ccg-bundles__quote {
      text-align: left;
      max-width: none;
    }

    .ccg-bundles__heading {
      font-size: 26px;
    }

    .ccg-bundle-card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Bundle Cards",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "COMPLETE THE LOOK"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Matched sets, save 10%"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote line",
      "default": "I pair these myself, from the same blanket run. — Melissa"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f5ee"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        {
          "type": "range",
          "id": "discount_percent",
          "label": "Bundle discount",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "%",
          "default": 10,
          "info": "Set to match the discount configured in your bundle app (e.g. Bundler)."
        },
        { "type": "image_picker", "id": "image_1", "label": "Image 1 override" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2 override" },
        {
          "type": "text",
          "id": "title",
          "label": "Title override",
          "info": "Leave blank to use the selected products' names automatically."
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Same blanket run, cut back to back. One set exists."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price override",
          "info": "Auto-calculated from the two products' prices when both are selected."
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare-at price override",
          "info": "Auto-calculated from the products' compare-at prices when selected."
        },
        {
          "type": "text",
          "id": "save_text",
          "label": "Save badge text override",
          "info": "Auto-calculated (Save $X) when products are selected."
        },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Add both" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CCG Bundle Cards",
      "blocks": [
        {
          "type": "bundle",
          "settings": {
            "title": "Nehalem Cowl + Matching Sling",
            "description": "Same blanket run, cut back to back. One set exists.",
            "price": "$159",
            "compare_at_price": "$177",
            "save_text": "Save $18"
          }
        },
        {
          "type": "bundle",
          "settings": {
            "title": "Duster + Grey Aztec Cowl",
            "description": "The cold-morning uniform. Both one of one.",
            "price": "$289",
            "compare_at_price": "$318",
            "save_text": "Save $29"
          }
        }
      ]
    }
  ]
}
{% endschema %}
