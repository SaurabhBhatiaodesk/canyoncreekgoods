<div class="ccg-bundles page-width">
  <div class="ccg-bundles__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ccg-bundles__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ccg-bundles__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.quote != blank -%}
      <p class="ccg-bundles__quote">{{ section.settings.quote }}</p>
    {%- endif -%}
  </div>

  <div class="ccg-bundles__grid">
    {%- for block in section.blocks -%}
      <div class="ccg-bundle-card" {{ block.shopify_attributes }}>
        <div class="ccg-bundle-card__media">
          <span class="ccg-bundle-card__img">
            {%- if block.settings.image_1 != blank -%}
              {{ block.settings.image_1 | image_url: width: 700 | image_tag: widths: '300, 450, 700', alt: block.settings.title }}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </span>
          <span class="ccg-bundle-card__img">
            {%- if block.settings.image_2 != blank -%}
              {{ block.settings.image_2 | image_url: width: 700 | image_tag: widths: '300, 450, 700', alt: block.settings.title }}
            {%- else -%}
              {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </span>
          {%- if block.settings.save_text != blank -%}
            <span class="ccg-bundle-card__badge">{{ block.settings.save_text }}</span>
          {%- endif -%}
        </div>

        <div class="ccg-bundle-card__body">
          <h3 class="ccg-bundle-card__title">{{ block.settings.title }}</h3>
          {%- if block.settings.description != blank -%}
            <p class="ccg-bundle-card__description">{{ block.settings.description }}</p>
          {%- endif -%}
          <div class="ccg-bundle-card__footer">
            <span class="ccg-bundle-card__price">
              {%- if block.settings.price != blank -%}
                <span class="ccg-bundle-card__price-now">{{ block.settings.price }}</span>
              {%- endif -%}
              {%- if block.settings.compare_at_price != blank -%}
                <span class="ccg-bundle-card__price-was">{{ block.settings.compare_at_price }}</span>
              {%- endif -%}
            </span>
            <a href="{{ block.settings.button_link | default: '#' }}" class="ccg-btn ccg-btn--solid">
              {{ block.settings.button_label | default: 'Add both' }}
            </a>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .ccg-bundles {
    --ccg-ink: #211c17;
    --ccg-cream: #fbf8f2;
    --ccg-tan: #7a6d5d;

    font-family: 'Karla', system-ui, sans-serif;
    padding-block: 72px;
  }

  .ccg-bundles__head {
    text-align: center;
    max-width: 52ch;
    margin: 0 auto 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .ccg-bundles__eyebrow {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ccg-tan);
  }

  .ccg-bundles__heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: clamp(26px, 3vw, 34px);
    color: var(--ccg-ink);
  }

  .ccg-bundles__quote {
    margin: 8px 0 0;
    font-style: italic;
    color: var(--ccg-ink);
  }

  .ccg-bundles__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .ccg-bundle-card {
    border: 1px solid var(--ccg-ink);
    background: var(--ccg-cream);
    display: flex;
    flex-direction: column;
  }

  .ccg-bundle-card__media {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .ccg-bundle-card__img {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-bottom: 1px solid var(--ccg-ink);
  }

  .ccg-bundle-card__img:first-child {
    border-right: 1px solid var(--ccg-ink);
  }

  .ccg-bundle-card__img img,
  .ccg-bundle-card__img svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ccg-bundle-card__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--ccg-ink);
    color: var(--ccg-cream);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 6px 10px;
  }

  .ccg-bundle-card__body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .ccg-bundle-card__title {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 19px;
    color: var(--ccg-ink);
  }

  .ccg-bundle-card__description {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ccg-tan);
    flex: 1;
  }

  .ccg-bundle-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .ccg-bundle-card__price {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.02em;
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--ccg-ink);
  }

  .ccg-bundle-card__price-was {
    font-size: 15px;
    font-weight: 400;
    color: var(--ccg-tan);
    text-decoration: line-through;
  }

  .ccg-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--ccg-ink);
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .ccg-btn--solid {
    background: var(--ccg-ink);
    color: var(--ccg-cream);
  }

  .ccg-btn:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ccg-bundles {
      padding-block: 44px;
    }

    .ccg-bundles__grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .ccg-bundle-card__footer {
      flex-direction: column;
      align-items: stretch;
    }

    .ccg-bundle-card__footer .ccg-btn {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Bundle Cards",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "COMPLETE THE LOOK"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Matched sets, save 10%"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote line",
      "default": "I pair these myself, from the same blanket run. — Melissa"
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        { "type": "image_picker", "id": "image_1", "label": "Image 1" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" },
        { "type": "text", "id": "title", "label": "Title", "default": "Nehalem Cowl + Matching Sling" },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Same blanket run, cut back to back. One set exists."
        },
        { "type": "text", "id": "price", "label": "Price", "default": "$159" },
        { "type": "text", "id": "compare_at_price", "label": "Compare-at price", "default": "$177" },
        { "type": "text", "id": "save_text", "label": "Save badge text", "default": "SAVE $18" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Add both" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CCG Bundle Cards",
      "blocks": [
        {
          "type": "bundle",
          "settings": {
            "title": "Nehalem Cowl + Matching Sling",
            "description": "Same blanket run, cut back to back. One set exists.",
            "price": "$159",
            "compare_at_price": "$177",
            "save_text": "SAVE $18"
          }
        },
        {
          "type": "bundle",
          "settings": {
            "title": "Duster + Grey Aztec Cowl",
            "description": "The cold-morning uniform. Both one of one.",
            "price": "$289",
            "compare_at_price": "$318",
            "save_text": "SAVE $29"
          }
        }
      ]
    }
  ]
}
{% endschema %}
