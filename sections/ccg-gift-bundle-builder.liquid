{%- liquid
  assign has_bundle_blocks = false

  for block in section.blocks
    if block.type == 'bundle' and block.settings.bundle_id != blank
      assign has_bundle_blocks = true
      break
    endif
  endfor
-%}

<section
  id="CCGGiftBuilder-{{ section.id }}"
  class="ccg-gift-builder"
  data-gift-builder
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  style="
    --builder-bg: {{ section.settings.background_color }};
    --builder-ink: {{ section.settings.text_color }};
    --builder-accent: {{ section.settings.accent_color }};
  "
>
  <div class="ccg-gift-builder__inner">
    <div class="ccg-gift-builder__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ccg-gift-builder__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ccg-gift-builder__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="ccg-gift-builder__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if has_bundle_blocks -%}
      <div class="ccg-gift-builder__plans" role="group" aria-label="Choose bundle size">
        {%- for block in section.blocks -%}
          {%- if block.type == 'bundle' and block.settings.bundle_id != blank -%}
            <button
              class="ccg-gift-builder__plan is-loading"
              type="button"
              data-plan
              data-bundle-id="{{ block.settings.bundle_id | escape }}"
              aria-pressed="false"
              {{ block.shopify_attributes }}
            >
              <span data-plan-label></span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="ccg-gift-builder__status" aria-live="polite">
        <span>
          Selected:
          <strong data-total>0</strong>
          of
          <strong data-target-count>0</strong>
        </span>
        <span data-status>Loading bundle rules…</span>
      </div>

      <div class="ccg-gift-builder__selected-grid" data-selected-grid>
        <button class="ccg-gift-builder__add-card" type="button" data-open-picker disabled>
          <span class="ccg-gift-builder__plus">+</span>
          <span>Add product</span>
        </button>
      </div>

      <button class="ccg-gift-builder__choose" type="button" data-open-picker disabled>
        Choose a product
      </button>

      <div class="ccg-gift-builder__summary">
        <div>
          <span>Bundle subtotal</span>
          <strong data-subtotal>—</strong>
        </div>

        <div>
          <span>
            Bundle discount
            (<span data-discount-label>—</span>)
          </span>
          <strong data-savings>—</strong>
        </div>

        <div class="ccg-gift-builder__total-row">
          <span>Bundle total</span>
          <strong data-price>—</strong>
        </div>

        <button class="ccg-gift-builder__add" type="button" data-add disabled>
          Add to cart
        </button>

        <p class="ccg-gift-builder__error" data-error role="alert" hidden></p>
      </div>

      <div class="ccg-gift-builder__picker" data-picker hidden>
        <div class="ccg-gift-builder__picker-backdrop" data-close-picker></div>

        <div
          class="ccg-gift-builder__picker-panel"
          role="dialog"
          aria-modal="true"
          aria-label="Choose products"
        >
          <div class="ccg-gift-builder__picker-head">
            <div>
              <p class="ccg-gift-builder__picker-eyebrow">Choose products</p>
              <h3>Add cowls to your bundle</h3>
            </div>

            <button
              type="button"
              class="ccg-gift-builder__picker-close"
              data-close-picker
              aria-label="Close"
            >
              ×
            </button>
          </div>

          <div class="ccg-gift-builder__picker-grid" data-picker-grid></div>
        </div>
      </div>

      <!--
        MBC is the source of truth.
        These are the app's official manual-placement widgets, kept off-screen
        only as the live data/cart engine for the custom design above.
      -->
      <div class="ccg-gift-builder__mbc-bridge" data-mbc-bridge aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- if block.type == 'bundle' and block.settings.bundle_id != blank -%}
            <mbc-bundles-widget
              data-bundle-id="{{ block.settings.bundle_id | escape }}"
              data-ccg-mbc-widget
            ></mbc-bundles-widget>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="ccg-gift-builder__empty">
        Add at least one “MBC bundle” block and paste the bundle ID.
      </p>
    {%- endif -%}
  </div>
</section>

<script>
(() => {
  const root = document.getElementById('CCGGiftBuilder-{{ section.id }}');
  if (!root || root.dataset.ready === 'true') return;

  root.dataset.ready = 'true';

  const currencyCode = root.dataset.currency || 'USD';

  const plans = [...root.querySelectorAll('[data-plan]')];
  const bridgeWidgets = [...root.querySelectorAll('[data-ccg-mbc-widget]')];
  const selectedGrid = root.querySelector('[data-selected-grid]');
  const picker = root.querySelector('[data-picker]');
  const pickerGrid = root.querySelector('[data-picker-grid]');

  const totalEl = root.querySelector('[data-total]');
  const targetEl = root.querySelector('[data-target-count]');
  const statusEl = root.querySelector('[data-status]');
  const subtotalEl = root.querySelector('[data-subtotal]');
  const savingsEl = root.querySelector('[data-savings]');
  const priceEl = root.querySelector('[data-price]');
  const discountLabel = root.querySelector('[data-discount-label]');
  const addButton = root.querySelector('[data-add]');
  const errorEl = root.querySelector('[data-error]');
  const openPickerButtons = [...root.querySelectorAll('[data-open-picker]')];

  const stateById = new Map();

  let activeState = null;
  let activePlan = null;
  let syncTimer = null;

  const formatMoney = (cents) => {
    const amount = Number(cents || 0) / 100;

    try {
      return new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency: currencyCode
      }).format(amount);
    } catch (error) {
      return `$${amount.toFixed(2)}`;
    }
  };

  const parseMoney = (value) => {
    if (value == null) return null;

    const text = String(value)
      .replace(/\s/g, '')
      .replace(/,/g, '');

    const match = text.match(/-?\d+(?:\.\d{1,2})?/);
    if (!match) return null;

    const number = Number(match[0]);
    if (!Number.isFinite(number)) return null;

    return Math.round(number * 100);
  };

  const moneyAmountsFromText = (text) => {
    if (!text) return [];

    const matches = String(text).match(
      /(?:[$£€₹]\s*\d[\d,]*(?:\.\d{1,2})?|(?:USD|CAD|AUD|GBP|EUR|INR)\s*\d[\d,]*(?:\.\d{1,2})?)/gi
    ) || [];

    const values = matches
      .map(parseMoney)
      .filter((value) => Number.isFinite(value));

    return [...new Set(values)];
  };

  const normalizeText = (value) =>
    String(value || '')
      .replace(/\s+/g, ' ')
      .trim();

  const wait = (ms) => new Promise((resolve) => window.setTimeout(resolve, ms));

  const getWidgetForId = (bundleId) =>
    bridgeWidgets.find(
      (widget) => String(widget.dataset.bundleId || '') === String(bundleId || '')
    ) || null;

  const getWidgetText = (widget) => {
    if (!widget) return '';

    const chunks = [
      widget.textContent || ''
    ];

    if (widget.shadowRoot) {
      chunks.push(widget.shadowRoot.textContent || '');
    }

    return normalizeText(chunks.join(' '));
  };

  const findBundleObject = (source, wantedId) => {
    if (!source || !wantedId) return null;

    const wanted = String(wantedId);
    const seen = new WeakSet();
    const queue = [{ value: source, depth: 0 }];
    let visited = 0;

    while (queue.length && visited < 6000) {
      const { value, depth } = queue.shift();
      visited += 1;

      if (!value || typeof value !== 'object') continue;
      if (seen.has(value)) continue;
      seen.add(value);

      const candidateIds = [
        value.bundleId,
        value.bundle_id,
        value.bundleID,
        value.id
      ];

      if (candidateIds.some((id) => id != null && String(id) === wanted)) {
        return value;
      }

      if (depth >= 7) continue;

      let entries = [];

      try {
        entries = Array.isArray(value)
          ? value.map((child, index) => [String(index), child])
          : Object.entries(value);
      } catch (error) {
        entries = [];
      }

      for (const [, child] of entries) {
        if (child && typeof child === 'object') {
          queue.push({
            value: child,
            depth: depth + 1
          });
        }
      }
    }

    return null;
  };

  const extractObjectConfig = (bundle) => {
    if (!bundle || typeof bundle !== 'object') return {};

    const seen = new WeakSet();
    const queue = [{ value: bundle, depth: 0 }];

    let title = '';
    let minimum = null;
    let maximum = null;
    let discountType = '';
    let discountValue = null;

    const keyName = (key) =>
      String(key || '')
        .replace(/[^a-z0-9]/gi, '')
        .toLowerCase();

    while (queue.length) {
      const { value, depth } = queue.shift();

      if (!value || typeof value !== 'object') continue;
      if (seen.has(value)) continue;
      seen.add(value);

      let entries = [];

      try {
        entries = Array.isArray(value)
          ? value.map((child, index) => [String(index), child])
          : Object.entries(value);
      } catch (error) {
        entries = [];
      }

      for (const [rawKey, rawValue] of entries) {
        const key = keyName(rawKey);

        if (!title && typeof rawValue === 'string') {
          if (
            key === 'bundletitle' ||
            key === 'title' ||
            key === 'name'
          ) {
            const candidate = normalizeText(rawValue);

            if (candidate.length >= 2 && candidate.length <= 160) {
              title = candidate;
            }
          }
        }

        const numeric = Number(rawValue);

        if (Number.isFinite(numeric)) {
          if (
            minimum == null &&
            (
              key.includes('minimumitemsrequired') ||
              key.includes('minitems') ||
              key.includes('minimumquantity') ||
              key.includes('requireditems') ||
              key.includes('requiredquantity')
            )
          ) {
            minimum = numeric;
          }

          if (
            maximum == null &&
            (
              key.includes('maximumitemsallowed') ||
              key.includes('maxitems') ||
              key.includes('maximumquantity') ||
              key.includes('maxquantity')
            )
          ) {
            maximum = numeric;
          }

          if (
            discountValue == null &&
            (
              key.includes('discountpercentage') ||
              key.includes('discountpercent') ||
              key === 'percentage' ||
              key === 'percent'
            )
          ) {
            discountType = 'percentage';
            discountValue = numeric;
          }

          if (
            discountValue == null &&
            (
              key.includes('amountoff') ||
              key.includes('discountamount')
            )
          ) {
            discountType = 'amount';
            discountValue = numeric;
          }

          if (
            discountValue == null &&
            (
              key.includes('saleprice') ||
              key.includes('fixedprice')
            )
          ) {
            discountType = 'sale_price';
            discountValue = numeric;
          }
        }

        if (!discountType && typeof rawValue === 'string') {
          const lower = rawValue.toLowerCase();

          if (key.includes('discounttype') || key === 'type') {
            if (lower.includes('percent')) discountType = 'percentage';
            if (lower.includes('amount')) discountType = 'amount';
            if (lower.includes('sale') || lower.includes('fixed')) {
              discountType = 'sale_price';
            }
          }
        }

        if (
          rawValue &&
          typeof rawValue === 'object' &&
          depth < 8
        ) {
          queue.push({
            value: rawValue,
            depth: depth + 1
          });
        }
      }
    }

    return {
      title,
      minimum,
      maximum,
      discountType,
      discountValue
    };
  };

  const parseTextConfig = (widget, bundleId) => {
    const text = getWidgetText(widget);

    const titleNode =
      widget?.querySelector?.('.mbc-bundles-list__title') ||
      widget?.querySelector?.('.mbc-bundle h1, .mbc-bundle h2, .mbc-bundle h3');

    const title = normalizeText(titleNode?.textContent || '');

    let target = null;
    let discountType = '';
    let discountValue = null;

    const quantityPatterns = [
      /\bminimum(?:\s+items?\s+required)?\s*:?\s*(\d+)\b/i,
      /\brequired(?:\s+items?|\s+quantity)?\s*:?\s*(\d+)\b/i,
      /\bchoose\s+(\d+)\s+(?:items?|products?|cowls?)\b/i,
      /\bselect\s+(\d+)\s+(?:items?|products?|cowls?)\b/i,
      /\bgift\s+(\d+)\b/i,
      /\b(\d+)\s+(?:items?|products?|cowls?)\b/i
    ];

    for (const pattern of quantityPatterns) {
      const match = `${title} ${text}`.match(pattern);

      if (match) {
        target = Number(match[1]);
        break;
      }
    }

    const percentMatch = `${title} ${text}`.match(/(\d+(?:\.\d+)?)\s*%\s*(?:off)?/i);

    if (percentMatch) {
      discountType = 'percentage';
      discountValue = Number(percentMatch[1]);
    }

    return {
      title: title || `Bundle ${bundleId}`,
      target,
      discountType,
      discountValue
    };
  };

  const getRoot = (widget) => widget?.shadowRoot || widget;

  const getProductRows = (widget) => {
    const widgetRoot = getRoot(widget);

    return widgetRoot
      ? [...widgetRoot.querySelectorAll('.mbc-bundle__item.mbc-bundle__item--product')]
      : [];
  };

  const getRowControl = (row) => {
    const qty = row.querySelector('.mbc-bundle__qty-selector');

    if (qty) {
      const input = qty.querySelector('input');
      const buttons = [...qty.querySelectorAll('button')];

      return {
        type: 'quantity',
        container: qty,
        input,
        minus: buttons[0] || null,
        plus: buttons[buttons.length - 1] || null
      };
    }

    const checkbox = row.querySelector('.mbc-checkbox__input, .mbc-checkbox input[type="checkbox"]');

    if (checkbox) {
      return {
        type: 'checkbox',
        input: checkbox
      };
    }

    return {
      type: 'fixed'
    };
  };

  const getRowQuantity = (row) => {
    const control = getRowControl(row);

    if (control.type === 'quantity') {
      return Math.max(0, Number(control.input?.value || 0) || 0);
    }

    if (control.type === 'checkbox') {
      return control.input?.checked ? 1 : 0;
    }

    return 1;
  };

  const getBaseRowPrice = (row) => {
    const priceNode = row.querySelector('.mbc-bundle__item-price');
    const amounts = moneyAmountsFromText(priceNode?.textContent || '');

    if (!amounts.length) return 0;

    return Math.max(...amounts);
  };

  const getRowTitle = (row, index) => {
    const node = row.querySelector('.mbc-bundle__item-title');
    const text = normalizeText(node?.textContent || '');

    return text || `Product ${index + 1}`;
  };

  const getRowImage = (row) => {
    const image = row.querySelector('img');

    return image?.currentSrc || image?.src || '';
  };

  const buildProducts = (state) => {
    const rows = getProductRows(state.widget);

    return rows.map((row, index) => ({
      key: `${index}:${getRowTitle(row, index)}`,
      index,
      title: getRowTitle(row, index),
      image: getRowImage(row),
      price: getBaseRowPrice(row),
      quantity: getRowQuantity(row),
      unavailable: Boolean(row.querySelector('.mbc-bundle__item-out-of-stock'))
    }));
  };

  const readWidgetPrice = (state) => {
    const widgetRoot = getRoot(state.widget);
    const node = widgetRoot?.querySelector('.mbc-bundle__price');
    const text = normalizeText(node?.textContent || '');
    const amounts = moneyAmountsFromText(text);

    let total = null;
    let compareAt = null;

    if (amounts.length === 1) {
      total = amounts[0];
    }

    if (amounts.length >= 2) {
      total = Math.min(...amounts);
      compareAt = Math.max(...amounts);
    }

    const percentMatch = text.match(/(\d+(?:\.\d+)?)\s*%/);

    return {
      text,
      total,
      compareAt,
      percent:
        percentMatch
          ? Number(percentMatch[1])
          : null
    };
  };

  const waitForWidgetReady = async (widget, timeout = 12000) => {
    const started = Date.now();

    while (Date.now() - started < timeout) {
      const widgetRoot = getRoot(widget);

      if (
        widgetRoot?.querySelector('.mbc-bundle') &&
        widgetRoot?.querySelector('.mbc-bundle__item.mbc-bundle__item--product')
      ) {
        return true;
      }

      await wait(150);
    }

    return false;
  };

  const readBundleConfig = (state) => {
    const mbc = window.MAKEBECOOL_BUNDLES || null;

    const objectBundle =
      findBundleObject(mbc, state.id) ||
      findBundleObject(state.widget, state.id);

    const objectConfig = extractObjectConfig(objectBundle);
    const textConfig = parseTextConfig(state.widget, state.id);

    const title =
      objectConfig.title ||
      textConfig.title ||
      `Bundle ${state.id}`;

    let target =
      Number(objectConfig.minimum || 0) ||
      Number(textConfig.target || 0);

    if (
      Number(objectConfig.minimum) > 0 &&
      Number(objectConfig.maximum) > 0 &&
      Number(objectConfig.minimum) === Number(objectConfig.maximum)
    ) {
      target = Number(objectConfig.maximum);
    }

    let discountType =
      objectConfig.discountType ||
      textConfig.discountType ||
      '';

    let discountValue =
      Number.isFinite(Number(objectConfig.discountValue))
        ? Number(objectConfig.discountValue)
        : (
            Number.isFinite(Number(textConfig.discountValue))
              ? Number(textConfig.discountValue)
              : null
          );

    const widgetPrice = readWidgetPrice(state);

    if (!discountType && Number.isFinite(widgetPrice.percent)) {
      discountType = 'percentage';
      discountValue = widgetPrice.percent;
    }

    return {
      title,
      target,
      discountType,
      discountValue
    };
  };

  const setMbcQuantity = async (state, productIndex, requested) => {
    const rows = getProductRows(state.widget);
    const row = rows[productIndex];

    if (!row) return;

    const control = getRowControl(row);
    const next = Math.max(0, Math.round(Number(requested) || 0));

    if (control.type === 'quantity') {
      const current = getRowQuantity(row);

      if (!control.input) return;

      if (next > current) {
        for (let index = current; index < next; index += 1) {
          if (control.plus?.disabled) break;

          if (control.plus) {
            control.plus.click();
          } else {
            control.input.value = String(index + 1);
            control.input.dispatchEvent(new Event('input', { bubbles: true }));
            control.input.dispatchEvent(new Event('change', { bubbles: true }));
          }

          await wait(20);
        }
      }

      if (next < current) {
        for (let index = current; index > next; index -= 1) {
          if (control.minus?.disabled) break;

          if (control.minus) {
            control.minus.click();
          } else {
            control.input.value = String(index - 1);
            control.input.dispatchEvent(new Event('input', { bubbles: true }));
            control.input.dispatchEvent(new Event('change', { bubbles: true }));
          }

          await wait(20);
        }
      }
    }

    if (control.type === 'checkbox') {
      const checked = next > 0;

      if (control.input.checked !== checked) {
        control.input.click();
      }
    }

    scheduleSync();
  };

  const openPicker = () => {
    if (!picker || !activeState?.ready) return;

    picker.hidden = false;
    document.documentElement.classList.add('ccg-picker-open');
  };

  const closePicker = () => {
    if (!picker) return;

    picker.hidden = true;
    document.documentElement.classList.remove('ccg-picker-open');
  };

  openPickerButtons.forEach((button) => {
    button.addEventListener('click', openPicker);
  });

  root.querySelectorAll('[data-close-picker]').forEach((button) => {
    button.addEventListener('click', closePicker);
  });

  const renderPicker = () => {
    if (!pickerGrid) return;

    pickerGrid.innerHTML = '';

    if (!activeState?.ready) return;

    activeState.products.forEach((product) => {
      const button = document.createElement('button');

      button.type = 'button';
      button.className = 'ccg-gift-builder__picker-product';

      if (product.unavailable) {
        button.classList.add('is-unavailable');
        button.disabled = true;
      }

      if (product.quantity > 0) {
        button.classList.add('is-selected');
        button.disabled = true;
      }

      const media = document.createElement('span');
      media.className = 'ccg-gift-builder__picker-media';

      if (product.image) {
        const image = document.createElement('img');
        image.src = product.image;
        image.alt = product.title;
        image.loading = 'lazy';
        media.appendChild(image);
      }

      const copy = document.createElement('span');
      copy.className = 'ccg-gift-builder__picker-copy';

      const title = document.createElement('strong');
      title.textContent = product.title;

      const price = document.createElement('span');
      price.textContent =
        product.price > 0
          ? formatMoney(product.price)
          : '';

      copy.append(title, price);
      button.append(media, copy);

      if (product.quantity > 0) {
        const selected = document.createElement('span');
        selected.className = 'ccg-gift-builder__selected-badge';
        selected.textContent = 'Selected';
        button.appendChild(selected);
      }

      button.addEventListener('click', async () => {
        if (button.disabled) return;

        button.disabled = true;
        await setMbcQuantity(activeState, product.index, 1);
        closePicker();
      });

      pickerGrid.appendChild(button);
    });
  };

  const renderSelected = () => {
    if (!selectedGrid) return;

    selectedGrid
      .querySelectorAll('[data-selected-product]')
      .forEach((card) => card.remove());

    if (!activeState?.ready) return;

    activeState.products
      .filter((product) => product.quantity > 0)
      .forEach((product) => {
        const article = document.createElement('article');

        article.className = 'ccg-gift-builder__product-card';
        article.dataset.selectedProduct = '';

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'ccg-gift-builder__remove';
        remove.textContent = 'Remove product';

        remove.addEventListener('click', async () => {
          remove.disabled = true;
          await setMbcQuantity(activeState, product.index, 0);
        });

        const media = document.createElement('div');
        media.className = 'ccg-gift-builder__product-media';

        if (product.image) {
          const image = document.createElement('img');
          image.src = product.image;
          image.alt = product.title;
          image.loading = 'lazy';
          media.appendChild(image);
        }

        const copy = document.createElement('div');
        copy.className = 'ccg-gift-builder__product-copy';

        const title = document.createElement('h3');
        title.textContent = product.title;

        const price = document.createElement('p');
        price.textContent =
          product.price > 0
            ? formatMoney(product.price)
            : '';

        const quantityLabel = document.createElement('div');
        quantityLabel.className = 'ccg-gift-builder__quantity-label';
        quantityLabel.textContent = 'Quantity';

        const quantity = document.createElement('div');
        quantity.className = 'ccg-gift-builder__quantity';

        const minus = document.createElement('button');
        minus.type = 'button';
        minus.textContent = '−';
        minus.disabled = product.quantity <= 1;

        const input = document.createElement('input');
        input.type = 'number';
        input.min = '1';
        input.value = String(product.quantity);
        input.inputMode = 'numeric';

        if (activeState.target > 0) {
          input.max = String(activeState.target);
        }

        const plus = document.createElement('button');
        plus.type = 'button';
        plus.textContent = '+';

        const selectedTotal = activeState.products.reduce(
          (sum, item) => sum + item.quantity,
          0
        );

        if (
          activeState.target > 0 &&
          selectedTotal >= activeState.target
        ) {
          plus.disabled = true;
        }

        minus.addEventListener('click', async () => {
          if (product.quantity <= 1) return;

          minus.disabled = true;
          await setMbcQuantity(
            activeState,
            product.index,
            product.quantity - 1
          );
        });

        plus.addEventListener('click', async () => {
          plus.disabled = true;
          await setMbcQuantity(
            activeState,
            product.index,
            product.quantity + 1
          );
        });

        input.addEventListener('change', async () => {
          const requested = Math.max(
            1,
            Math.round(Number(input.value) || product.quantity)
          );

          input.disabled = true;
          await setMbcQuantity(
            activeState,
            product.index,
            requested
          );
        });

        quantity.append(minus, input, plus);
        copy.append(title, price, quantityLabel, quantity);
        article.append(remove, media, copy);

        const addCard = selectedGrid.querySelector('[data-open-picker]');
        selectedGrid.insertBefore(article, addCard);
      });
  };

  const getSummary = () => {
    if (!activeState?.ready) {
      return {
        totalQty: 0,
        subtotal: null,
        savings: null,
        total: null,
        discountLabel: '—'
      };
    }

    const totalQty = activeState.products.reduce(
      (sum, product) => sum + product.quantity,
      0
    );

    const subtotal = activeState.products.reduce(
      (sum, product) =>
        sum + (product.price * product.quantity),
      0
    );

    const widgetPrice = readWidgetPrice(activeState);

    let total = widgetPrice.total;
    let savings = null;
    let discountLabelText = 'MBC';

    if (
      activeState.discountType === 'percentage' &&
      Number.isFinite(activeState.discountValue)
    ) {
      discountLabelText = `${activeState.discountValue}%`;

      if (subtotal > 0) {
        savings = Math.round(
          subtotal * activeState.discountValue / 100
        );

        if (!Number.isFinite(total)) {
          total = subtotal - savings;
        }
      }
    }

    if (
      activeState.discountType === 'amount' &&
      Number.isFinite(activeState.discountValue)
    ) {
      const amountOff = Math.round(
        activeState.discountValue > 1000
          ? activeState.discountValue
          : activeState.discountValue * 100
      );

      discountLabelText = `${formatMoney(amountOff)} off`;

      if (subtotal > 0) {
        savings = Math.min(subtotal, amountOff);

        if (!Number.isFinite(total)) {
          total = subtotal - savings;
        }
      }
    }

    if (
      activeState.discountType === 'sale_price' &&
      Number.isFinite(activeState.discountValue)
    ) {
      const salePrice = Math.round(
        activeState.discountValue > 1000
          ? activeState.discountValue
          : activeState.discountValue * 100
      );

      discountLabelText = 'Sale price';

      if (!Number.isFinite(total)) {
        total = salePrice;
      }

      if (subtotal > 0) {
        savings = Math.max(0, subtotal - total);
      }
    }

    if (
      Number.isFinite(widgetPrice.compareAt) &&
      Number.isFinite(widgetPrice.total)
    ) {
      savings =
        widgetPrice.compareAt - widgetPrice.total;

      if (!subtotal) {
        return {
          totalQty,
          subtotal: widgetPrice.compareAt,
          savings,
          total: widgetPrice.total,
          discountLabel: discountLabelText
        };
      }
    }

    if (
      savings == null &&
      subtotal > 0 &&
      Number.isFinite(total)
    ) {
      savings = Math.max(0, subtotal - total);
    }

    return {
      totalQty,
      subtotal:
        subtotal > 0
          ? subtotal
          : null,
      savings,
      total:
        Number.isFinite(total)
          ? total
          : null,
      discountLabel: discountLabelText
    };
  };

  const updateSummary = () => {
    const summary = getSummary();

    if (totalEl) totalEl.textContent = summary.totalQty;

    if (targetEl) {
      targetEl.textContent =
        activeState?.target > 0
          ? activeState.target
          : '—';
    }

    if (discountLabel) {
      discountLabel.textContent = summary.discountLabel;
    }

    if (subtotalEl) {
      subtotalEl.textContent =
        summary.subtotal != null
          ? formatMoney(summary.subtotal)
          : '—';
    }

    if (savingsEl) {
      savingsEl.textContent =
        summary.savings != null
          ? `-${formatMoney(summary.savings)}`
          : '—';
    }

    if (priceEl) {
      priceEl.textContent =
        summary.total != null
          ? formatMoney(summary.total)
          : 'Calculated by MBC';
    }

    const atc = activeState?.atc || null;

    if (addButton) {
      addButton.textContent = 'Add to cart';

      addButton.disabled =
        !activeState?.ready ||
        !atc ||
        atc.disabled ||
        (
          activeState.target > 0 &&
          summary.totalQty !== activeState.target
        );
    }

    if (statusEl) {
      if (!activeState?.ready) {
        statusEl.textContent = 'Loading bundle rules…';
        return;
      }

      if (activeState.target <= 0) {
        statusEl.textContent =
          'Bundle rules loaded. Choose your products.';
        return;
      }

      const remaining =
        activeState.target - summary.totalQty;

      if (remaining > 0) {
        statusEl.textContent =
          `Choose ${remaining} more ${remaining === 1 ? 'cowl' : 'cowls'}.`;
      } else if (remaining < 0) {
        statusEl.textContent =
          `Remove ${Math.abs(remaining)} ${Math.abs(remaining) === 1 ? 'cowl' : 'cowls'}.`;
      } else {
        statusEl.textContent =
          `${activeState.title} is ready to add.`;
      }
    }
  };

  const syncActiveState = () => {
    if (!activeState?.ready) return;

    activeState.products = buildProducts(activeState);

    const config = readBundleConfig(activeState);

    if (config.title) activeState.title = config.title;
    if (config.target > 0) activeState.target = config.target;

    if (config.discountType) {
      activeState.discountType = config.discountType;
      activeState.discountValue = config.discountValue;
    }

    activeState.atc =
      getRoot(activeState.widget)
        ?.querySelector('.mbc-bundle__button.mbc-bundle__atc') ||
      getRoot(activeState.widget)
        ?.querySelector('.mbc-bundle__atc') ||
      null;

    renderPicker();
    renderSelected();
    updateSummary();
  };

  const scheduleSync = () => {
    window.clearTimeout(syncTimer);

    syncTimer = window.setTimeout(() => {
      syncActiveState();
    }, 120);
  };

  const observeWidget = (state) => {
    const widgetRoot = getRoot(state.widget);
    if (!widgetRoot) return;

    const observer = new MutationObserver(scheduleSync);

    observer.observe(widgetRoot, {
      subtree: true,
      childList: true,
      characterData: true,
      attributes: true,
      attributeFilter: [
        'disabled',
        'value',
        'checked',
        'class'
      ]
    });

    state.observer = observer;
  };

  const hydrateState = async (plan) => {
    const id = String(plan.dataset.bundleId || '');
    const widget = getWidgetForId(id);

    if (!id || !widget) {
      throw new Error(`MBC bundle ${id || 'ID'} could not be loaded.`);
    }

    if (stateById.has(id)) {
      return stateById.get(id);
    }

    const state = {
      id,
      widget,
      ready: false,
      title: `Bundle ${id}`,
      target: 0,
      discountType: '',
      discountValue: null,
      products: [],
      atc: null,
      observer: null
    };

    stateById.set(id, state);

    const ready = await waitForWidgetReady(widget);

    if (!ready) {
      throw new Error(
        `MBC bundle ${id} did not finish loading. Check that the bundle is Active and the MBC app embed is enabled.`
      );
    }

    const config = readBundleConfig(state);

    state.title = config.title || state.title;
    state.target = Number(config.target || 0);
    state.discountType = config.discountType || '';
    state.discountValue = config.discountValue;
    state.products = buildProducts(state);
    state.atc =
      getRoot(widget)
        ?.querySelector('.mbc-bundle__button.mbc-bundle__atc') ||
      getRoot(widget)
        ?.querySelector('.mbc-bundle__atc') ||
      null;
    state.ready = true;

    observeWidget(state);

    return state;
  };

  const revealPlan = (plan, state) => {
    const label = plan.querySelector('[data-plan-label]');

    if (label) {
      label.textContent = state.title;
    }

    plan.classList.remove('is-loading');
  };

  const activatePlan = async (plan) => {
    if (!plan) return;

    plans.forEach((item) => {
      const active = item === plan;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    activePlan = plan;

    openPickerButtons.forEach((button) => {
      button.disabled = true;
    });

    if (statusEl) {
      statusEl.textContent = 'Loading bundle rules…';
    }

    if (errorEl) {
      errorEl.hidden = true;
      errorEl.textContent = '';
    }

    try {
      const state = await hydrateState(plan);

      activeState = state;

      revealPlan(plan, state);

      openPickerButtons.forEach((button) => {
        button.disabled = false;
      });

      syncActiveState();
    } catch (error) {
      if (errorEl) {
        errorEl.textContent =
          error.message ||
          'The MBC bundle could not be loaded.';
        errorEl.hidden = false;
      }

      plan.classList.remove('is-loading');

      const label = plan.querySelector('[data-plan-label]');
      if (label) {
        label.textContent =
          `Bundle ${plan.dataset.bundleId || ''}`;
      }

      if (addButton) addButton.disabled = true;
    }
  };

  plans.forEach((plan) => {
    plan.addEventListener('click', () => {
      activatePlan(plan);
    });
  });

  if (addButton) {
    addButton.addEventListener('click', async () => {
      if (!activeState?.ready || !activeState.atc) return;
      if (activeState.atc.disabled) return;

      addButton.disabled = true;
      addButton.textContent = 'Adding…';

      if (errorEl) {
        errorEl.hidden = true;
        errorEl.textContent = '';
      }

      const previousCartCount = async () => {
        try {
          const response = await fetch(
            `${window.Shopify?.routes?.root || '/'}cart.js`,
            { headers: { Accept: 'application/json' } }
          );

          const cart = await response.json();
          return Number(cart.item_count || 0);
        } catch (error) {
          return null;
        }
      };

      const before = await previousCartCount();

      try {
        activeState.atc.click();

        let added = false;

        for (let attempt = 0; attempt < 30; attempt += 1) {
          await wait(150);

          const after = await previousCartCount();

          if (
            before == null ||
            (
              after != null &&
              after > before
            )
          ) {
            added = true;
            break;
          }
        }

        if (
          window.MAKEBECOOL_BUNDLES &&
          typeof window.MAKEBECOOL_BUNDLES.updateCart === 'function'
        ) {
          try {
            await window.MAKEBECOOL_BUNDLES.updateCart();
          } catch (error) {}
        }

        if (!added && before != null) {
          throw new Error(
            'The bundle was not added to the cart. Please check the selected quantities.'
          );
        }

        window.location.assign('/cart');
      } catch (error) {
        if (errorEl) {
          errorEl.textContent =
            error.message ||
            'The bundle could not be added.';
          errorEl.hidden = false;
        }

        addButton.textContent = 'Add to cart';
        scheduleSync();
      }
    });
  }

  const hydratePlanLabels = async () => {
    for (const plan of plans) {
      try {
        const state = await hydrateState(plan);
        revealPlan(plan, state);
      } catch (error) {
        plan.classList.remove('is-loading');

        const label = plan.querySelector('[data-plan-label]');
        if (label) {
          label.textContent =
            `Bundle ${plan.dataset.bundleId || ''}`;
        }
      }
    }

    const firstReady =
      plans.find((plan) => {
        const state =
          stateById.get(String(plan.dataset.bundleId || ''));

        return state?.ready;
      }) || plans[0];

    if (firstReady) {
      activatePlan(firstReady);
    }
  };

  hydratePlanLabels();
})();
</script>

