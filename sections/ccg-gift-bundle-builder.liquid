{%- liquid
  assign mbc_bundle_id = section.settings.mbc_bundle_id | strip
-%}

<section
  id="CCGGiftBuilder-{{ section.id }}"
  class="ccg-gift-builder"
  style="
    --builder-bg: {{ section.settings.background_color }};
    --builder-ink: {{ section.settings.text_color }};
    --builder-accent: {{ section.settings.accent_color }};
  "
>
  <div class="ccg-gift-builder__inner">
    <div class="ccg-gift-builder__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ccg-gift-builder__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ccg-gift-builder__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="ccg-gift-builder__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    {%- if mbc_bundle_id != blank -%}
      <div class="ccg-gift-builder__widget-wrap" data-mbc-host>
        <mbc-bundles-widget data-bundle-id="{{ mbc_bundle_id | escape }}"></mbc-bundles-widget>
      </div>
    {%- else -%}
      <p class="ccg-gift-builder__notice">
        Add the MBC bundle ID in this section's settings.
      </p>
    {%- endif -%}
  </div>
</section>

<script>
(() => {
  const sectionId = 'CCGGiftBuilder-{{ section.id }}';

  const bootMBC = async () => {
    const section = document.getElementById(sectionId);
    if (!section) return;

    const widget = section.querySelector('mbc-bundles-widget');
    if (!widget) return;

    let tries = 0;

    const waitForMBC = async () => {
      tries += 1;

      const mbc = window.MAKEBECOOL_BUNDLES;

      if (!mbc) {
        if (tries < 60) {
          window.setTimeout(waitForMBC, 250);
        }
        return;
      }

      try {
        if (typeof mbc.loadWidgetScript === 'function') {
          await mbc.loadWidgetScript();
        }
      } catch (e) {
        console.warn('MBC loadWidgetScript error:', e);
      }

      try {
        /*
         * This page is not necessarily a product page.
         * MBC documents initWidgetOnCollectionPage() for storefront
         * placements outside the normal product-page flow.
         */
        if (typeof mbc.initWidgetOnCollectionPage === 'function') {
          await mbc.initWidgetOnCollectionPage();
        }
      } catch (e) {
        console.warn('MBC initWidgetOnCollectionPage error:', e);
      }

      /*
       * Fallback for themes/app versions where the widget initializer
       * is handled by initWidget().
       */
      try {
        if (
          !widget.children.length &&
          typeof mbc.initWidget === 'function'
        ) {
          await mbc.initWidget();
        }
      } catch (e) {
        console.warn('MBC initWidget fallback error:', e);
      }

      /*
       * MBC is the source of truth for products, quantities,
       * discounts, totals and checkout pricing.
       * Theme JS never calculates any price.
       */
      const normalizeButtonText = () => {
        const roots = [widget];

        if (widget.shadowRoot) {
          roots.push(widget.shadowRoot);
        }

        roots.forEach((root) => {
          if (!root?.querySelectorAll) return;

          root.querySelectorAll('button, input[type="submit"], [role="button"]').forEach((el) => {
            const text = (
              el.tagName === 'INPUT'
                ? el.value
                : el.textContent
            )?.replace(/\s+/g, ' ').trim() || '';

            if (/^add(?:\s+.+)?\s+to\s+cart$/i.test(text)) {
              if (el.tagName === 'INPUT') {
                el.value = 'Add to cart';
              } else {
                el.textContent = 'Add to cart';
              }
            }
          });
        });
      };

      normalizeButtonText();

      const observer = new MutationObserver(normalizeButtonText);

      try {
        observer.observe(widget, {
          childList: true,
          subtree: true,
          characterData: true
        });
      } catch (e) {}

      if (widget.shadowRoot) {
        try {
          observer.observe(widget.shadowRoot, {
            childList: true,
            subtree: true,
            characterData: true
          });
        } catch (e) {}
      }

      document.addEventListener('MAKEBECOOL_BUNDLES.updateCart', normalizeButtonText);
      document.addEventListener('MAKEBECOOL_BUNDLES.pricingCalculated', normalizeButtonText);
    };

    waitForMBC();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootMBC, { once: true });
  } else {
    bootMBC();
  }

  /*
   * Shopify theme editor can replace a section without a full page reload.
   * Re-run MBC when this section is reloaded in the editor.
   */
  document.addEventListener('shopify:section:load', (event) => {
    if (event.target?.id === sectionId) {
      bootMBC();
    }
  });
})();
</script>

{% stylesheet %}
  .ccg-gift-builder {
    width: 100%;
    padding: 64px 32px 96px;
    background: var(--builder-bg);
    color: var(--builder-ink);
  }

  .ccg-gift-builder__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .ccg-gift-builder__intro {
    max-width: 900px;
    margin: 0 auto 34px;
    text-align: center;
  }

  .ccg-gift-builder__eyebrow {
    margin: 0 0 14px;
    color: var(--builder-accent);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .ccg-gift-builder__heading {
    margin: 0 0 18px;
    color: var(--builder-ink);
    font-family: 'Rye', serif;
    font-size: clamp(34px, 5vw, 58px);
    font-weight: 400;
    line-height: 1.08;
    text-wrap: balance;
  }

  .ccg-gift-builder__description {
    max-width: 760px;
    margin: 0 auto;
    color: var(--builder-ink);
    font-size: 15px;
    line-height: 1.65;
  }

  .ccg-gift-builder__description p {
    margin: 0;
  }

  .ccg-gift-builder__widget-wrap {
    width: 100%;
    min-height: 1px;
    margin-top: 18px;
  }

  .ccg-gift-builder__widget-wrap mbc-bundles-widget {
    display: block;
    width: 100%;
  }

  .ccg-gift-builder__notice {
    max-width: 760px;
    margin: 30px auto 0;
    padding: 18px 20px;
    border: 1px solid rgba(33, 28, 23, .18);
    background: #fbf9f4;
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    .ccg-gift-builder {
      padding-inline: 22px;
    }
  }

  @media screen and (max-width: 749px) {
    .ccg-gift-builder {
      padding: 42px 16px 64px;
    }

    .ccg-gift-builder__heading {
      font-size: clamp(30px, 11vw, 44px);
    }

    .ccg-gift-builder__description {
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift bundle builder",
  "settings": [
    {
      "type": "text",
      "id": "mbc_bundle_id",
      "label": "MBC Bundle ID",
      "default": "128498",
      "info": "MBC controls the bundle products, quantities, discount, total and checkout pricing dynamically."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Mix, match & save"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your crew gift bundle"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Choose different cowl patterns and set the quantity for each.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f8f5ee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#211c17"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#b18461"
    }
  ],
  "presets": [
    {
      "name": "Gift bundle builder"
    }
  ]
}
{% endschema %}
