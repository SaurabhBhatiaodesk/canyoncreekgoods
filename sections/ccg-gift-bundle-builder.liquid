{%- liquid
  assign bundle_collection = section.settings.collection
  assign products_limit = section.settings.products_limit
-%}

<section
  id="CCGGiftBuilder-{{ section.id }}"
  class="ccg-gift-builder"
  data-gift-builder
  data-money-format="{{ shop.money_format | escape }}"
  style="--builder-bg: {{ section.settings.background_color }}; --builder-ink: {{ section.settings.text_color }}; --builder-accent: {{ section.settings.accent_color }};"
>
  <div class="ccg-gift-builder__inner">
    <div class="ccg-gift-builder__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ccg-gift-builder__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ccg-gift-builder__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="ccg-gift-builder__description rte">{{ section.settings.description }}</div>
      {%- endif -%}

      <p class="ccg-gift-builder__minimum">At least 10 items should be selected</p>
    </div>

    <div class="ccg-gift-builder__offers" aria-label="Bundle discounts">
      <span>Gift 10 = 10% off</span>
      <span>Gift 20 = 15% off</span>
    </div>

    <div class="ccg-gift-builder__plans" role="group" aria-label="Choose bundle size">
      <button
        class="ccg-gift-builder__plan is-active"
        type="button"
        data-plan
        data-target="10"
        data-discount="10"
        data-bundle-id="{{ section.settings.gift_10_bundle_id | escape }}"
        aria-pressed="true"
      >
        Gift 10
      </button>
      <button
        class="ccg-gift-builder__plan"
        type="button"
        data-plan
        data-target="20"
        data-discount="15"
        data-bundle-id="{{ section.settings.gift_20_bundle_id | escape }}"
        aria-pressed="false"
      >
        Gift 20
      </button>
    </div>

    {%- if bundle_collection != blank and bundle_collection.products_count > 0 -%}
      <div class="ccg-gift-builder__status" aria-live="polite">
        <span>Selected: <strong data-total>0</strong> of <strong data-target-count>10</strong></span>
        <span data-status>Select 10 cowls to continue.</span>
      </div>

      <div class="ccg-gift-builder__selected" data-selected-products>
        <button class="ccg-gift-builder__empty-add" type="button" data-open-picker>
          <span class="ccg-gift-builder__empty-plus">+</span>
          <span>Add product</span>
        </button>
      </div>

      <button class="ccg-gift-builder__choose" type="button" data-open-picker>
        Choose a product
      </button>

      <div class="ccg-gift-builder__summary">
        <div>
          <span>Bundle subtotal</span>
          <strong data-subtotal>{{ 0 | money }}</strong>
        </div>
        <div>
          <span>Bundle discount (<span data-discount-label>10</span>%)</span>
          <strong data-savings>-{{ 0 | money }}</strong>
        </div>
        <div class="ccg-gift-builder__total-row">
          <span>Bundle total</span>
          <strong data-price>{{ 0 | money }}</strong>
        </div>
        <button class="ccg-gift-builder__add" type="button" data-add disabled>Add Gift 10 to cart</button>
        <p class="ccg-gift-builder__error" data-error role="alert" hidden></p>
      </div>

      <div class="ccg-gift-builder__modal" data-picker hidden>
        <div class="ccg-gift-builder__modal-backdrop" data-close-picker></div>
        <div class="ccg-gift-builder__modal-dialog" role="dialog" aria-modal="true" aria-label="Choose products">
          <div class="ccg-gift-builder__modal-header">
            <div>
              <p class="ccg-gift-builder__eyebrow">Choose products</p>
              <h3>Add cowls to your bundle</h3>
            </div>
            <button class="ccg-gift-builder__modal-close" type="button" data-close-picker aria-label="Close product picker">×</button>
          </div>

          <div class="ccg-gift-builder__picker-grid">
            {%- for product in bundle_collection.products limit: products_limit -%}
              {%- assign variant = product.selected_or_first_available_variant -%}
              {%- if variant != blank -%}
                {%- liquid
                  assign max_quantity = 20
                  if variant.inventory_management != blank and variant.inventory_policy == 'deny'
                    assign max_quantity = variant.inventory_quantity | at_least: 0 | at_most: 20
                  endif
                -%}

                <button
                  class="ccg-gift-builder__picker-product{% unless variant.available and max_quantity > 0 %} is-unavailable{% endunless %}"
                  type="button"
                  data-picker-product
                  data-variant-id="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  data-max="{{ max_quantity }}"
                  data-title="{{ product.title | escape }}"
                  data-image="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 700 }}{% endif %}"
                  {% unless variant.available and max_quantity > 0 %}disabled{% endunless %}
                >
                  <span class="ccg-gift-builder__picker-media">
                    {%- if product.featured_image != blank -%}
                      {%- assign image_alt = product.featured_image.alt | default: product.title -%}
                      {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '180,260,360,500', sizes: '(max-width: 749px) 45vw, 180px', alt: image_alt }}
                    {%- endif -%}
                  </span>
                  <span class="ccg-gift-builder__picker-copy">
                    <strong>{{ product.title | escape }}</strong>
                    <span>{{ variant.price | money }}</span>
                    <em>{% if variant.available and max_quantity > 0 %}+ Add product{% else %}Sold out{% endif %}</em>
                  </span>
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

    {%- else -%}
      <p>Select a collection in this section's theme settings.</p>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('CCGGiftBuilder-{{ section.id }}');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const moneyFormat = root.dataset.moneyFormat || '${{amount}}';
    const plans = [...root.querySelectorAll('[data-plan]')];
    const pickerProducts = [...root.querySelectorAll('[data-picker-product]')];
    const selectedWrap = root.querySelector('[data-selected-products]');
    const picker = root.querySelector('[data-picker]');
    const totalEl = root.querySelector('[data-total]');
    const targetEl = root.querySelector('[data-target-count]');
    const statusEl = root.querySelector('[data-status]');
    const subtotalEl = root.querySelector('[data-subtotal]');
    const savingsEl = root.querySelector('[data-savings]');
    const priceEl = root.querySelector('[data-price]');
    const discountLabel = root.querySelector('[data-discount-label]');
    const addButton = root.querySelector('[data-add]');
    const chooseButton = root.querySelector('.ccg-gift-builder__choose');
    const errorEl = root.querySelector('[data-error]');

    let target = 10;
    let discount = 10;
    let bundleId = plans[0] ? plans[0].dataset.bundleId : '';
    const selected = new Map();

    const formatMoney = (cents) => {
      const amount = (cents / 100).toFixed(2);
      return moneyFormat.replace(/\{\{\s*amount(?:_with_comma_separator)?\s*\}\}/, amount);
    };

    const getItems = () => [...selected.values()]
      .filter((item) => item.quantity > 0)
      .map((item) => ({
        id: item.id,
        price: item.price,
        quantity: item.quantity
      }));

    const renderSelected = () => {
      selectedWrap.innerHTML = '';

      if (selected.size === 0) {
        selectedWrap.innerHTML = `
          <button class="ccg-gift-builder__empty-add" type="button" data-open-picker>
            <span class="ccg-gift-builder__empty-plus">+</span>
            <span>Add product</span>
          </button>
        `;
        return;
      }

      selected.forEach((item) => {
        const card = document.createElement('article');
        card.className = 'ccg-gift-builder__selected-product';
        card.dataset.selectedId = String(item.id);
        card.innerHTML = `
          <button class="ccg-gift-builder__remove" type="button" data-remove-product="${item.id}">remove product</button>
          <div class="ccg-gift-builder__selected-media">
            ${item.image ? `<img src="${item.image}" alt="${item.safeTitle}" loading="lazy">` : ''}
          </div>
          <div class="ccg-gift-builder__selected-copy">
            <h3>${item.safeTitle}</h3>
            <p>${formatMoney(item.price)}</p>
            <div class="ccg-gift-builder__quantity" aria-label="Quantity for ${item.safeTitle}">
              <button type="button" data-selected-minus="${item.id}" aria-label="Decrease quantity">−</button>
              <input type="number" value="${item.quantity}" min="1" max="${Math.min(item.max, target)}" inputmode="numeric" data-selected-quantity="${item.id}" aria-label="Quantity">
              <button type="button" data-selected-plus="${item.id}" aria-label="Increase quantity">+</button>
            </div>
          </div>
        `;
        selectedWrap.appendChild(card);
      });

      const addMore = document.createElement('button');
      addMore.className = 'ccg-gift-builder__add-more';
      addMore.type = 'button';
      addMore.dataset.openPicker = '';
      addMore.innerHTML = '<span>+</span> add product';
      selectedWrap.appendChild(addMore);
    };

    const updatePickerState = () => {
      pickerProducts.forEach((button) => {
        const id = Number(button.dataset.variantId);
        button.classList.toggle('is-selected', selected.has(id));
      });
    };

    const update = () => {
      const items = getItems();
      const total = items.reduce((sum, item) => sum + item.quantity, 0);
      const subtotal = items.reduce((sum, item) => sum + item.price * item.quantity, 0);
      const savings = Math.round(subtotal * discount / 100);
      const remaining = target - total;

      totalEl.textContent = total;
      targetEl.textContent = target;
      discountLabel.textContent = discount;
      subtotalEl.textContent = formatMoney(subtotal);
      savingsEl.textContent = `-${formatMoney(savings)}`;
      priceEl.textContent = formatMoney(subtotal - savings);
      addButton.disabled = total !== target;
      addButton.textContent = `Add Gift ${target} to cart`;

      if (remaining > 0) statusEl.textContent = `Choose ${remaining} more ${remaining === 1 ? 'cowl' : 'cowls'}.`;
      else if (remaining < 0) statusEl.textContent = `Remove ${Math.abs(remaining)} ${remaining === -1 ? 'cowl' : 'cowls'}.`;
      else statusEl.textContent = `Gift ${target} is ready to add.`;

      chooseButton.textContent = selected.size ? 'Choose another product' : 'Choose a product';
      updatePickerState();
    };

    const openPicker = () => {
      picker.hidden = false;
      document.documentElement.classList.add('ccg-gift-builder-picker-open');
    };

    const closePicker = () => {
      picker.hidden = true;
      document.documentElement.classList.remove('ccg-gift-builder-picker-open');
    };

    root.addEventListener('click', (event) => {
      const openButton = event.target.closest('[data-open-picker]');
      if (openButton) {
        openPicker();
        return;
      }

      const closeButton = event.target.closest('[data-close-picker]');
      if (closeButton) {
        closePicker();
        return;
      }

      const pickerProduct = event.target.closest('[data-picker-product]');
      if (pickerProduct && !pickerProduct.disabled) {
        const id = Number(pickerProduct.dataset.variantId);
        if (!selected.has(id)) {
          const title = pickerProduct.dataset.title || 'Cowl';
          const temp = document.createElement('div');
          temp.textContent = title;

          selected.set(id, {
            id,
            price: Number(pickerProduct.dataset.price),
            max: Number(pickerProduct.dataset.max) || 20,
            title,
            safeTitle: temp.innerHTML,
            image: pickerProduct.dataset.image || '',
            quantity: 1
          });
        }
        renderSelected();
        update();
        closePicker();
        return;
      }

      const removeButton = event.target.closest('[data-remove-product]');
      if (removeButton) {
        selected.delete(Number(removeButton.dataset.removeProduct));
        renderSelected();
        update();
        return;
      }

      const minusButton = event.target.closest('[data-selected-minus]');
      if (minusButton) {
        const id = Number(minusButton.dataset.selectedMinus);
        const item = selected.get(id);
        if (!item) return;
        item.quantity = Math.max(1, item.quantity - 1);
        renderSelected();
        update();
        return;
      }

      const plusButton = event.target.closest('[data-selected-plus]');
      if (plusButton) {
        const id = Number(plusButton.dataset.selectedPlus);
        const item = selected.get(id);
        if (!item) return;
        item.quantity = Math.min(item.max, target, item.quantity + 1);
        renderSelected();
        update();
      }
    });

    root.addEventListener('input', (event) => {
      const input = event.target.closest('[data-selected-quantity]');
      if (!input) return;

      const id = Number(input.dataset.selectedQuantity);
      const item = selected.get(id);
      if (!item) return;

      const next = Number(input.value) || 1;
      item.quantity = Math.max(1, Math.min(item.max, target, next));
      input.value = item.quantity;
      update();
    });

    plans.forEach((plan) => plan.addEventListener('click', () => {
      target = Number(plan.dataset.target);
      discount = Number(plan.dataset.discount);
      bundleId = plan.dataset.bundleId;

      plans.forEach((item) => {
        const active = item === plan;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      selected.forEach((item) => {
        if (item.quantity > target) item.quantity = target;
      });

      renderSelected();
      update();
    }));

    addButton.addEventListener('click', async () => {
      const items = getItems();
      const total = items.reduce((sum, item) => sum + item.quantity, 0);
      if (total !== target) return update();

      addButton.disabled = true;
      addButton.textContent = 'Adding bundle…';
      errorEl.hidden = true;

      const bundleKey = `ccg-gift-${target}-${Date.now()}`;
      if (!bundleId) {
        errorEl.textContent = `Gift ${target} is missing its MBC bundle ID.`;
        errorEl.hidden = false;
        addButton.disabled = false;
        return;
      }

      try {
        const response = await fetch(`${window.Shopify?.routes?.root || '/'}cart/add.js?mbcb-request`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            items: items.map((item) => ({
              id: item.id,
              quantity: item.quantity,
              properties: {
                '_mbc_part': String(bundleId),
                '_CCG Bundle Key': bundleKey,
                'Bundle': `Gift ${target}`
              }
            }))
          })
        });

        const result = await response.json();
        if (!response.ok) throw new Error(result.description || result.message || 'The bundle could not be added.');

        for (let attempt = 0; attempt < 20; attempt += 1) {
          if (window.MAKEBECOOL_BUNDLES && typeof window.MAKEBECOOL_BUNDLES.updateCart === 'function') {
            await window.MAKEBECOOL_BUNDLES.updateCart();
            break;
          }
          await new Promise((resolve) => window.setTimeout(resolve, 100));
        }

        window.location.assign('/cart');
      } catch (error) {
        errorEl.textContent = error.message || 'The bundle could not be added. Please check the selected quantities.';
        errorEl.hidden = false;
        addButton.disabled = false;
        addButton.textContent = `Add Gift ${target} to cart`;
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !picker.hidden) closePicker();
    });

    renderSelected();
    update();
  })();
</script>

{% stylesheet %}
  .ccg-gift-builder {
    background: var(--builder-bg);
    color: var(--builder-ink);
    padding: 72px 32px 96px;
  }

  .ccg-gift-builder__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .ccg-gift-builder__intro {
    max-width: 760px;
    margin: 0 auto 18px;
    text-align: center;
  }

  .ccg-gift-builder__eyebrow {
    margin: 0 0 10px;
    color: var(--builder-accent);
    font: 400 14px/1.2 'Barlow Condensed', sans-serif;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .ccg-gift-builder__heading {
    margin: 0 0 8px;
    font-family: 'Rye', serif;
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 400;
    line-height: 1.15;
  }

  .ccg-gift-builder__description {
    line-height: 1.6;
  }

  .ccg-gift-builder__description p {
    margin: 0;
  }

  .ccg-gift-builder__minimum {
    margin: 6px 0 0;
    font-size: 12px;
    opacity: .72;
  }

  .ccg-gift-builder__offers {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin: 20px 0 14px;
    font-size: 13px;
  }

  .ccg-gift-builder__plans {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 26px;
  }

  .ccg-gift-builder__plan {
    min-width: 110px;
    padding: 9px 16px;
    border: 1px solid rgba(33,28,23,.2);
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: 600 12px/1.2 'Barlow Condensed', sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .ccg-gift-builder__plan.is-active {
    border-color: var(--builder-accent);
    background: rgba(185,138,82,.10);
  }

  .ccg-gift-builder__status {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    max-width: 1180px;
    margin: 0 auto 18px;
    padding: 12px 16px;
    border: 1px solid rgba(33,28,23,.12);
    background: rgba(255,255,255,.34);
    font-size: 13px;
  }

  .ccg-gift-builder__selected {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 22px;
    max-width: 1180px;
    margin: 0 auto 22px;
    align-items: start;
  }

  .ccg-gift-builder__empty-add,
  .ccg-gift-builder__add-more {
    min-height: 120px;
    border: 1px dashed rgba(33,28,23,.32);
    background: rgba(255,255,255,.28);
    color: inherit;
    cursor: pointer;
    font: 500 12px/1.2 'Barlow Condensed', sans-serif;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .ccg-gift-builder__empty-add {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 8px;
    aspect-ratio: 4 / 5;
  }

  .ccg-gift-builder__empty-plus {
    font-size: 20px;
    line-height: 1;
  }

  .ccg-gift-builder__selected-product {
    position: relative;
    min-width: 0;
  }

  .ccg-gift-builder__remove {
    display: block;
    margin: 0 auto 8px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-size: 10px;
    text-decoration: underline;
    text-underline-offset: 2px;
    opacity: .7;
  }

  .ccg-gift-builder__selected-media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #ede7dc;
  }

  .ccg-gift-builder__selected-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ccg-gift-builder__selected-copy {
    padding-top: 10px;
    text-align: center;
  }

  .ccg-gift-builder__selected-copy h3 {
    min-height: 2.8em;
    margin: 0 0 4px;
    font-size: 12px;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .ccg-gift-builder__selected-copy p {
    margin: 0 0 9px;
    font-size: 12px;
  }

  .ccg-gift-builder__quantity {
    display: grid;
    grid-template-columns: 34px 42px 34px;
    justify-content: center;
    width: fit-content;
    margin: 0 auto;
    border: 1px solid rgba(33,28,23,.18);
  }

  .ccg-gift-builder__quantity button,
  .ccg-gift-builder__quantity input {
    min-height: 32px;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: center;
    font: inherit;
  }

  .ccg-gift-builder__quantity button {
    cursor: pointer;
    font-size: 16px;
  }

  .ccg-gift-builder__quantity input {
    width: 42px;
    border-inline: 1px solid rgba(33,28,23,.18);
    appearance: textfield;
  }

  .ccg-gift-builder__quantity input::-webkit-inner-spin-button {
    appearance: none;
  }

  .ccg-gift-builder__add-more {
    min-height: 44px;
    align-self: end;
  }

  .ccg-gift-builder__choose {
    display: block;
    width: min(1180px, 100%);
    min-height: 46px;
    margin: 0 auto;
    border: 0;
    background: var(--builder-accent);
    color: #fff;
    cursor: pointer;
    font: 600 12px/1.2 'Barlow Condensed', sans-serif;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .ccg-gift-builder__summary {
    max-width: 620px;
    margin: 36px auto 0;
    padding-top: 22px;
    border-top: 1px solid rgba(33,28,23,.18);
  }

  .ccg-gift-builder__summary > div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 10px;
  }

  .ccg-gift-builder__total-row {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(33,28,23,.18);
    font-size: 20px;
  }

  .ccg-gift-builder__add {
    width: 100%;
    min-height: 54px;
    margin-top: 14px;
    border: 0;
    background: var(--builder-accent);
    color: #fff;
    cursor: pointer;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .ccg-gift-builder__add:disabled {
    opacity: .45;
    cursor: not-allowed;
  }

  .ccg-gift-builder__error {
    margin: 12px 0 0;
    color: #b42318;
  }

  .ccg-gift-builder__modal[hidden] {
    display: none;
  }

  .ccg-gift-builder__modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
  }

  .ccg-gift-builder__modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20,17,14,.55);
  }

  .ccg-gift-builder__modal-dialog {
    position: absolute;
    inset: 5vh 4vw;
    max-width: 1180px;
    margin: auto;
    overflow: auto;
    padding: 28px;
    background: var(--builder-bg);
    box-shadow: 0 24px 70px rgba(0,0,0,.22);
  }

  .ccg-gift-builder__modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }

  .ccg-gift-builder__modal-header h3 {
    margin: 0;
    font-family: 'Rye', serif;
    font-size: 28px;
    font-weight: 400;
  }

  .ccg-gift-builder__modal-close {
    width: 42px;
    height: 42px;
    border: 1px solid rgba(33,28,23,.2);
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-size: 28px;
    line-height: 1;
  }

  .ccg-gift-builder__picker-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .ccg-gift-builder__picker-product {
    display: block;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(33,28,23,.16);
    background: #fbf9f4;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .ccg-gift-builder__picker-product.is-selected {
    border-color: var(--builder-accent);
    box-shadow: inset 0 0 0 1px var(--builder-accent);
  }

  .ccg-gift-builder__picker-product.is-unavailable {
    cursor: not-allowed;
    opacity: .45;
  }

  .ccg-gift-builder__picker-media {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #ede7dc;
  }

  .ccg-gift-builder__picker-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ccg-gift-builder__picker-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
  }

  .ccg-gift-builder__picker-copy strong {
    font-size: 12px;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ccg-gift-builder__picker-copy span {
    font-size: 12px;
  }

  .ccg-gift-builder__picker-copy em {
    margin-top: 4px;
    color: var(--builder-accent);
    font: 600 11px/1.2 'Barlow Condensed', sans-serif;
    font-style: normal;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .ccg-gift-builder-picker-open {
    overflow: hidden;
  }

  @media screen and (max-width: 989px) {
    .ccg-gift-builder__selected {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .ccg-gift-builder__picker-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .ccg-gift-builder {
      padding: 44px 16px 64px;
    }

    .ccg-gift-builder__status {
      align-items: flex-start;
      flex-direction: column;
    }

    .ccg-gift-builder__selected,
    .ccg-gift-builder__picker-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .ccg-gift-builder__plans {
      flex-wrap: wrap;
    }

    .ccg-gift-builder__modal-dialog {
      inset: 2vh 10px;
      padding: 18px;
    }

    .ccg-gift-builder__modal-header h3 {
      font-size: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift bundle builder",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Cowl collection" },
    { "type": "text", "id": "gift_10_bundle_id", "label": "Gift 10 MBC bundle ID", "default": "127991" },
    { "type": "text", "id": "gift_20_bundle_id", "label": "Gift 20 MBC bundle ID", "default": "127993" },
    { "type": "range", "id": "products_limit", "min": 4, "max": 40, "step": 1, "label": "Products shown", "default": 24 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mix, match & save" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10, 20 or for the whole dang crew, plus a few extras." },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Choose different cowl patterns and set the quantity for each.</p>" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f8f5ee" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#211c17" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#a77b58" }
  ],
  "presets": [{ "name": "Gift bundle builder" }]
}
{% endschema %}
