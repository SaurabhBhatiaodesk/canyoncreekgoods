{%- liquid
  assign mbc_bundle_id = section.settings.mbc_bundle_id | strip
-%}

<section
  id="CCGGiftBuilder-{{ section.id }}"
  class="ccg-gift-builder"
  data-ccg-gift-builder
  style="
    --builder-bg: {{ section.settings.background_color }};
    --builder-ink: {{ section.settings.text_color }};
    --builder-accent: {{ section.settings.accent_color }};
  "
>
  <div class="ccg-gift-builder__inner">

    <div class="ccg-gift-builder__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ccg-gift-builder__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ccg-gift-builder__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="ccg-gift-builder__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    {%- if mbc_bundle_id != blank -%}
      <div class="ccg-gift-builder__app">
        <mbc-bundles-widget
          data-bundle-id="{{ mbc_bundle_id | escape }}"
        ></mbc-bundles-widget>
      </div>
    {%- else -%}
      <div class="ccg-gift-builder__notice">
        Add an MBC Bundle ID in this section's settings.
      </div>
    {%- endif -%}

  </div>
</section>

<script>
(() => {
  const section = document.getElementById('CCGGiftBuilder-{{ section.id }}');
  if (!section || section.dataset.ready === 'true') return;

  section.dataset.ready = 'true';

  const widget = section.querySelector('mbc-bundles-widget');
  if (!widget) return;

  /*
   * IMPORTANT
   * ----------
   * The theme does NOT calculate:
   * - discount
   * - subtotal
   * - bundle total
   * - required quantity
   * - bundle products
   *
   * MBC Bundles is the single source of truth.
   * This keeps storefront pricing aligned with cart + checkout.
   */

  const changeAddToCartText = (root) => {
    if (!root || !root.querySelectorAll) return;

    root
      .querySelectorAll('button, input[type="submit"], [role="button"]')
      .forEach((el) => {
        const text = (
          el.tagName === 'INPUT'
            ? el.value
            : el.textContent
        )?.replace(/\s+/g, ' ').trim() || '';

        if (
          /^add(?:\s+.+)?\s+to\s+cart$/i.test(text) ||
          /^add to cart$/i.test(text)
        ) {
          if (el.tagName === 'INPUT') {
            el.value = 'Add to cart';
          } else {
            el.textContent = 'Add to cart';
          }
        }
      });
  };

  const scan = () => {
    changeAddToCartText(widget);

    if (widget.shadowRoot) {
      changeAddToCartText(widget.shadowRoot);
    }
  };

  const observe = (root) => {
    if (!root) return;

    const observer = new MutationObserver(() => {
      scan();
    });

    try {
      observer.observe(root, {
        subtree: true,
        childList: true,
        characterData: true
      });
    } catch (e) {}
  };

  observe(widget);
  scan();

  let attempts = 0;

  const waitForMBC = setInterval(async () => {
    attempts += 1;

    const mbc = window.MAKEBECOOL_BUNDLES;

    if (mbc) {
      try {
        if (typeof mbc.loadWidgetScript === 'function') {
          await mbc.loadWidgetScript();
        }
      } catch (e) {}

      scan();

      if (widget.shadowRoot) {
        observe(widget.shadowRoot);
      }

      clearInterval(waitForMBC);
    }

    if (attempts >= 40) {
      clearInterval(waitForMBC);
    }
  }, 250);

  /*
   * When MBC recalculates pricing or cart discounts,
   * rescan only for presentation text.
   * We never overwrite the actual prices.
   */
  document.addEventListener('MAKEBECOOL_BUNDLES.pricingCalculated', scan);
  document.addEventListener('MAKEBECOOL_BUNDLES.updateCart', scan);
})();
</script>

{% stylesheet %}
  .ccg-gift-builder {
    width: 100%;
    padding: 64px 32px 96px;
    background: var(--builder-bg);
    color: var(--builder-ink);
  }

  .ccg-gift-builder__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .ccg-gift-builder__intro {
    max-width: 900px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .ccg-gift-builder__eyebrow {
    margin: 0 0 14px;
    color: var(--builder-accent);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .ccg-gift-builder__heading {
    margin: 0 0 18px;
    color: var(--builder-ink);
    font-family: 'Rye', serif;
    font-size: clamp(34px, 5vw, 58px);
    font-weight: 400;
    line-height: 1.08;
    text-wrap: balance;
  }

  .ccg-gift-builder__description {
    max-width: 760px;
    margin: 0 auto;
    color: var(--builder-ink);
    font-size: 15px;
    line-height: 1.65;
  }

  .ccg-gift-builder__description p {
    margin: 0;
  }

  .ccg-gift-builder__app {
    width: 100%;
    margin-top: 24px;
  }

  .ccg-gift-builder__app mbc-bundles-widget {
    display: block;
    width: 100%;
  }

  .ccg-gift-builder__notice {
    max-width: 760px;
    margin: 30px auto 0;
    padding: 18px 20px;
    border: 1px solid rgba(33, 28, 23, .18);
    background: #fbf9f4;
    text-align: center;
  }

  /*
   * Keep the same warm / minimal page feel.
   * Actual MBC widget internals remain controlled by MBC,
   * so product/discount/price/cart behavior stays dynamic.
   */
  .ccg-gift-builder__app {
    --ccg-border: rgba(33, 28, 23, .18);
    --ccg-card: #fbf9f4;
  }

  @media screen and (max-width: 989px) {
    .ccg-gift-builder {
      padding-inline: 22px;
    }
  }

  @media screen and (max-width: 749px) {
    .ccg-gift-builder {
      padding: 42px 16px 64px;
    }

    .ccg-gift-builder__intro {
      margin-bottom: 28px;
    }

    .ccg-gift-builder__heading {
      font-size: clamp(30px, 11vw, 44px);
    }

    .ccg-gift-builder__description {
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift bundle builder",
  "settings": [
    {
      "type": "text",
      "id": "mbc_bundle_id",
      "label": "MBC Bundle ID",
      "default": "128498",
      "info": "MBC dynamically controls products, quantity rules, discounts, totals, cart and checkout pricing."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Mix, match & save"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your crew gift bundle"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Choose your favorite cowl patterns and quantities to build your bundle.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f8f5ee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#211c17"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#b18461"
    }
  ],
  "presets": [
    {
      "name": "Gift bundle builder"
    }
  ]
}
{% endschema %}
