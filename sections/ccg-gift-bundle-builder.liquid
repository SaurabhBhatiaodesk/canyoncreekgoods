    .ccg-gift-builder__product-card {
      width: calc(50% - 6px);
      min-height: 220px;
    }

    .ccg-gift-builder__picker-panel {
      inset: 2vh 12px;
      padding: 16px;
    }

    .ccg-gift-builder__picker-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }
{% endstylesheet %}

