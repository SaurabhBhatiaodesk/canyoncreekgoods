{%- liquid
  assign bundle_collection = section.settings.collection
  assign products_limit = section.settings.products_limit
-%}

<section
  id="CCGGiftBuilder-{{ section.id }}"
  class="ccg-gift-builder"
  data-gift-builder
  data-money-format="{{ shop.money_format | escape }}"
  style="--builder-bg: {{ section.settings.background_color }}; --builder-ink: {{ section.settings.text_color }}; --builder-accent: {{ section.settings.accent_color }};"
>
  <div class="ccg-gift-builder__inner">
    <div class="ccg-gift-builder__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ccg-gift-builder__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ccg-gift-builder__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="ccg-gift-builder__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="ccg-gift-builder__plans" role="group" aria-label="Choose bundle size">
      <button class="ccg-gift-builder__plan is-active" type="button" data-plan data-target="10" data-discount="10" data-bundle-id="{{ section.settings.gift_10_bundle_id | escape }}" aria-pressed="true">
        <strong>Gift 10</strong>
        <span>10 cowls / 10% off</span>
      </button>
      <button class="ccg-gift-builder__plan" type="button" data-plan data-target="20" data-discount="15" data-bundle-id="{{ section.settings.gift_20_bundle_id | escape }}" aria-pressed="false">
        <strong>Gift 20</strong>
        <span>20 cowls / 15% off</span>
      </button>
    </div>

    {%- if bundle_collection != blank and bundle_collection.products_count > 0 -%}
      <div class="ccg-gift-builder__status" aria-live="polite">
        <span>Selected: <strong data-total>0</strong> of <strong data-target-count>10</strong></span>
        <span data-status>Select 10 cowls to continue.</span>
      </div>

      <div class="ccg-gift-builder__grid">
        {%- for product in bundle_collection.products limit: products_limit -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          {%- if variant != blank -%}
            {%- liquid
              assign max_quantity = 20
              if variant.inventory_management != blank and variant.inventory_policy == 'deny'
                assign max_quantity = variant.inventory_quantity | at_least: 0 | at_most: 20
              endif
            -%}
            <article
              class="ccg-gift-builder__product{% unless variant.available %} is-unavailable{% endunless %}"
              data-product
              data-variant-id="{{ variant.id }}"
              data-price="{{ variant.price }}"
              data-max="{{ max_quantity }}"
            >
              <div class="ccg-gift-builder__media">
                {%- if product.featured_image != blank -%}
                  {%- assign image_alt = product.featured_image.alt | default: product.title -%}
                  {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240,360,480,600', sizes: '(max-width: 749px) 46vw, 220px', alt: image_alt }}
                {%- endif -%}
              </div>
              <div class="ccg-gift-builder__product-copy">
                <h3>{{ product.title | escape }}</h3>
                <p>{{ variant.price | money }}</p>
                {%- if variant.available and max_quantity > 0 -%}
                  <div class="ccg-gift-builder__quantity" aria-label="Quantity for {{ product.title | escape }}">
                    <button type="button" data-minus aria-label="Decrease {{ product.title | escape }} quantity">-</button>
                    <input type="number" value="0" min="0" max="{{ max_quantity }}" inputmode="numeric" data-quantity aria-label="{{ product.title | escape }} quantity">
                    <button type="button" data-plus aria-label="Increase {{ product.title | escape }} quantity">+</button>
                  </div>
                {%- else -%}
                  <span class="ccg-gift-builder__sold-out">Sold out</span>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="ccg-gift-builder__summary">
        <div>
          <span>Bundle subtotal</span>
          <strong data-subtotal>{{ 0 | money }}</strong>
        </div>
        <div>
          <span>Bundle discount (<span data-discount-label>10</span>%)</span>
          <strong data-savings>-{{ 0 | money }}</strong>
        </div>
        <div class="ccg-gift-builder__total-row">
          <span>Bundle total</span>
          <strong data-price>{{ 0 | money }}</strong>
        </div>
        <button class="ccg-gift-builder__add" type="button" data-add disabled>Add Gift 10 to cart</button>
        <p class="ccg-gift-builder__error" data-error role="alert" hidden></p>
      </div>
    {%- else -%}
      <p>Select a collection in this section's theme settings.</p>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('CCGGiftBuilder-{{ section.id }}');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const moneyFormat = root.dataset.moneyFormat || '${{amount}}';
    const plans = [...root.querySelectorAll('[data-plan]')];
    const products = [...root.querySelectorAll('[data-product]')];
    const totalEl = root.querySelector('[data-total]');
    const targetEl = root.querySelector('[data-target-count]');
    const statusEl = root.querySelector('[data-status]');
    const subtotalEl = root.querySelector('[data-subtotal]');
    const savingsEl = root.querySelector('[data-savings]');
    const priceEl = root.querySelector('[data-price]');
    const discountLabel = root.querySelector('[data-discount-label]');
    const addButton = root.querySelector('[data-add]');
    const errorEl = root.querySelector('[data-error]');
    let target = 10;
    let discount = 10;
    let bundleId = plans[0] ? plans[0].dataset.bundleId : '';

    const formatMoney = (cents) => {
      const amount = (cents / 100).toFixed(2);
      return moneyFormat.replace(/\{\{\s*amount(?:_with_comma_separator)?\s*\}\}/, amount);
    };

    const selection = () => products.map((product) => {
      const input = product.querySelector('[data-quantity]');
      return {
        id: Number(product.dataset.variantId),
        price: Number(product.dataset.price),
        quantity: input ? Math.max(0, Number(input.value) || 0) : 0
      };
    }).filter((item) => item.quantity > 0);

    const update = () => {
      const items = selection();
      const total = items.reduce((sum, item) => sum + item.quantity, 0);
      const subtotal = items.reduce((sum, item) => sum + item.price * item.quantity, 0);
      const savings = Math.round(subtotal * discount / 100);
      const remaining = target - total;

      totalEl.textContent = total;
      targetEl.textContent = target;
      discountLabel.textContent = discount;
      subtotalEl.textContent = formatMoney(subtotal);
      savingsEl.textContent = `-${formatMoney(savings)}`;
      priceEl.textContent = formatMoney(subtotal - savings);
      addButton.disabled = total !== target;
      addButton.textContent = `Add Gift ${target} to cart`;

      if (remaining > 0) statusEl.textContent = `Choose ${remaining} more ${remaining === 1 ? 'cowl' : 'cowls'}.`;
      else if (remaining < 0) statusEl.textContent = `Remove ${Math.abs(remaining)} ${remaining === -1 ? 'cowl' : 'cowls'}.`;
      else statusEl.textContent = `Gift ${target} is ready to add.`;
    };

    plans.forEach((plan) => plan.addEventListener('click', () => {
      target = Number(plan.dataset.target);
      discount = Number(plan.dataset.discount);
      bundleId = plan.dataset.bundleId;
      plans.forEach((item) => {
        const active = item === plan;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      update();
    }));

    products.forEach((product) => {
      const input = product.querySelector('[data-quantity]');
      if (!input) return;
      const setQuantity = (next) => {
        const max = Math.min(Number(input.max) || target, target);
        input.value = Math.max(0, Math.min(max, Number(next) || 0));
        update();
      };
      product.querySelector('[data-minus]').addEventListener('click', () => setQuantity(Number(input.value) - 1));
      product.querySelector('[data-plus]').addEventListener('click', () => setQuantity(Number(input.value) + 1));
      input.addEventListener('input', () => setQuantity(input.value));
    });

    addButton.addEventListener('click', async () => {
      const items = selection();
      const total = items.reduce((sum, item) => sum + item.quantity, 0);
      if (total !== target) return update();

      addButton.disabled = true;
      addButton.textContent = 'Adding bundle…';
      errorEl.hidden = true;

      const bundleKey = `ccg-gift-${target}-${Date.now()}`;
      if (!bundleId) {
        errorEl.textContent = `Gift ${target} is missing its MBC bundle ID.`;
        errorEl.hidden = false;
        addButton.disabled = false;
        return;
      }

      try {
        const response = await fetch(`${window.Shopify?.routes?.root || '/'}cart/add.js?mbcb-request`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            items: items.map((item) => ({
              id: item.id,
              quantity: item.quantity,
              properties: {
                '_mbc_part': String(bundleId),
                '_CCG Bundle Key': bundleKey,
                'Bundle': `Gift ${target}`
              }
            }))
          })
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.description || result.message || 'The bundle could not be added.');

        for (let attempt = 0; attempt < 20; attempt += 1) {
          if (window.MAKEBECOOL_BUNDLES && typeof window.MAKEBECOOL_BUNDLES.updateCart === 'function') {
            await window.MAKEBECOOL_BUNDLES.updateCart();
            break;
          }
          await new Promise((resolve) => window.setTimeout(resolve, 100));
        }
        window.location.assign('/cart');
      } catch (error) {
        errorEl.textContent = error.message || 'The bundle could not be added. Please check the selected quantities.';
        errorEl.hidden = false;
        addButton.disabled = false;
        addButton.textContent = `Add Gift ${target} to cart`;
      }
    });

    update();
  })();
</script>

{% stylesheet %}
  .ccg-gift-builder { background: var(--builder-bg); color: var(--builder-ink); padding: 64px 32px 96px; }
  .ccg-gift-builder__inner { width: 100%; max-width: 1440px; margin: 0 auto; }
  .ccg-gift-builder__intro { max-width: 760px; margin-bottom: 36px; }
  .ccg-gift-builder__eyebrow { margin: 0 0 10px; font: 400 14px/1.2 'Barlow Condensed', sans-serif; letter-spacing: .22em; text-transform: uppercase; color: var(--builder-accent); }
  .ccg-gift-builder__heading { margin: 0 0 16px; font-family: 'Rye', serif; font-size: clamp(30px, 4vw, 48px); font-weight: 400; }
  .ccg-gift-builder__description { line-height: 1.7; }
  .ccg-gift-builder__plans { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; max-width: 680px; margin-bottom: 24px; }
  .ccg-gift-builder__plan { display: flex; flex-direction: column; gap: 5px; padding: 18px 22px; border: 1px solid rgba(33,28,23,.22); background: transparent; color: inherit; text-align: left; cursor: pointer; }
  .ccg-gift-builder__plan strong { font-family: 'Rye', serif; font-size: 20px; font-weight: 400; }
  .ccg-gift-builder__plan.is-active { border-color: var(--builder-accent); box-shadow: inset 0 0 0 1px var(--builder-accent); }
  .ccg-gift-builder__status { display: flex; justify-content: space-between; gap: 16px; padding: 15px 18px; margin-bottom: 24px; background: rgba(185,138,82,.12); }
  .ccg-gift-builder__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
  .ccg-gift-builder__product { border: 1px solid rgba(33,28,23,.16); background: #fbf9f4; }
  .ccg-gift-builder__product.is-unavailable { opacity: .55; }
  .ccg-gift-builder__media { aspect-ratio: 4 / 5; overflow: hidden; background: #ede7dc; }
  .ccg-gift-builder__media img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .ccg-gift-builder__product-copy { padding: 16px; }
  .ccg-gift-builder__product-copy h3 { min-height: 2.8em; margin: 0 0 8px; font-size: 15px; line-height: 1.4; text-transform: uppercase; }
  .ccg-gift-builder__product-copy p { margin: 0 0 14px; }
  .ccg-gift-builder__quantity { display: grid; grid-template-columns: 42px 1fr 42px; border: 1px solid rgba(33,28,23,.18); }
  .ccg-gift-builder__quantity button, .ccg-gift-builder__quantity input { min-height: 42px; border: 0; background: transparent; color: inherit; text-align: center; font: inherit; }
  .ccg-gift-builder__quantity button { cursor: pointer; font-size: 20px; }
  .ccg-gift-builder__quantity input { width: 100%; border-inline: 1px solid rgba(33,28,23,.18); appearance: textfield; }
  .ccg-gift-builder__quantity input::-webkit-inner-spin-button { appearance: none; }
  .ccg-gift-builder__sold-out { color: #8a5a32; text-transform: uppercase; letter-spacing: .1em; }
  .ccg-gift-builder__summary { max-width: 620px; margin: 36px 0 0 auto; padding-top: 22px; border-top: 1px solid rgba(33,28,23,.18); }
  .ccg-gift-builder__summary > div { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 10px; }
  .ccg-gift-builder__total-row { padding-top: 12px; margin-top: 12px; border-top: 1px solid rgba(33,28,23,.18); font-size: 20px; }
  .ccg-gift-builder__add { width: 100%; min-height: 54px; margin-top: 14px; border: 0; background: var(--builder-accent); color: #fff; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; }
  .ccg-gift-builder__add:disabled { opacity: .45; cursor: not-allowed; }
  .ccg-gift-builder__error { margin: 12px 0 0; color: #b42318; }
  @media screen and (max-width: 989px) { .ccg-gift-builder__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media screen and (max-width: 749px) {
    .ccg-gift-builder { padding: 42px 16px 64px; }
    .ccg-gift-builder__plans, .ccg-gift-builder__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ccg-gift-builder__status { align-items: flex-start; flex-direction: column; }
    .ccg-gift-builder__product-copy { padding: 12px; }
    .ccg-gift-builder__quantity { grid-template-columns: 36px 1fr 36px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift bundle builder",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Cowl collection" },
    { "type": "text", "id": "gift_10_bundle_id", "label": "Gift 10 MBC bundle ID", "default": "127991" },
    { "type": "text", "id": "gift_20_bundle_id", "label": "Gift 20 MBC bundle ID", "default": "127993" },
    { "type": "range", "id": "products_limit", "min": 4, "max": 40, "step": 1, "label": "Products shown", "default": 24 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mix, match & save" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your crew gift bundle" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Choose different cowl patterns and set the quantity for each. Your quantities must total 10 or 20.</p>" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f8f5ee" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#211c17" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#a77b58" }
  ],
  "presets": [{ "name": "Gift bundle builder" }]
}
{% endschema %}
