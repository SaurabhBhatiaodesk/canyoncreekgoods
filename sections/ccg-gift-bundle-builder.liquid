{%- liquid



  assign bundle_collection = section.settings.collection



  assign products_limit = section.settings.products_limit



-%}







<section



  id="CCGGiftBuilder-{{ section.id }}"



  class="ccg-gift-builder"



  data-gift-builder



  data-money-format="{{ shop.money_format | escape }}"

  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"



  style="



    --builder-bg: {{ section.settings.background_color }};



    --builder-ink: {{ section.settings.text_color }};



    --builder-accent: {{ section.settings.accent_color }};



  "



>



  <div class="ccg-gift-builder__inner">



    <div class="ccg-gift-builder__intro">



      {%- if section.settings.eyebrow != blank -%}



        <p class="ccg-gift-builder__eyebrow">{{ section.settings.eyebrow | escape }}</p>



      {%- endif -%}







      {%- if section.settings.heading != blank -%}



        <h2 class="ccg-gift-builder__heading">{{ section.settings.heading | escape }}</h2>



      {%- endif -%}







      {%- if section.settings.description != blank -%}



        <div class="ccg-gift-builder__description rte">{{ section.settings.description }}</div>



      {%- endif -%}



    </div>







    <div class="ccg-gift-builder__plans" role="group" aria-label="Choose bundle size">
      {%- for block in section.blocks -%}
        {%- if block.type == 'bundle' and block.settings.bundle_id != blank -%}
          <button
            class="ccg-gift-builder__plan{% if forloop.first %} is-active{% endif %} is-loading"
            type="button"
            data-plan
            data-bundle-id="{{ block.settings.bundle_id | escape }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="ccg-gift-builder__plan-label" aria-hidden="true"></span>
          </button>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <span class="ccg-gift-builder__plans-loading">
          Add an MBC bundle block in the theme editor.
        </span>
      {%- endif -%}
    </div>

    {%- if bundle_collection != blank and bundle_collection.products_count > 0 -%}



      <div class="ccg-gift-builder__status">



        <span>



          Selected:



          <strong data-total>0</strong>



          of



          <strong data-target-count>0</strong>



        </span>



        <span data-status>Loading bundle rules…</span>



      </div>







      <div class="ccg-gift-builder__selected-grid" data-selected-grid>



        <button class="ccg-gift-builder__add-card" type="button" data-open-picker>



          <span class="ccg-gift-builder__plus">+</span>



          <span>Add product</span>



        </button>



      </div>







      <button class="ccg-gift-builder__choose" type="button" data-open-picker>



        Choose a product



      </button>







      <div class="ccg-gift-builder__summary">



        <div>



          <span>Bundle subtotal</span>



          <strong data-subtotal>{{ 0 | money }}</strong>



        </div>







        <div>



          <span>



            Bundle discount



            (<span data-discount-label>syncing</span>)



          </span>



          <strong data-savings>-{{ 0 | money }}</strong>



        </div>







        <div class="ccg-gift-builder__total-row">



          <span>Bundle total</span>



          <strong data-price>{{ 0 | money }}</strong>



        </div>







        <button class="ccg-gift-builder__add" type="button" data-add disabled>



          Add to cart



        </button>







        <p class="ccg-gift-builder__error" data-error hidden></p>



      </div>







      <div class="ccg-gift-builder__picker" data-picker hidden>



        <div class="ccg-gift-builder__picker-backdrop" data-close-picker></div>







        <div class="ccg-gift-builder__picker-panel" role="dialog" aria-modal="true" aria-label="Choose products">



          <div class="ccg-gift-builder__picker-head">



            <div>



              <p class="ccg-gift-builder__picker-eyebrow">Choose products</p>



              <h3>Add cowls to your bundle</h3>



            </div>







            <button type="button" class="ccg-gift-builder__picker-close" data-close-picker aria-label="Close">



              ×



            </button>



          </div>







          <div class="ccg-gift-builder__picker-grid">



            {%- for product in bundle_collection.products limit: products_limit -%}



              {%- assign variant = product.selected_or_first_available_variant -%}



              {%- if variant != blank -%}



                {%- liquid



                  assign max_quantity = 50







                  if variant.inventory_management != blank and variant.inventory_policy == 'deny'



                    assign max_quantity = variant.inventory_quantity | at_least: 0 | at_most: 50



                  endif



                -%}







                <button



                  type="button"



                  class="ccg-gift-builder__picker-product{% unless variant.available and max_quantity > 0 %} is-unavailable{% endunless %}"



                  data-picker-product



                  data-variant-id="{{ variant.id }}"



                  data-title="{{ product.title | escape }}"



                  data-price="{{ variant.price }}"



                  data-max="{{ max_quantity }}"



                  data-image="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 600 }}{% endif %}"



                  {% unless variant.available and max_quantity > 0 %}disabled{% endunless %}



                >



                  <span class="ccg-gift-builder__picker-media">



                    {%- if product.featured_image != blank -%}



                      {{



                        product.featured_image



                        | image_url: width: 500



                        | image_tag:



                          loading: 'lazy',



                          widths: '200,300,400,500',



                          alt: product.title



                      }}



                    {%- endif -%}



                  </span>







                  <span class="ccg-gift-builder__picker-copy">



                    <strong>{{ product.title | escape }}</strong>



                    <span>{{ variant.price | money }}</span>



                  </span>



                </button>



              {%- endif -%}



            {%- endfor -%}



          </div>



        </div>



      </div>



    {%- else -%}



      <p class="ccg-gift-builder__empty">



        Select a collection in this section's theme settings.



      </p>



    {%- endif -%}



  </div>



</section>







<script>



(() => {



  const root = document.getElementById('CCGGiftBuilder-{{ section.id }}');



  if (!root || root.dataset.ready === 'true') return;







  root.dataset.ready = 'true';







  const moneyFormat = root.dataset.moneyFormat || '${{amount}}';

  const currencyCode = root.dataset.currency || 'USD';



  const plans = [...root.querySelectorAll('[data-plan]')];



  const selectedGrid = root.querySelector('[data-selected-grid]');



  const picker = root.querySelector('[data-picker]');



  const pickerProducts = [...root.querySelectorAll('[data-picker-product]')];







  const totalEl = root.querySelector('[data-total]');



  const targetEl = root.querySelector('[data-target-count]');



  const statusEl = root.querySelector('[data-status]');



  const subtotalEl = root.querySelector('[data-subtotal]');



  const savingsEl = root.querySelector('[data-savings]');



  const priceEl = root.querySelector('[data-price]');



  const discountLabel = root.querySelector('[data-discount-label]');



  const addButton = root.querySelector('[data-add]');



  const errorEl = root.querySelector('[data-error]');







  const selected = new Map();







  let activePlan = plans[0] || null;

  let bundleLabel = 'Bundle';

  let target = 0;

  let discount = null;

  let discountSource = 'mbc';

  let bundleId = activePlan?.dataset.bundleId || '';



  const formatMoney = (cents) => {

    const value = Number(cents || 0) / 100;



    try {

      return new Intl.NumberFormat(undefined, {

        style: 'currency',

        currency: currencyCode

      }).format(value);

    } catch (error) {

      return `$${value.toFixed(2)}`;

    }

  };



  const openPicker = () => {



    if (!picker) return;

    if (!bundleId || !target || target <= 0) {
      if (statusEl) {
        statusEl.textContent = 'Bundle rules are still loading. Please try again.';
      }

      if (errorEl) {
        errorEl.textContent =
          'The selected MBC bundle has not finished loading yet.';
        errorEl.hidden = false;
      }

      return;
    }



    picker.hidden = false;



    document.documentElement.classList.add('ccg-picker-open');



  };







  const closePicker = () => {



    if (!picker) return;



    picker.hidden = true;



    document.documentElement.classList.remove('ccg-picker-open');



  };







  root.querySelectorAll('[data-open-picker]').forEach((button) => {



    button.addEventListener('click', openPicker);



  });







  root.querySelectorAll('[data-close-picker]').forEach((button) => {



    button.addEventListener('click', closePicker);



  });







  const getItems = () => [...selected.values()];







  const syncPickerSelectionState = () => {
    pickerProducts.forEach((button) => {
      const id = Number(button.dataset.variantId);
      const isSelected = selected.has(id);

      button.classList.toggle('is-selected', isSelected);
      button.setAttribute('aria-disabled', isSelected ? 'true' : 'false');

      if (isSelected) {
        button.disabled = true;
      } else if (!button.classList.contains('is-unavailable')) {
        button.disabled = false;
      }
    });
  };

  const renderSelected = () => {



    if (!selectedGrid) return;







    selectedGrid.querySelectorAll('[data-selected-product]').forEach((card) => card.remove());







    selected.forEach((item) => {



      const article = document.createElement('article');



      article.className = 'ccg-gift-builder__product-card';



      article.dataset.selectedProduct = '';



      article.dataset.variantId = item.id;







      const media = document.createElement('div');



      media.className = 'ccg-gift-builder__product-media';







      if (item.image) {



        const image = document.createElement('img');



        image.src = item.image;



        image.alt = item.title;



        image.loading = 'lazy';



        media.appendChild(image);



      }







      const remove = document.createElement('button');



      remove.type = 'button';



      remove.className = 'ccg-gift-builder__remove';



      remove.textContent = 'Remove product';



      remove.addEventListener('click', () => {



        selected.delete(item.id);



        renderSelected();



        update();



      });







      const copy = document.createElement('div');



      copy.className = 'ccg-gift-builder__product-copy';







      const title = document.createElement('h3');



      title.textContent = item.title;







      const price = document.createElement('p');



      price.textContent = formatMoney(item.price);







      const quantityLabel = document.createElement('div');
      quantityLabel.className = 'ccg-gift-builder__quantity-label';
      quantityLabel.textContent = 'Quantity';

      const quantity = document.createElement('div');



      quantity.className = 'ccg-gift-builder__quantity';







      const minus = document.createElement('button');



      minus.type = 'button';



      minus.textContent = '−';







      const input = document.createElement('input');



      input.type = 'number';



      input.min = '1';



      input.max = String(
        Math.max(
          1,
          target > 0
            ? Math.min(item.max, target)
            : item.max
        )
      );



      input.value = String(item.quantity);



      input.inputMode = 'numeric';







      const plus = document.createElement('button');



      plus.type = 'button';



      plus.textContent = '+';







      const getAllowedMax = () => {
        const inventoryMax = Number(item.max || 0);
        const bundleMax = Number(target || 0);

        if (inventoryMax > 0 && bundleMax > 0) {
          return Math.max(1, Math.min(inventoryMax, bundleMax));
        }

        if (inventoryMax > 0) {
          return Math.max(1, inventoryMax);
        }

        if (bundleMax > 0) {
          return Math.max(1, bundleMax);
        }

        return 1;
      };

      const refreshQuantityControls = () => {
        const max = getAllowedMax();

        input.min = '1';
        input.max = String(max);
        input.value = String(item.quantity);

        minus.disabled = item.quantity <= 1;
        plus.disabled = item.quantity >= max;

        minus.setAttribute('aria-disabled', minus.disabled ? 'true' : 'false');
        plus.setAttribute('aria-disabled', plus.disabled ? 'true' : 'false');
      };

      const setQuantity = (next) => {
        const max = getAllowedMax();
        const numeric = Number(next);

        if (!Number.isFinite(numeric)) {
          refreshQuantityControls();
          return;
        }

        const value = Math.max(1, Math.min(max, Math.round(numeric)));

        item.quantity = value;
        refreshQuantityControls();
        update();
      };

      minus.addEventListener('click', () => {
        if (item.quantity <= 1) return;
        setQuantity(item.quantity - 1);
      });

      plus.addEventListener('click', () => {
        setQuantity(item.quantity + 1);
      });

      input.addEventListener('input', () => {
        /*
         * Keep the selected card visible while the customer edits the field.
         * An empty/temporary value must never remove the product.
         */
        if (input.value === '') return;

        const numeric = Number(input.value);
        if (!Number.isFinite(numeric)) return;

        setQuantity(numeric);
      });

      input.addEventListener('change', () => {
        if (input.value === '') {
          setQuantity(item.quantity);
          return;
        }

        setQuantity(input.value);
      });

      refreshQuantityControls();



      quantity.append(minus, input, plus);



      copy.append(title, price, quantityLabel, quantity);



      article.append(remove, media, copy);







      selectedGrid.insertBefore(article, selectedGrid.querySelector('[data-open-picker]'));



    });



    syncPickerSelectionState();

  };









  const waitForMBC = async (timeout = 8000) => {

    const started = Date.now();



    while (Date.now() - started < timeout) {

      if (window.MAKEBECOOL_BUNDLES) return window.MAKEBECOOL_BUNDLES;

      await new Promise((resolve) => window.setTimeout(resolve, 150));

    }



    return null;

  };



  const findBundleObject = (source, wantedId) => {

    if (!source || !wantedId) return null;



    const wanted = String(wantedId);

    const seen = new WeakSet();

    const queue = [{ value: source, depth: 0 }];

    let visited = 0;



    while (queue.length && visited < 5000) {

      const { value, depth } = queue.shift();

      visited += 1;



      if (!value || typeof value !== 'object') continue;

      if (seen.has(value)) continue;

      seen.add(value);



      for (const key of ['id', 'bundleId', 'bundle_id', 'bundleID']) {

        try {

          if (value[key] != null && String(value[key]) === wanted) return value;

        } catch (e) {}

      }



      if (depth >= 6) continue;



      let entries = [];

      try {

        entries = Array.isArray(value)

          ? value.map((item, index) => [String(index), item])

          : Object.entries(value);

      } catch (e) {}



      for (const [, child] of entries) {

        if (child && typeof child === 'object') {

          queue.push({ value: child, depth: depth + 1 });

        }

      }

    }



    return null;

  };



  const getNumber = (object, keys) => {

    if (!object || typeof object !== 'object') return null;



    for (const key of keys) {

      if (!(key in object)) continue;

      const number = Number(object[key]);

      if (Number.isFinite(number)) return number;

    }



    return null;

  };



  const getText = (object, keys) => {

    if (!object || typeof object !== 'object') return '';



    for (const key of keys) {

      const value = object[key];

      if (typeof value === 'string' && value.trim()) return value.trim();

    }



    return '';

  };



  const extractBundleConfig = (bundle) => {
    if (!bundle || typeof bundle !== 'object') return {};

    const seen = new WeakSet();
    const queue = [{ value: bundle, depth: 0 }];

    let percent = null;
    let minimum = null;
    let maximum = null;
    let title = '';

    const normalizeKey = (key) =>
      String(key || '')
        .replace(/[^a-z0-9]/gi, '')
        .toLowerCase();

    while (queue.length) {
      const { value, depth } = queue.shift();

      if (!value || typeof value !== 'object') continue;
      if (seen.has(value)) continue;
      seen.add(value);

      let entries = [];

      try {
        entries = Array.isArray(value)
          ? value.map((item, index) => [String(index), item])
          : Object.entries(value);
      } catch (e) {
        entries = [];
      }

      for (const [rawKey, rawValue] of entries) {
        const key = normalizeKey(rawKey);

        if (!title && typeof rawValue === 'string') {
          if (
            key === 'bundletitle' ||
            key === 'title' ||
            key === 'name'
          ) {
            title = rawValue.trim();
          }
        }

        const numericValue = Number(rawValue);

        if (Number.isFinite(numericValue)) {
          if (
            minimum == null &&
            (
              key.includes('minimumitemsrequired') ||
              key.includes('minitems') ||
              key.includes('minimumquantity') ||
              key.includes('requireditems') ||
              key.includes('requiredquantity') ||
              key === 'min'
            )
          ) {
            minimum = numericValue;
          }

          if (
            maximum == null &&
            (
              key.includes('maximumitemsallowed') ||
              key.includes('maxitems') ||
              key.includes('maximumquantity') ||
              key.includes('maxquantity') ||
              key === 'max'
            )
          ) {
            maximum = numericValue;
          }

          if (
            percent == null &&
            numericValue >= 0 &&
            numericValue <= 100 &&
            (
              key.includes('discountpercentage') ||
              key.includes('discountpercent') ||
              key === 'percentage' ||
              key === 'percent'
            )
          ) {
            percent = numericValue;
          }
        }

        if (
          rawValue &&
          typeof rawValue === 'object' &&
          depth < 8
        ) {
          queue.push({
            value: rawValue,
            depth: depth + 1
          });
        }
      }
    }

    /*
     * Fallback: MBC bundle titles commonly contain the live rule,
     * e.g. "Gift 10 Cowls | 10% Off". If MBC's internal field names
     * change, use the MBC title itself rather than a theme hardcode.
     */
    if (title) {
      if (minimum == null || minimum <= 0) {
        const quantityMatch =
          title.match(/\b(?:gift\s*)?(\d+)\s*(?:cowls?|items?)\b/i) ||
          title.match(/\bgift\s*(\d+)\b/i);

        if (quantityMatch) {
          minimum = Number(quantityMatch[1]);
          maximum = Number(quantityMatch[1]);
        }
      }

      if (percent == null) {
        const discountMatch = title.match(/(\d+(?:\.\d+)?)\s*%\s*(?:off)?/i);

        if (discountMatch) {
          percent = Number(discountMatch[1]);
        }
      }
    }

    return {
      percent,
      minimum,
      maximum,
      title
    };
  };

  const syncPlanFromMBC = async (plan) => {
    if (!plan) return false;

    const mbc = await waitForMBC();
    if (!mbc) return false;

    const id = plan.dataset.bundleId || '';
    if (!id) return false;

    const bundle = findBundleObject(mbc, id);
    if (!bundle) return false;

    const config = extractBundleConfig(bundle);

    bundleId = id;

    if (config.title) {
      bundleLabel = config.title;
      plan.textContent = config.title;
      plan.dataset.label = config.title;
      plan.classList.remove('is-loading');
    } else {
      bundleLabel = `Bundle ${id}`;
      plan.textContent = bundleLabel;
      plan.dataset.label = bundleLabel;
      plan.classList.remove('is-loading');
    }

    target = 0;

    if (config.minimum != null && Number(config.minimum) > 0) {
      target = Number(config.minimum);
    }

    if (
      config.maximum != null &&
      Number(config.maximum) > 0 &&
      config.minimum != null &&
      Number(config.maximum) === Number(config.minimum)
    ) {
      target = Number(config.maximum);
    }

    discount = null;

    if (config.percent != null && Number.isFinite(Number(config.percent))) {
      discount = Number(config.percent);
      discountSource = 'mbc';
    }

    plan.dataset.target = String(target || 0);

    if (Number.isFinite(discount)) {
      plan.dataset.discount = String(discount);
    } else {
      delete plan.dataset.discount;
    }

    return target > 0;
  };

  const waitForPricingCalculated = () => new Promise((resolve) => {

    let resolved = false;



    const done = () => {

      if (resolved) return;

      resolved = true;

      document.removeEventListener('MAKEBECOOL_BUNDLES.pricingCalculated', done);

      resolve();

    };



    document.addEventListener(

      'MAKEBECOOL_BUNDLES.pricingCalculated',

      done,

      { once: true }

    );



    window.setTimeout(done, 1800);

  });



  const getFixedCart = async () => {

    const response = await fetch(`${window.Shopify?.routes?.root || '/'}cart.js`, {

      headers: { Accept: 'application/json' }

    });



    if (!response.ok) throw new Error('Unable to read cart.');



    let cart = await response.json();



    if (

      window.MAKEBECOOL_BUNDLES &&

      typeof window.MAKEBECOOL_BUNDLES.cartDataFix === 'function'

    ) {

      try {

        cart = await window.MAKEBECOOL_BUNDLES.cartDataFix(cart);

      } catch (e) {}

    }



    return cart;

  };





  const update = () => {



    const items = getItems();



    const total = items.reduce((sum, item) => sum + item.quantity, 0);



    const subtotal = items.reduce((sum, item) => sum + (item.price * item.quantity), 0);



    const hasDynamicDiscount = Number.isFinite(discount);



    const savings = hasDynamicDiscount

      ? Math.round(subtotal * discount / 100)

      : null;



    const bundleTotal = savings == null

      ? null

      : subtotal - savings;



    const remaining = target > 0 ? target - total : null;



    if (totalEl) totalEl.textContent = total;

    if (targetEl) targetEl.textContent = target;



    if (discountLabel) {

      discountLabel.textContent = hasDynamicDiscount ? `${discount}%` : 'MBC';

    }



    if (subtotalEl) subtotalEl.textContent = formatMoney(subtotal);



    if (savingsEl) {

      savingsEl.textContent = savings == null

        ? 'Calculated in cart'

        : `-${formatMoney(savings)}`;

    }



    if (priceEl) {

      priceEl.textContent = bundleTotal == null

        ? 'Calculated in cart'

        : formatMoney(bundleTotal);

    }



    if (addButton) {



      addButton.disabled = target <= 0 || total !== target;



      addButton.textContent = 'Add to cart';



    }







    if (statusEl) {



      if (remaining == null) {

        statusEl.textContent = 'Loading bundle rules…';

      } else if (remaining > 0) {



        statusEl.textContent = `Choose ${remaining} more ${remaining === 1 ? 'cowl' : 'cowls'}.`;



      } else if (remaining < 0) {



        statusEl.textContent = `Remove ${Math.abs(remaining)} ${Math.abs(remaining) === 1 ? 'cowl' : 'cowls'}.`;



      } else {



        statusEl.textContent = `${bundleLabel} is ready to add.`;



      }



    }







    selected.forEach((item) => {



      item.max = Math.max(0, item.max);



      if (item.quantity > target) item.quantity = target;



    });



  };







  pickerProducts.forEach((button) => {



    button.addEventListener('click', () => {



      const id = Number(button.dataset.variantId);



      if (!id || selected.has(id)) return;







      if (!selected.has(id)) {



        selected.set(id, {



          id,



          title: button.dataset.title || 'Product',



          price: Number(button.dataset.price || 0),



          max: Number(button.dataset.max || target),



          image: button.dataset.image || '',



          quantity: 1



        });



      }







      renderSelected();



      update();



      closePicker();



    });



  });







  const activatePlan = async (plan) => {
    if (!plan) return;

    activePlan = plan;
    bundleId = plan.dataset.bundleId || '';
    discount = null;
    bundleLabel = plan.dataset.label || 'Bundle';

    selected.clear();
    renderSelected();

    if (statusEl) {
      statusEl.textContent = 'Loading bundle rules…';
    }

    if (addButton) {
      addButton.disabled = true;
    }

    plans.forEach((item) => {
      const active = item === plan;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    renderSelected();
    update();

    const synced = await syncPlanFromMBC(plan);

    if (!synced) {
      if (statusEl) {
        statusEl.textContent = 'Unable to load this bundle from MBC.';
      }

      if (errorEl) {
        errorEl.textContent =
          `Could not load MBC bundle ${bundleId}. Check the bundle ID and make sure the bundle is active.`;
        errorEl.hidden = false;
      }

      plan.classList.remove('is-loading');
      plan.textContent = `Bundle ${bundleId}`;
      addButton.disabled = true;
      return;
    }

    if (errorEl) {
      errorEl.hidden = true;
      errorEl.textContent = '';
    }

    renderSelected();
    update();
  };

  plans.forEach((plan) => {
    plan.addEventListener('click', () => {
      activatePlan(plan);
    });
  });

  if (addButton) {



    addButton.addEventListener('click', async () => {



      const items = getItems();



      const total = items.reduce((sum, item) => sum + item.quantity, 0);







      if (total !== target) {



        update();



        return;



      }







      if (!bundleId) {



        errorEl.textContent = `${bundleLabel} is missing its MBC bundle ID.`;



        errorEl.hidden = false;



        return;



      }







      addButton.disabled = true;



      addButton.textContent = 'Adding…';







      if (errorEl) {



        errorEl.hidden = true;



        errorEl.textContent = '';



      }







      const bundleKey = `ccg-${bundleId}-${Date.now()}`;







      try {



        const response = await fetch(



          `${window.Shopify?.routes?.root || '/'}cart/add.js?mbcb-request`,



          {



            method: 'POST',



            headers: {



              'Content-Type': 'application/json',



              Accept: 'application/json'



            },



            body: JSON.stringify({



              items: items.map((item) => ({



                id: item.id,



                quantity: item.quantity,



                properties: {



                  '_mbc_part': String(bundleId),



                  '_CCG Bundle Key': bundleKey,



                  'Bundle': bundleLabel



                }



              }))



            })



          }



        );







        const result = await response.json();







        if (!response.ok) {



          throw new Error(



            result.description ||



            result.message ||



            'The bundle could not be added.'



          );



        }







        if (

          window.MAKEBECOOL_BUNDLES &&

          typeof window.MAKEBECOOL_BUNDLES.updateCart === 'function'

        ) {

          try {

            const pricingDone = waitForPricingCalculated();

            await window.MAKEBECOOL_BUNDLES.updateCart();

            await pricingDone;

          } catch (e) {}

        }



        /*

         * MBC + Shopify are the pricing source of truth.

         * cartDataFix() normalizes Ajax cart data before redirect.

         */

        try {

          await getFixedCart();

        } catch (e) {}



        window.location.assign('/cart');



      } catch (error) {



        if (errorEl) {



          errorEl.textContent =



            error.message ||



            'The bundle could not be added. Please check the selected quantities.';



          errorEl.hidden = false;



        }







        addButton.disabled = false;



        addButton.textContent = 'Add to cart';



      }



    });



  }







  update();



  if (activePlan) {

    syncPlanFromMBC(activePlan).then(() => {

      renderSelected();

      update();

    });

  }





})();



</script>







