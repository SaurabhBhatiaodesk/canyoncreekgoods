{%- liquid
  assign bundle_collection = section.settings.collection
  assign products_limit = section.settings.products_limit
-%}

<section
  id="CCGGiftBuilder-{{ section.id }}"
  class="ccg-gift-builder"
  data-gift-builder
  data-money-format="{{ shop.money_format | escape }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  style="
    --builder-bg: {{ section.settings.background_color }};
    --builder-ink: {{ section.settings.text_color }};
    --builder-accent: {{ section.settings.accent_color }};
  "
>
  <div class="ccg-gift-builder__inner">
    <div class="ccg-gift-builder__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ccg-gift-builder__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ccg-gift-builder__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="ccg-gift-builder__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="ccg-gift-builder__plans" role="group" aria-label="Choose bundle size">
      {%- for block in section.blocks -%}
        {%- if block.type == 'bundle' and block.settings.bundle_id != blank -%}
          <button
            class="ccg-gift-builder__plan is-loading"
            type="button"
            data-plan
            data-bundle-id="{{ block.settings.bundle_id | escape }}"
            aria-pressed="false"
            {{ block.shopify_attributes }}
          >
            <span data-plan-label></span>
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if bundle_collection != blank and bundle_collection.products_count > 0 -%}
      <div class="ccg-gift-builder__status">
        <span>
          Selected:
          <strong data-total>0</strong>
          of
          <strong data-target-count>—</strong>
        </span>
        <span data-status>Loading bundle rules…</span>
      </div>

      <div class="ccg-gift-builder__selected-grid" data-selected-grid>
        <button class="ccg-gift-builder__add-card" type="button" data-open-picker>
          <span class="ccg-gift-builder__plus">+</span>
          <span>Add product</span>
        </button>
      </div>

      <button class="ccg-gift-builder__choose" type="button" data-open-picker>
        Choose a product
      </button>

      <div class="ccg-gift-builder__summary">
        <div>
          <span>Bundle subtotal</span>
          <strong data-subtotal>{{ 0 | money }}</strong>
        </div>

        <div>
          <span>
            Bundle discount
            (<span data-discount-label>—</span>)
          </span>
          <strong data-savings>-{{ 0 | money }}</strong>
        </div>

        <div class="ccg-gift-builder__total-row">
          <span>Bundle total</span>
          <strong data-price>{{ 0 | money }}</strong>
        </div>

        <button class="ccg-gift-builder__add" type="button" data-add disabled>
          Add to cart
        </button>

        <p class="ccg-gift-builder__error" data-error hidden></p>
      </div>

      <div class="ccg-gift-builder__picker" data-picker hidden>
        <div class="ccg-gift-builder__picker-backdrop" data-close-picker></div>

        <div class="ccg-gift-builder__picker-panel" role="dialog" aria-modal="true" aria-label="Choose products">
          <div class="ccg-gift-builder__picker-head">
            <div>
              <p class="ccg-gift-builder__picker-eyebrow">Choose products</p>
              <h3>Add cowls to your bundle</h3>
            </div>

            <button type="button" class="ccg-gift-builder__picker-close" data-close-picker aria-label="Close">
              ×
            </button>
          </div>

          <div class="ccg-gift-builder__picker-grid">
            {%- for product in bundle_collection.products limit: products_limit -%}
              {%- assign variant = product.selected_or_first_available_variant -%}
              {%- if variant != blank -%}
                {%- liquid
                  assign max_quantity = 50

                  if variant.inventory_management != blank and variant.inventory_policy == 'deny'
                    assign max_quantity = variant.inventory_quantity | at_least: 0 | at_most: 50
                  endif
                -%}

                <button
                  type="button"
                  class="ccg-gift-builder__picker-product{% unless variant.available and max_quantity > 0 %} is-unavailable{% endunless %}"
                  data-picker-product
                  data-variant-id="{{ variant.id }}"
                  data-title="{{ product.title | escape }}"
                  data-price="{{ variant.price }}"
                  data-max="{{ max_quantity }}"
                  data-image="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 600 }}{% endif %}"
                  {% unless variant.available and max_quantity > 0 %}disabled{% endunless %}
                >
                  <span class="ccg-gift-builder__picker-media">
                    {%- if product.featured_image != blank -%}
                      {{
                        product.featured_image
                        | image_url: width: 500
                        | image_tag:
                          loading: 'lazy',
                          widths: '200,300,400,500',
                          alt: product.title
                      }}
                    {%- endif -%}
                  </span>

                  <span class="ccg-gift-builder__picker-copy">
                    <strong>{{ product.title | escape }}</strong>
                    <span>{{ variant.price | money }}</span>
                  </span>
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="ccg-gift-builder__mbc-bridge" aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- if block.type == 'bundle' and block.settings.bundle_id != blank -%}
            <mbc-bundles-widget
              data-bundle-id="{{ block.settings.bundle_id | escape }}"
              data-ccg-mbc-widget
            ></mbc-bundles-widget>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="ccg-gift-builder__empty">
        Select a collection in this section's theme settings.
      </p>
    {%- endif -%}
  </div>
</section>

<script>
(() => {
  const root = document.getElementById('CCGGiftBuilder-{{ section.id }}');
  if (!root || root.dataset.ready === 'true') return;

  root.dataset.ready = 'true';

  const currencyCode = root.dataset.currency || 'USD';
  const plans = [...root.querySelectorAll('[data-plan]')];
  const mbcWidgets = [...root.querySelectorAll('[data-ccg-mbc-widget]')];
  const selectedGrid = root.querySelector('[data-selected-grid]');
  const picker = root.querySelector('[data-picker]');
  const pickerProducts = [...root.querySelectorAll('[data-picker-product]')];

  const totalEl = root.querySelector('[data-total]');
  const targetEl = root.querySelector('[data-target-count]');
  const statusEl = root.querySelector('[data-status]');
  const subtotalEl = root.querySelector('[data-subtotal]');
  const savingsEl = root.querySelector('[data-savings]');
  const priceEl = root.querySelector('[data-price]');
  const discountLabel = root.querySelector('[data-discount-label]');
  const addButton = root.querySelector('[data-add]');
  const errorEl = root.querySelector('[data-error]');
  const openPickerButtons = [...root.querySelectorAll('[data-open-picker]')];

  const selected = new Map();
  const ruleCache = new Map();

  let activePlan = null;
  let bundleLabel = 'Bundle';
  let target = 0;
  let discount = null;
  let bundleId = '';

  const wait = (ms) => new Promise((resolve) => window.setTimeout(resolve, ms));

  const formatMoney = (cents) => {
    const value = Number(cents || 0) / 100;

    try {
      return new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency: currencyCode
      }).format(value);
    } catch (error) {
      return `$${value.toFixed(2)}`;
    }
  };

  const normalizeText = (value) =>
    String(value || '').replace(/\s+/g, ' ').trim();

  const getWidgetForId = (id) =>
    mbcWidgets.find(
      (widget) => String(widget.dataset.bundleId || '') === String(id || '')
    ) || null;

  const getWidgetRoot = (widget) => widget?.shadowRoot || widget;

  const getWidgetText = (widget) => {
    const widgetRoot = getWidgetRoot(widget);

    return normalizeText(
      [
        widget?.textContent || '',
        widgetRoot && widgetRoot !== widget
          ? widgetRoot.textContent || ''
          : ''
      ].join(' ')
    );
  };

  const findBundleObject = (source, wantedId) => {
    if (!source || !wantedId) return null;

    const wanted = String(wantedId);
    const seen = new WeakSet();
    const queue = [{ value: source, depth: 0 }];
    let visited = 0;

    while (queue.length && visited < 5000) {
      const { value, depth } = queue.shift();
      visited += 1;

      if (!value || typeof value !== 'object') continue;
      if (seen.has(value)) continue;
      seen.add(value);

      const candidateIds = [
        value.bundleId,
        value.bundle_id,
        value.bundleID,
        value.id
      ];

      if (candidateIds.some((id) => id != null && String(id) === wanted)) {
        return value;
      }

      if (depth >= 7) continue;

      let entries = [];

      try {
        entries = Array.isArray(value)
          ? value.map((child, index) => [String(index), child])
          : Object.entries(value);
      } catch (error) {
        entries = [];
      }

      entries.forEach(([, child]) => {
        if (child && typeof child === 'object') {
          queue.push({
            value: child,
            depth: depth + 1
          });
        }
      });
    }

    return null;
  };

  const extractRulesFromObject = (bundle) => {
    if (!bundle || typeof bundle !== 'object') return {};

    const seen = new WeakSet();
    const queue = [{ value: bundle, depth: 0 }];

    let title = '';
    let minimum = null;
    let maximum = null;
    let percent = null;

    const normalizeKey = (key) =>
      String(key || '')
        .replace(/[^a-z0-9]/gi, '')
        .toLowerCase();

    while (queue.length) {
      const { value, depth } = queue.shift();

      if (!value || typeof value !== 'object') continue;
      if (seen.has(value)) continue;
      seen.add(value);

      let entries = [];

      try {
        entries = Array.isArray(value)
          ? value.map((child, index) => [String(index), child])
          : Object.entries(value);
      } catch (error) {
        entries = [];
      }

      for (const [rawKey, rawValue] of entries) {
        const key = normalizeKey(rawKey);

        if (!title && typeof rawValue === 'string') {
          if (
            key === 'bundletitle' ||
            key === 'title' ||
            key === 'name'
          ) {
            const candidate = normalizeText(rawValue);

            if (candidate.length >= 2 && candidate.length <= 160) {
              title = candidate;
            }
          }
        }

        /* Number(null) / Number('') / Number(false) are 0, which would lock in a bogus value. */
        const numeric =
          rawValue === null ||
          rawValue === '' ||
          typeof rawValue === 'boolean' ||
          typeof rawValue === 'object'
            ? NaN
            : Number(rawValue);

        if (Number.isFinite(numeric)) {
          if (
            minimum == null &&
            numeric > 0 &&
            (
              key.includes('minimumitemsrequired') ||
              key.includes('minitems') ||
              key.includes('minimumquantity') ||
              key.includes('requireditems') ||
              key.includes('requiredquantity')
            )
          ) {
            minimum = numeric;
          }

          if (
            maximum == null &&
            numeric > 0 &&
            (
              key.includes('maximumitemsallowed') ||
              key.includes('maxitems') ||
              key.includes('maximumquantity') ||
              key.includes('maxquantity')
            )
          ) {
            maximum = numeric;
          }

          if (
            percent == null &&
            numeric > 0 &&
            numeric <= 100 &&
            (
              key.includes('discountpercentage') ||
              key.includes('discountpercent')
            )
          ) {
            percent = numeric;
          }
        }

        if (
          rawValue &&
          typeof rawValue === 'object' &&
          depth < 8
        ) {
          queue.push({
            value: rawValue,
            depth: depth + 1
          });
        }
      }
    }

    return {
      title,
      minimum,
      maximum,
      percent
    };
  };

  const parseRulesFromText = (widget, id) => {
    const widgetRoot = getWidgetRoot(widget);

    const titleNode =
      widgetRoot?.querySelector?.('.mbc-bundles-list__title') ||
      widgetRoot?.querySelector?.('.mbc-bundle h1, .mbc-bundle h2, .mbc-bundle h3');

    const title = normalizeText(titleNode?.textContent || '');
    const text = normalizeText(`${title} ${getWidgetText(widget)}`);

    let quantity = null;
    let percent = null;

    const quantityPatterns = [
      /\bat\s+least\s+(\d+)\s+items?\b/i,
      /\bminimum(?:\s+items?\s+required)?\s*:?\s*(\d+)\b/i,
      /\bchoose\s+(\d+)\s+(?:items?|products?|cowls?)\b/i,
      /\bselect\s+(\d+)\s+(?:items?|products?|cowls?)\b/i,
      /\bgift\s+(\d+)\b/i,
      /\b(\d+)\s+cowls?\b/i
    ];

    for (const pattern of quantityPatterns) {
      const match = text.match(pattern);

      if (match) {
        quantity = Number(match[1]);
        break;
      }
    }

    const percentSources = [
      title,
      text,
      widget?.getAttribute?.('data-title') || ''
    ];

    for (const source of percentSources) {
      const percentMatch = String(source || '').match(
        /(\d+(?:\.\d+)?)\s*%\s*(?:off)?/i
      );

      if (percentMatch) {
        percent = Number(percentMatch[1]);
        break;
      }
    }

    return {
      title: title || `Bundle ${id}`,
      quantity,
      percent
    };
  };

  const getPercentFromLiveBundleTitle = (widget) => {
    if (!widget) return null;

    const widgetRoot = getWidgetRoot(widget);

    const candidates = [
      widgetRoot?.querySelector?.('.mbc-bundles-list__title')?.textContent,
      widgetRoot?.querySelector?.('.mbc-bundle h1')?.textContent,
      widgetRoot?.querySelector?.('.mbc-bundle h2')?.textContent,
      widgetRoot?.querySelector?.('.mbc-bundle h3')?.textContent,
      getWidgetText(widget)
    ];

    for (const candidate of candidates) {
      const match = String(candidate || '').match(
        /(\d+(?:\.\d+)?)\s*%\s*(?:off)?/i
      );

      if (match) {
        const value = Number(match[1]);

        if (Number.isFinite(value)) {
          return value;
        }
      }
    }

    return null;
  };

  /* Priority: MBC data object, then the live bundle title, then any % in the widget text. */
  const resolveMbcPercent = (widget, objectPercent, textPercent) => {
    const livePercent = getPercentFromLiveBundleTitle(widget);

    for (const value of [objectPercent, livePercent, textPercent]) {
      if (
        value !== null &&
        value !== undefined &&
        value !== '' &&
        Number.isFinite(Number(value))
      ) {
        return Number(value);
      }
    }

    return null;
  };

  const loadRules = async (id) => {
    if (ruleCache.has(id)) {
      return ruleCache.get(id);
    }

    const widget = getWidgetForId(id);
    const started = Date.now();
    let bestRules = null;

    while (Date.now() - started < 10000) {
      const mbc = window.MAKEBECOOL_BUNDLES || null;
      const objectBundle = findBundleObject(mbc, id);
      const objectRules = extractRulesFromObject(objectBundle);
      const textRules = parseRulesFromText(widget, id);

      const title =
        objectRules.title ||
        textRules.title ||
        `Bundle ${id}`;

      let quantity =
        Number(objectRules.minimum || 0) ||
        Number(textRules.quantity || 0);

      if (
        Number(objectRules.minimum) > 0 &&
        Number(objectRules.maximum) > 0 &&
        Number(objectRules.minimum) === Number(objectRules.maximum)
      ) {
        quantity = Number(objectRules.maximum);
      }

      const objectPercent =
        objectRules.percent !== null &&
        objectRules.percent !== undefined &&
        objectRules.percent !== '' &&
        Number.isFinite(Number(objectRules.percent))
          ? Number(objectRules.percent)
          : null;

      const textPercent =
        textRules.percent !== null &&
        textRules.percent !== undefined &&
        textRules.percent !== '' &&
        Number.isFinite(Number(textRules.percent))
          ? Number(textRules.percent)
          : null;

      const percent = resolveMbcPercent(
        widget,
        objectPercent,
        textPercent
      );

      bestRules = {
        id,
        title,
        quantity,
        percent
      };

      if (quantity > 0) {
        ruleCache.set(id, bestRules);
        return bestRules;
      }

      await wait(200);
    }

    if (bestRules?.quantity > 0) {
      ruleCache.set(id, bestRules);
      return bestRules;
    }

    throw new Error(
      `Could not read the live rules for MBC bundle ${id}.`
    );
  };

  const openPicker = () => {
    if (!picker || !target) return;

    picker.hidden = false;
    document.documentElement.classList.add('ccg-picker-open');
  };

  const closePicker = () => {
    if (!picker) return;

    picker.hidden = true;
    document.documentElement.classList.remove('ccg-picker-open');
  };

  openPickerButtons.forEach((button) => {
    button.addEventListener('click', openPicker);
  });

  root.querySelectorAll('[data-close-picker]').forEach((button) => {
    button.addEventListener('click', closePicker);
  });

  const getItems = () => [...selected.values()];

  const syncPickerSelectionState = () => {
    pickerProducts.forEach((button) => {
      const id = Number(button.dataset.variantId);
      const isSelected = selected.has(id);

      button.classList.toggle('is-selected', isSelected);

      if (isSelected) {
        button.disabled = true;
        button.setAttribute('aria-disabled', 'true');
      } else if (!button.classList.contains('is-unavailable')) {
        button.disabled = false;
        button.setAttribute('aria-disabled', 'false');
      }
    });
  };

  const update = () => {
    const items = getItems();
    const total = items.reduce(
      (sum, item) => sum + item.quantity,
      0
    );

    const subtotal = items.reduce(
      (sum, item) => sum + (item.price * item.quantity),
      0
    );

    const savings =
      Number.isFinite(discount)
        ? Math.round(subtotal * discount / 100)
        : null;

    const bundleTotal =
      savings != null
        ? subtotal - savings
        : null;

    const remaining =
      target > 0
        ? target - total
        : null;

    if (totalEl) totalEl.textContent = total;
    if (targetEl) targetEl.textContent = target > 0 ? target : '—';

    if (discountLabel) {
      discountLabel.textContent =
        Number.isFinite(discount)
          ? `${discount}%`
          : 'MBC';
    }

    if (subtotalEl) {
      subtotalEl.textContent = formatMoney(subtotal);
    }

    if (savingsEl) {
      savingsEl.textContent =
        savings != null
          ? `-${formatMoney(savings)}`
          : 'Calculated in cart';
    }

    if (priceEl) {
      priceEl.textContent =
        bundleTotal != null
          ? formatMoney(bundleTotal)
          : 'Calculated in cart';
    }

    if (addButton) {
      addButton.disabled =
        !target ||
        total !== target;

      addButton.textContent = 'Add to cart';
    }

    if (statusEl) {
      if (remaining == null) {
        statusEl.textContent = 'Loading bundle rules…';
      } else if (remaining > 0) {
        statusEl.textContent =
          `Choose ${remaining} more ${remaining === 1 ? 'cowl' : 'cowls'}.`;
      } else if (remaining < 0) {
        statusEl.textContent =
          `Remove ${Math.abs(remaining)} ${Math.abs(remaining) === 1 ? 'cowl' : 'cowls'}.`;
      } else {
        statusEl.textContent =
          `${bundleLabel} is ready to add.`;
      }
    }

    syncPickerSelectionState();
  };

  const renderSelected = () => {
    if (!selectedGrid) return;

    selectedGrid
      .querySelectorAll('[data-selected-product]')
      .forEach((card) => card.remove());

    selected.forEach((item) => {
      const article = document.createElement('article');

      article.className = 'ccg-gift-builder__product-card';
      article.dataset.selectedProduct = '';
      article.dataset.variantId = item.id;

      const remove = document.createElement('button');

      remove.type = 'button';
      remove.className = 'ccg-gift-builder__remove';
      remove.textContent = 'Remove product';

      remove.addEventListener('click', () => {
        selected.delete(item.id);
        renderSelected();
        update();
      });

      const media = document.createElement('div');
      media.className = 'ccg-gift-builder__product-media';

      if (item.image) {
        const image = document.createElement('img');

        image.src = item.image;
        image.alt = item.title;
        image.loading = 'lazy';

        media.appendChild(image);
      }

      const copy = document.createElement('div');
      copy.className = 'ccg-gift-builder__product-copy';

      const title = document.createElement('h3');
      title.textContent = item.title;

      const price = document.createElement('p');
      price.textContent = formatMoney(item.price);

      const quantityLabel = document.createElement('div');
      quantityLabel.className = 'ccg-gift-builder__quantity-label';
      quantityLabel.textContent = 'Quantity';

      const quantity = document.createElement('div');
      quantity.className = 'ccg-gift-builder__quantity';

      const minus = document.createElement('button');
      minus.type = 'button';
      minus.textContent = '−';

      const input = document.createElement('input');
      input.type = 'number';
      input.min = '1';
      input.value = String(item.quantity);
      input.inputMode = 'numeric';

      const plus = document.createElement('button');
      plus.type = 'button';
      plus.textContent = '+';

      const getAllowedMax = () => {
        const inventoryMax = Number(item.max || 0);

        if (inventoryMax > 0 && target > 0) {
          return Math.max(
            1,
            Math.min(inventoryMax, target)
          );
        }

        return Math.max(1, inventoryMax || target || 1);
      };

      const refreshControls = () => {
        const max = getAllowedMax();

        input.min = '1';
        input.max = String(max);
        input.value = String(item.quantity);

        minus.disabled = item.quantity <= 1;

        const currentTotal = getItems().reduce(
          (sum, entry) => sum + entry.quantity,
          0
        );

        plus.disabled =
          item.quantity >= max ||
          (
            target > 0 &&
            currentTotal >= target
          );
      };

      const setQuantity = (next) => {
        const numeric = Number(next);

        if (!Number.isFinite(numeric)) {
          refreshControls();
          return;
        }

        const currentTotalWithoutItem =
          getItems().reduce(
            (sum, entry) =>
              sum +
              (
                entry.id === item.id
                  ? 0
                  : entry.quantity
              ),
            0
          );

        const room =
          target > 0
            ? Math.max(
                1,
                target - currentTotalWithoutItem
              )
            : getAllowedMax();

        const value = Math.max(
          1,
          Math.min(
            getAllowedMax(),
            room,
            Math.round(numeric)
          )
        );

        item.quantity = value;

        refreshControls();
        update();
      };

      minus.addEventListener('click', () => {
        if (item.quantity <= 1) return;

        setQuantity(item.quantity - 1);
      });

      plus.addEventListener('click', () => {
        setQuantity(item.quantity + 1);
      });

      input.addEventListener('input', () => {
        if (input.value === '') return;

        setQuantity(input.value);
      });

      input.addEventListener('change', () => {
        if (input.value === '') {
          input.value = String(item.quantity);
          return;
        }

        setQuantity(input.value);
      });

      refreshControls();

      quantity.append(minus, input, plus);
      copy.append(title, price, quantityLabel, quantity);
      article.append(remove, media, copy);

      selectedGrid.insertBefore(
        article,
        selectedGrid.querySelector('[data-open-picker]')
      );
    });

    syncPickerSelectionState();
  };

  pickerProducts.forEach((button) => {
    button.addEventListener('click', () => {
      const id = Number(button.dataset.variantId);

      if (!id || selected.has(id)) return;

      selected.set(id, {
        id,
        title: button.dataset.title || 'Product',
        price: Number(button.dataset.price || 0),
        max: Number(button.dataset.max || target || 50),
        image: button.dataset.image || '',
        quantity: 1
      });

      renderSelected();
      update();
      closePicker();
    });
  });

  const activatePlan = async (plan) => {
    if (!plan) return;

    const id = String(plan.dataset.bundleId || '');

    plans.forEach((item) => {
      const active = item === plan;

      item.classList.toggle('is-active', active);
      item.setAttribute(
        'aria-pressed',
        active ? 'true' : 'false'
      );
    });

    activePlan = plan;
    bundleId = id;
    target = 0;
    discount = null;

    openPickerButtons.forEach((button) => {
      button.disabled = true;
    });

    if (addButton) addButton.disabled = true;

    if (statusEl) {
      statusEl.textContent = 'Loading bundle rules…';
    }

    if (errorEl) {
      errorEl.hidden = true;
      errorEl.textContent = '';
    }

    try {
      const rules = await loadRules(id);

      bundleLabel = rules.title || `Bundle ${id}`;
      target = Number(rules.quantity || 0);
      discount =
        rules.percent !== null &&
        rules.percent !== undefined &&
        rules.percent !== '' &&
        Number.isFinite(Number(rules.percent))
          ? Number(rules.percent)
          : null;

      const label = plan.querySelector('[data-plan-label]');

      if (label) {
        label.textContent = bundleLabel;
      }

      plan.classList.remove('is-loading');

      openPickerButtons.forEach((button) => {
        button.disabled = false;
      });

      /*
       * If the shopper changes Gift 10 -> Gift 20, keep their choices,
       * but trim any single quantity only if it is above the new live target.
       */
      selected.forEach((item) => {
        if (target > 0 && item.quantity > target) {
          item.quantity = target;
        }
      });

      renderSelected();
      update();
    } catch (error) {
      plan.classList.remove('is-loading');

      const label = plan.querySelector('[data-plan-label]');

      if (label) {
        label.textContent = `Bundle ${id}`;
      }

      if (errorEl) {
        errorEl.textContent =
          error.message ||
          'Could not load the MBC bundle rules.';
        errorEl.hidden = false;
      }

      update();
    }
  };

  plans.forEach((plan) => {
    plan.addEventListener('click', () => {
      activatePlan(plan);
    });
  });

  const preloadPlanLabels = async () => {
    for (const plan of plans) {
      const id = String(plan.dataset.bundleId || '');

      try {
        const rules = await loadRules(id);
        const label = plan.querySelector('[data-plan-label]');

        if (label) {
          label.textContent =
            rules.title ||
            `Bundle ${id}`;
        }

        plan.classList.remove('is-loading');
      } catch (error) {
        /*
         * Keep failed plan hidden during preload.
         * If it is the only plan, activatePlan will show the actual error.
         */
      }
    }

    const firstPlan =
      plans.find(
        (plan) => !plan.classList.contains('is-loading')
      ) ||
      plans[0];

    if (firstPlan) {
      activatePlan(firstPlan);
    }
  };

  if (addButton) {
    addButton.addEventListener('click', async () => {
      const items = getItems();
      const total = items.reduce(
        (sum, item) => sum + item.quantity,
        0
      );

      if (!target || total !== target) {
        update();
        return;
      }

      if (!bundleId) {
        if (errorEl) {
          errorEl.textContent =
            'The selected MBC bundle is missing its bundle ID.';
          errorEl.hidden = false;
        }

        return;
      }

      addButton.disabled = true;
      addButton.textContent = 'Adding…';

      if (errorEl) {
        errorEl.hidden = true;
        errorEl.textContent = '';
      }

      const bundleKey =
        `ccg-${bundleId}-${Date.now()}`;

      try {
        const response = await fetch(
          `${window.Shopify?.routes?.root || '/'}cart/add.js?mbcb-request`,
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },
            body: JSON.stringify({
              items: items.map((item) => ({
                id: item.id,
                quantity: item.quantity,
                properties: {
                  '_mbc_part': String(bundleId),
                  '_CCG Bundle Key': bundleKey,
                  'Bundle': bundleLabel
                }
              }))
            })
          }
        );

        const result = await response.json();

        if (!response.ok) {
          throw new Error(
            result.description ||
            result.message ||
            'The bundle could not be added.'
          );
        }

        if (
          window.MAKEBECOOL_BUNDLES &&
          typeof window.MAKEBECOOL_BUNDLES.updateCart === 'function'
        ) {
          try {
            await window.MAKEBECOOL_BUNDLES.updateCart();
          } catch (error) {}
        }

        let cart = null;

        try {
          const cartResponse = await fetch(
            `${window.Shopify?.routes?.root || '/'}cart.js`,
            {
              headers: {
                Accept: 'application/json'
              }
            }
          );

          cart = await cartResponse.json();
        } catch (error) {}

        if (
          cart &&
          window.MAKEBECOOL_BUNDLES &&
          typeof window.MAKEBECOOL_BUNDLES.cartDataFix === 'function'
        ) {
          try {
            await window.MAKEBECOOL_BUNDLES.cartDataFix(cart);
          } catch (error) {}
        }

        window.location.assign('/cart');
      } catch (error) {
        if (errorEl) {
          errorEl.textContent =
            error.message ||
            'The bundle could not be added. Please check the selected quantities.';
          errorEl.hidden = false;
        }

        addButton.textContent = 'Add to cart';
        update();
      }
    });
  }

  update();
  preloadPlanLabels();
})();
</script>

