{%- liquid
  assign mbc_bundle_id = section.settings.mbc_bundle_id | strip
-%}

<section
  id="CCGMBCBundle-{{ section.id }}"
  class="ccg-mbc-bundle"
  style="
    --ccg-bundle-bg: {{ section.settings.background_color }};
    --ccg-bundle-max-width: {{ section.settings.max_width }}px;
    --ccg-bundle-padding-top: {{ section.settings.padding_top }}px;
    --ccg-bundle-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="ccg-mbc-bundle__inner">
    {%- if mbc_bundle_id != blank -%}
      <mbc-bundles-widget data-bundle-id="{{ mbc_bundle_id | escape }}"></mbc-bundles-widget>
    {%- else -%}
      <p class="ccg-mbc-bundle__notice">
        Add the MBC Bundle ID in this section's theme settings.
      </p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .ccg-mbc-bundle {
    width: 100%;
    background: var(--ccg-bundle-bg);
    padding-top: var(--ccg-bundle-padding-top);
    padding-bottom: var(--ccg-bundle-padding-bottom);
  }

  .ccg-mbc-bundle__inner {
    width: min(var(--ccg-bundle-max-width), calc(100% - 40px));
    margin-inline: auto;
  }

  .ccg-mbc-bundle mbc-bundles-widget {
    display: block;
    width: 100%;
  }

  .ccg-mbc-bundle__notice {
    margin: 0;
    padding: 20px;
    border: 1px solid rgba(33, 28, 23, 0.18);
    background: #fff;
    color: #211c17;
  }

  @media screen and (max-width: 749px) {
    .ccg-mbc-bundle__inner {
      width: min(var(--ccg-bundle-max-width), calc(100% - 24px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MBC Dynamic Bundle",
  "settings": [
    {
      "type": "text",
      "id": "mbc_bundle_id",
      "label": "MBC Bundle ID",
      "default": "128498",
      "info": "Products, quantities, pricing, discounts and bundle rules are loaded by the MBC widget."
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f8f5ee"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "MBC Dynamic Bundle"
    }
  ]
}
{% endschema %}
