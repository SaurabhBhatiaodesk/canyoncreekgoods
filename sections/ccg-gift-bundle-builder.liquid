{%- liquid
  assign mbc_bundle_id = section.settings.mbc_bundle_id | strip
-%}

<section
  id="CCGGiftBuilder-{{ section.id }}"
  class="ccg-gift-builder"
  data-ccg-mbc-wrapper
  style="
    --builder-bg: {{ section.settings.background_color }};
    --builder-ink: {{ section.settings.text_color }};
    --builder-accent: {{ section.settings.accent_color }};
  "
>
  <div class="ccg-gift-builder__inner">
    <div class="ccg-gift-builder__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ccg-gift-builder__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ccg-gift-builder__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="ccg-gift-builder__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if mbc_bundle_id != blank -%}
      <div class="ccg-gift-builder__widget">
        <mbc-bundles-widget data-bundle-id="{{ mbc_bundle_id | escape }}"></mbc-bundles-widget>
      </div>
    {%- else -%}
      <p class="ccg-gift-builder__notice">
        Add the MBC Bundle ID in this section's settings.
      </p>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('CCGGiftBuilder-{{ section.id }}');
    if (!section || section.dataset.ccgReady === 'true') return;

    section.dataset.ccgReady = 'true';

    const widget = section.querySelector('mbc-bundles-widget');
    if (!widget) return;

    /*
      IMPORTANT:
      MBC remains the single source of truth for:
      - products
      - quantities
      - bundle rules
      - discounts
      - pricing
      - final cart/checkout pricing

      We do NOT calculate bundle totals or discounts in theme JavaScript.
    */

    const normalizeButtonText = (root) => {
      if (!root || !root.querySelectorAll) return;

      const buttons = root.querySelectorAll('button, [role="button"], input[type="submit"]');

      buttons.forEach((button) => {
        const currentText = (
          button.tagName === 'INPUT'
            ? button.value
            : button.textContent
        )?.trim() || '';

        if (/add\s+.*\s+to\s+cart/i.test(currentText) || /^add to cart$/i.test(currentText)) {
          if (button.tagName === 'INPUT') {
            button.value = 'Add to cart';
          } else {
            button.textContent = 'Add to cart';
          }
        }
      });
    };

    const scanWidget = () => {
      normalizeButtonText(widget);

      if (widget.shadowRoot) {
        normalizeButtonText(widget.shadowRoot);
      }
    };

    scanWidget();

    const observer = new MutationObserver(() => {
      scanWidget();
    });

    observer.observe(widget, {
      subtree: true,
      childList: true,
      characterData: true
    });

    const shadowWait = setInterval(() => {
      scanWidget();

      if (widget.shadowRoot) {
        try {
          observer.observe(widget.shadowRoot, {
            subtree: true,
            childList: true,
            characterData: true
          });
        } catch (e) {}

        clearInterval(shadowWait);
      }
    }, 250);

    setTimeout(() => clearInterval(shadowWait), 10000);
  })();
</script>

{% stylesheet %}
  .ccg-gift-builder {
    background: var(--builder-bg);
    color: var(--builder-ink);
    padding: 64px 32px 96px;
  }

  .ccg-gift-builder__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .ccg-gift-builder__intro {
    max-width: 760px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .ccg-gift-builder__eyebrow {
    margin: 0 0 10px;
    color: var(--builder-accent);
    font: 400 14px/1.2 'Barlow Condensed', sans-serif;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .ccg-gift-builder__heading {
    margin: 0 0 16px;
    color: var(--builder-ink);
    font-family: 'Rye', serif;
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 400;
    line-height: 1.12;
  }

  .ccg-gift-builder__description {
    color: var(--builder-ink);
    line-height: 1.7;
  }

  .ccg-gift-builder__description p {
    margin: 0;
  }

  .ccg-gift-builder__widget {
    width: 100%;
  }

  .ccg-gift-builder__widget mbc-bundles-widget {
    display: block;
    width: 100%;
  }

  .ccg-gift-builder__notice {
    margin: 0;
    padding: 20px;
    border: 1px solid rgba(33, 28, 23, .18);
    background: #fbf9f4;
  }

  @media screen and (max-width: 749px) {
    .ccg-gift-builder {
      padding: 42px 16px 64px;
    }

    .ccg-gift-builder__intro {
      margin-bottom: 28px;
    }

    .ccg-gift-builder__heading {
      font-size: clamp(28px, 10vw, 40px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift bundle builder",
  "settings": [
    {
      "type": "text",
      "id": "mbc_bundle_id",
      "label": "MBC Bundle ID",
      "default": "128498",
      "info": "MBC controls products, quantities, discounts, pricing and bundle rules dynamically."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Mix, match & save"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your crew gift bundle"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Choose different cowl patterns and set the quantity for each. Your quantities must total the amount required by the selected bundle.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f8f5ee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#211c17"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#a77b58"
    }
  ],
  "presets": [
    {
      "name": "Gift bundle builder"
    }
  ]
}
{% endschema %}
