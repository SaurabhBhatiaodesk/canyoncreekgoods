{%- liquid
  assign desktop_video = section.settings.desktop_video
  assign mobile_video = section.settings.mobile_video
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign banner_heading = section.settings.heading
  assign banner_eyebrow = section.settings.eyebrow
  assign banner_description = section.settings.description
  if section.settings.content_layout == 'collection' and request.page_type == 'collection'
    assign banner_heading = collection.title
    assign banner_eyebrow = 'Shop · ' | append: collection.title
    assign banner_description = collection.description
    if banner_description == blank
      assign collection_title_escaped = collection.title | escape
      assign banner_description = '<p>Browse ' | append: collection_title_escaped | append: ' from Canyon Creek Goods.</p>'
    endif
  endif
-%}

<section
  class="ccg-image-banner{% if desktop_video != blank %} ccg-image-banner--has-desktop-video{% endif %}{% if mobile_video != blank %} ccg-image-banner--has-mobile-video{% endif %}{% if mobile_image != blank %} ccg-image-banner--has-mobile-image{% endif %}"
  style="
    {% if desktop_image != blank %}
      --ccg-image-banner-image: url('{{ desktop_image | image_url: width: 2400 }}');
    {% endif %}
    {% if mobile_image != blank %}
      --ccg-image-banner-mobile-image: url('{{ mobile_image | image_url: width: 1200 }}');
    {% endif %}
  "
>
  {%- if desktop_video != blank or mobile_video != blank -%}
    <div class="ccg-image-banner__media" aria-hidden="true">
      {%- if desktop_video != blank -%}
        {{
          desktop_video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            class: 'ccg-image-banner__video ccg-image-banner__video--desktop'
        }}
      {%- endif -%}

      {%- if mobile_video != blank -%}
        {{
          mobile_video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            class: 'ccg-image-banner__video ccg-image-banner__video--mobile'
        }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="ccg-image-banner__overlay"></div>

  <div class="section">
    <div class="ccg-image-banner__content">
      {% if banner_eyebrow != blank %}
        <p class="ccg-image-banner__eyebrow">
          {{ banner_eyebrow | escape }}
        </p>
      {% endif %}

      {% if banner_heading != blank %}
        <h1 class="ccg-image-banner__heading">
          {{ banner_heading | escape }}
        </h1>
      {% endif %}

      {% if banner_description != blank %}
        <div class="ccg-image-banner__description">
          {{ banner_description }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
    .ccg-image-banner {
        position: relative;
        width: 100%;
        height: 400px;
        min-height: 350px;
        overflow: hidden;
        background-image: var(--ccg-image-banner-image);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        align-items: end;
        padding-bottom: 49px;
    }
    .ccg-image-banner__media{
        position:absolute;
        inset:0;
        z-index:0;
    }
    .ccg-image-banner__video{
        width:100%;
        height:100%;
        object-fit:cover;
        display:block;
    }
    .ccg-image-banner__video--mobile{
        display:none;
    }
    .ccg-image-banner__overlay{
        position:absolute;
        inset:0;
        background:rgba(0,0,0,{{ section.settings.overlay_opacity }});
    }
    .ccg-image-banner__content{
        position:relative;
        z-index:2;
        max-width:720px;
        color:#efe7d9;
    }



  .ccg-image-banner__eyebrow{

    margin:0 0 10px;

    font-family:'Barlow Condensed',sans-serif;

    font-size:16px;

    letter-spacing:.35em;

    text-transform:uppercase;

    color:rgb(239,231,217);

  }



  .ccg-image-banner__heading{

    margin:0 0 10px;

    font-family:'Rye',serif;

    font-weight:400;

    font-size:52px;

    line-height:1.08;

    color:#fbf8f2;

  }



  .ccg-image-banner__description,
  .ccg-image-banner__description p{

    margin:0;

    max-width:650px;

    font-family:'Karla',sans-serif;

    font-size:17px;

    line-height:1.6;

    color:#fbf8f2;

  }



  @media(max-width:749px){

  .ccg-image-banner{

  height:400px;
  background-image:var(--ccg-image-banner-mobile-image, var(--ccg-image-banner-image));

  }

  .ccg-image-banner--has-mobile-video .ccg-image-banner__video--desktop,
  .ccg-image-banner--has-mobile-image:not(.ccg-image-banner--has-mobile-video) .ccg-image-banner__video--desktop{
  display:none;
  }

  .ccg-image-banner--has-mobile-video .ccg-image-banner__video--mobile{
  display:block;
  }


  .ccg-image-banner__heading{

  font-size:30px;

  }


  .ccg-image-banner__description,
  .ccg-image-banner__description p{

  font-size:15px;

  }


  .ccg-image-banner__eyebrow{

  font-size:12px;

  }

  }
</style>

{% schema %}
{
  "name": "CCG Image Banner Text",

  "tag": "section",

  "class": "section-wrapper",

  "settings": [
    {
      "type": "select",
      "id": "content_layout",
      "label": "Content layout",
      "options": [
        { "value": "original", "label": "Layout 1 — Original" },
        { "value": "collection", "label": "Layout 2 — Collection details" }
      ],
      "default": "original"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop background image"
    },

    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image"
    },

    {
      "type": "video",
      "id": "desktop_video",
      "label": "Desktop background video"
    },

    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile background video"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SHOP - WOOL COWLS"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wool Cowls"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Hand cut one at a time from premium American wool.</p>"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 0.8,
      "step": 0.1,
      "default": 0.5
    }
  ],

  "presets": [
    {
      "name": "CCG Image Banner Text"
    }
  ]
}
{% endschema %}
