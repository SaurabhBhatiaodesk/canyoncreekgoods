<section 
  class="ccg-image-banner"
  style="background-image:url('{{ section.settings.image | image_url: width:2400 }}');"
>

  <div class="ccg-image-banner__overlay"></div>


  <div class="ccg-image-banner__content">

    {% if section.settings.eyebrow != blank %}
      <p class="ccg-image-banner__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}


    {% if section.settings.heading != blank %}
      <h1 class="ccg-image-banner__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}


    {% if section.settings.description != blank %}
      <div class="ccg-image-banner__description">
        {{ section.settings.description }}
      </div>
    {% endif %}


  </div>

</section>



{% stylesheet %}

.ccg-image-banner{

  position:relative;

  width:100%;

  min-height:650px;

  background-size:cover;

  background-position:center;

  background-repeat:no-repeat;

  display:flex;

  align-items:center;

}



.ccg-image-banner__overlay{

  position:absolute;

  inset:0;

  background:rgba(0,0,0,{{ section.settings.overlay_opacity }});

}



.ccg-image-banner__content{

  position:relative;

  z-index:2;

  max-width:720px;

  margin-left:58px;

  color:#fff;

}



.ccg-image-banner__eyebrow{

  margin:0 0 20px;

  font-family:'Barlow Condensed',sans-serif;

  font-size:16px;

  font-weight:400;

  letter-spacing:.35em;

  text-transform:uppercase;

  color:#fff;

}



.ccg-image-banner__heading{

  margin:0 0 20px;

  font-family:'Rye',serif;

  font-weight:400;

  font-size:64px;

  line-height:1.1;

  color:#fff;

}



.ccg-image-banner__description,
.ccg-image-banner__description p{

  margin:0;

  max-width:650px;

  font-family:'Karla',sans-serif;

  font-size:22px;

  line-height:1.6;

  color:#fff;

}



@media(max-width:749px){


.ccg-image-banner{

  min-height:500px;

  background-position:center;

}


.ccg-image-banner__content{

  margin-left:25px;

  margin-right:25px;

}



.ccg-image-banner__eyebrow{

  font-size:12px;

}



.ccg-image-banner__heading{

  font-size:38px;

}



.ccg-image-banner__description,
.ccg-image-banner__description p{

  font-size:17px;

}


}


{% endstylesheet %}




{% schema %}
{
  "name": "CCG Image Banner Text",

  "settings": [

    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },


    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "SHOP - WOOL COWLS"
    },


    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wool Cowls"
    },


    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Hand cut one at a time from premium American wool. Each cowl comes from a single blanket run, so when it sells it is gone for good.</p>"
    },


    {
    "type": "range",
    "id": "overlay_opacity",
    "label": "Image overlay",
    "min": 0,
    "max": 0.8,
    "step": 0.1,
    "default": 0.5
    }

  ],


  "presets": [
    {
      "name": "CCG Image Banner Text"
    }
  ]

}
{% endschema %}