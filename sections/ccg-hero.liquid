{% liquid
  assign heading = section.settings.heading
  assign eyebrow = section.settings.eyebrow
  assign description = section.settings.description
%}

{% render 'ccg-section-spacing' %}

<div class="ccg-hero">
  <div class="ccg-hero__media">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
        {%- endif -%}
        {{
          section.settings.image
          | image_url: width: 2600
          | image_tag: widths: '750, 1100, 1500, 2000, 2600', sizes: '100vw', class: 'ccg-hero__img', alt: section.settings.image.alt | default: heading, fetchpriority: 'high'
        }}
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'ccg-hero__img placeholder' }}
    {%- endif -%}
    <div class="ccg-hero__overlay"></div>
  </div>

  <div class="ccg-hero__content">
    <div class="ccg-hero__row">
      <div class="ccg-hero__heading-col">
        {%- if eyebrow != blank -%}
          <p class="ccg-hero__eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h1 class="ccg-hero__heading">{{ heading | newline_to_br }}</h1>
        {%- endif -%}
      </div>
      <div class="ccg-hero__text-col">
        {%- if description != blank -%}
          <div class="ccg-hero__description">{{ description }}</div>
        {%- endif -%}
        {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
          <div class="ccg-hero__actions">
            {%- if section.settings.button_1_label != blank -%}
              <a
                href="{{ section.settings.button_1_link | default: '#' }}"
                class="ccg-hero__btn ccg-hero__btn--solid"
              >{{ section.settings.button_1_label }}</a>
            {%- endif -%}
            {%- if section.settings.button_2_label != blank -%}
              <a
                href="{{ section.settings.button_2_link | default: '#' }}"
                class="ccg-hero__btn ccg-hero__btn--outline"
              >{{ section.settings.button_2_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .ccg-hero {
    position: relative;
    display: grid;
    height: 700px;
    overflow: hidden;
    background: var(--ccg-sand);
    font-family: 'Karla', system-ui, sans-serif;
  }

  .ccg-hero__media,
  .ccg-hero__content {
    grid-area: 1 / 1;
  }

  .ccg-hero__media {
    position: relative;
    overflow: hidden;
  }

  .ccg-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    filter: saturate(0.92) brightness(1.04);
  }

  .ccg-hero__img.placeholder {
    height: 700px;
  }

  .ccg-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(248, 245, 238, 0.15) 0%,
      rgba(60, 48, 38, 0.12) 55%,
      rgba(38, 30, 24, 0.5) 100%
    );
  }

  .ccg-hero__content {
    position: relative;
    z-index: 2;
    align-self: end;
    padding-inline: var(--ccg-container-pad);
    padding-block: 0 56px;
    color: var(--ccg-cream);
  }

  .ccg-hero__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
  }

  .ccg-hero__heading-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 640px;
  }

  .ccg-hero__text-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 420px;
  }

  .ccg-hero__eyebrow {
    margin: 0;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ccg-cream);
  }

  .ccg-hero__heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 62px;
    line-height: 1.1;
    color: #fbf8f2;
  }

  .ccg-hero__description,
  .ccg-hero__description p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: #f1ebe0;
    text-wrap: pretty;
  }

  .ccg-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-family: 'Barlow Condensed', sans-serif;
  }

  .ccg-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 30px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 0;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .ccg-hero__btn:hover {
    opacity: 0.85;
  }

  .ccg-hero__btn--solid {
    background: var(--ccg-cream);
    color: var(--ccg-ink);
  }

  .ccg-hero__btn--outline {
    background: transparent;
    color: var(--ccg-cream);
    border: 1px solid rgba(248, 245, 238, 0.7);
  }

  @media screen and (max-width: 989px) {
    .ccg-hero__heading {
      font-size: clamp(36px, 8vw, 52px);
    }
  }

  @media screen and (max-width: 749px) {
    .ccg-hero {
      height: min(82svh, 640px);
    }

    .ccg-hero__img.placeholder {
      height: min(82svh, 640px);
    }

    .ccg-hero__content {
      padding-block: 0 32px;
    }

    .ccg-hero__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .ccg-hero__heading-col,
    .ccg-hero__text-col {
      max-width: none;
    }

    .ccg-hero__btn {
      flex: 1 1 auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Hero",
  "tag": "section",
  "class": "container ccg-flush",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "HAND CUT IN A HOME STUDIO · SNOWFLAKE, AZ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Forged for the untamed."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Heirloom-quality wool cowls, sling bags and denim, hand cut one at a time from premium American wool. No two pieces alike.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "First button label",
      "default": "Shop the cowls"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label",
      "default": "Meet the maker"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image (mobile)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ede7dc"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "CCG Hero"
    }
  ]
}
{% endschema %}
