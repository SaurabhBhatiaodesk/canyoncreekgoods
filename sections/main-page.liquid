    flex: 0 0 auto;
    padding: 15px 22px 13px;
    border: 1px solid var(--ccg-ink);
    background: var(--ccg-ink);
    color: var(--policy-paper);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .ccg-policy__contact-link:hover {
    background: transparent;
    color: var(--ccg-ink);
  }

  @media screen and (max-width: 749px) {
    .ccg-contact-page__container,
    .ccg-contact-page__body {
      width: min(100% - 36px, 1180px);
    }

    .ccg-contact-page__hero {
      padding: 28px 0 42px;
    }

    .ccg-contact-page__breadcrumbs {
      margin-bottom: 42px;
      font-size: 11px;
    }

    .ccg-contact-page__title {
      font-size: clamp(38px, 13vw, 56px);
    }

    .ccg-contact-page__intro {
      margin-top: 18px;
      font-size: 17px;
    }

    .ccg-contact-page__body {
      padding-block: 52px 60px;
    }

    .ccg-contact-page__content {
      font-size: 16px;
      line-height: 1.72;
    }

    .ccg-contact-page__content > p:first-child {
      margin-bottom: 34px;
    }

    .ccg-contact-page__content h2 {
      margin-top: 40px;
    }

    .ccg-about__container,
    .ccg-about__body {
      width: min(100% - 36px, 1180px);
    }

    .ccg-about__hero {
      padding: 28px 0 42px;
    }

    .ccg-about__breadcrumbs {
      margin-bottom: 42px;
      font-size: 11px;
    }

    .ccg-about__title {
      font-size: clamp(38px, 13vw, 56px);
    }

    .ccg-about__intro {
      margin-top: 18px;
      font-size: 17px;
    }

    .ccg-about__body {
      padding-block: 52px 64px;
    }

    .ccg-about__body-grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .ccg-about__content {
      font-size: 16px;
      line-height: 1.72;
    }

    .ccg-about__content > p:first-child {
      margin-bottom: 34px;
    }

    .ccg-about__portrait {
      position: relative;
      top: auto;
      min-height: 0;
      aspect-ratio: 4 / 5;
    }

    .ccg-policy__container,
    .ccg-policy__body,
    .ccg-policy__contact {
      width: min(100% - 36px, 1180px);
    }

    .ccg-policy__hero {
      padding: 28px 0 36px;
    }

    .ccg-policy__breadcrumbs {
      margin-bottom: 42px;
      font-size: 11px;
    }

    .ccg-policy__title {
      font-size: clamp(38px, 13vw, 56px);
    }

    .ccg-policy__intro {
      margin-top: 18px;
      font-size: 17px;
    }

    .ccg-policy__highlights {
      grid-template-columns: 1fr;
      margin-top: 38px;
    }

    .ccg-policy__highlight,
    .ccg-policy__highlight:first-child {
      padding: 18px 0;
      border-right: 0;
      border-bottom: 1px solid var(--policy-rule);
    }

    .ccg-policy__highlight:last-child {
      border-bottom: 0;
    }

    .ccg-policy__body {
      padding-block: 52px 60px;
    }

    .ccg-policy__content {
      font-size: 16px;
      line-height: 1.72;
    }

    .ccg-policy__content > p:nth-child(2) {
      margin-bottom: 42px;
    }

    .ccg-policy__content h2 {
      margin-top: 44px;
    }

    .ccg-policy__content li {
      padding: 16px 18px 16px 42px;
    }

    .ccg-policy__content li::before {
      left: 17px;
    }

    .ccg-policy__contact {
      align-items: flex-start;
      flex-direction: column;
      padding-block: 44px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "page_layout",
      "label": "Page layout",
      "options": [
        {
          "value": "original",
          "label": "Layout 1 — Original"
        },
        {
          "value": "policy",
          "label": "Layout 2 — Branded policy"
        },
        {
          "value": "faq",
          "label": "Layout 3 — FAQ accordion"
        },
        {
          "value": "about",
          "label": "Layout 4 — About Us"
        },
        {
          "value": "contact",
          "label": "Layout 5 — Contact Us"
        }
      ],
      "default": "original"
    },
    {
      "type": "text",
      "id": "contact_page_eyebrow",
      "label": "Eyebrow",
      "default": "Let's talk",
      "visible_if": "{{ section.settings.page_layout == 'contact' }}"
    },
    {
      "type": "richtext",
      "id": "contact_page_intro",
      "label": "Introduction",
      "visible_if": "{{ section.settings.page_layout == 'contact' }}"
    },
    {
      "type": "text",
      "id": "about_eyebrow",
      "label": "Eyebrow",
      "default": "Meet the maker",
      "visible_if": "{{ section.settings.page_layout == 'about' }}"
    },
    {
      "type": "richtext",
      "id": "about_intro",
      "label": "Introduction",
      "default": "<p>Handmade in Snowflake, Arizona, for women who carry the spirit of the West wherever life takes them.</p>",
      "visible_if": "{{ section.settings.page_layout == 'about' }}"
    },
    {
      "type": "text",
      "id": "policy_eyebrow",
      "label": "Eyebrow",
      "default": "Shipping & delivery",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "richtext",
      "id": "policy_intro",
      "label": "Introduction",
      "default": "<p>Handmade in Arizona and packed with care. Here is everything you need to know about processing, delivery, and getting your order home.</p>",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "checkbox",
      "id": "show_policy_highlights",
      "label": "Show quick facts",
      "default": true,
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "highlight_1_label",
      "label": "Quick fact 1 heading",
      "default": "Ready to ship",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "highlight_1_text",
      "label": "Quick fact 1 text",
      "default": "Leaves the studio in 1–3 business days",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "highlight_2_label",
      "label": "Quick fact 2 heading",
      "default": "Made to order",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "highlight_2_text",
      "label": "Quick fact 2 text",
      "default": "Created by hand in approximately 1–2 weeks",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "highlight_3_label",
      "label": "Quick fact 3 heading",
      "default": "US shipping",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "highlight_3_text",
      "label": "Quick fact 3 text",
      "default": "Free sitewide with tracking included",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "checkbox",
      "id": "show_contact_cta",
      "label": "Show contact callout",
      "default": true,
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "contact_eyebrow",
      "label": "Contact eyebrow",
      "default": "Need a hand?",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Questions about your order?",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
