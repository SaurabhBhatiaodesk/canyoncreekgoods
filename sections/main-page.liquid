{% liquid
  if section.settings.background_color != blank and section.settings.page_layout == 'original'
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% if section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' %}
  <section class="ccg-policy">
    <div class="ccg-policy__hero">
      <div class="ccg-policy__container">
        <nav class="ccg-policy__breadcrumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span aria-hidden="true">/</span>
          <span>{{ page.title }}</span>
        </nav>

        {% if section.settings.policy_eyebrow != blank %}
          <p class="ccg-policy__eyebrow">{{ section.settings.policy_eyebrow }}</p>
        {% endif %}

        <h1 class="ccg-policy__title">{{ page.title }}</h1>

        {% if section.settings.policy_intro != blank %}
          <div class="ccg-policy__intro">{{ section.settings.policy_intro }}</div>
        {% endif %}

        {% if section.settings.show_policy_highlights %}
          <div class="ccg-policy__highlights" role="list">
            {% for i in (1..3) %}
              {% liquid
                assign label_key = 'highlight_' | append: i | append: '_label'
                assign text_key = 'highlight_' | append: i | append: '_text'
                assign highlight_label = section.settings[label_key]
                assign highlight_text = section.settings[text_key]
              %}
              {% if highlight_label != blank or highlight_text != blank %}
                <div class="ccg-policy__highlight" role="listitem">
                  <span class="ccg-policy__highlight-number">0{{ i }}</span>
                  <div>
                    {% if highlight_label != blank %}
                      <strong>{{ highlight_label }}</strong>
                    {% endif %}
                    {% if highlight_text != blank %}
                      <span>{{ highlight_text }}</span>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ccg-policy__body">
      <article class="ccg-policy__content rte">
        {% if section.settings.page_layout == 'faq' %}
<div class="ccg-faq" data-ccg-faq>{{ page.content }}</div>
<style>
#shopify-section-{{ section.id }} .ccg-faq h2{font-size:32px;margin:48px 0 12px;border-top:0;padding-top:0}#shopify-section-{{ section.id }} .ccg-faq__item{border:0;border-bottom:1px solid #cfc5b5;interpolate-size:allow-keywords}#shopify-section-{{ section.id }} .ccg-faq__item::details-content{block-size:0;opacity:0;overflow:hidden;transition:block-size .35s ease,opacity .25s ease,content-visibility .35s;transition-behavior:allow-discrete}#shopify-section-{{ section.id }} .ccg-faq__item[open]::details-content{block-size:auto;opacity:1}#shopify-section-{{ section.id }} .ccg-faq__item summary{cursor:pointer;list-style:none;padding:20px 42px 20px 0;font-size:18px;font-weight:700;color:#211c17;position:relative}#shopify-section-{{ section.id }} .ccg-faq__item summary::-webkit-details-marker{display:none}#shopify-section-{{ section.id }} .ccg-faq__item summary:after{content:'+';position:absolute;right:4px;font-size:26px;font-weight:400}#shopify-section-{{ section.id }} .ccg-faq__item[open] summary:after{content:'−'}#shopify-section-{{ section.id }} .ccg-faq__answer{padding:0 42px 20px 0}
</style>
<script>
(()=>{const r=document.querySelector('#shopify-section-{{ section.id }} [data-ccg-faq]');if(!r)return;let d;[...r.children].forEach(e=>{const s=e.tagName==='P'&&e.firstElementChild?.tagName==='STRONG'&&e.firstElementChild.textContent.trim().endsWith('?');if(e.tagName==='H2'){d=null;return}if(s){d=document.createElement('details');d.className='ccg-faq__item';const q=document.createElement('summary'),a=document.createElement('div'),st=e.firstElementChild;q.textContent=st.textContent.trim();a.className='ccg-faq__answer';d.append(q,a);e.before(d);st.remove();if(e.firstElementChild?.tagName==='BR')e.firstElementChild.remove();e.textContent.trim()?a.append(e):e.remove()}else if(d)d.lastElementChild.append(e)});r.querySelectorAll('p').forEach(p=>{if(p.innerHTML.includes('[Contact Page]'))p.innerHTML=p.innerHTML.replace('[Contact Page]','<a href="/pages/contact">Contact Page</a>')})})();
</script>
{% else %}
{{ page.content }}
{% endif %}
      </article>
    </div>

    {% if section.settings.show_contact_cta %}
      <div class="ccg-policy__contact">
        <div>
          <p class="ccg-policy__eyebrow">{{ section.settings.contact_eyebrow }}</p>
          <h2>{{ section.settings.contact_heading }}</h2>
          <p>{{ section.settings.contact_text }}</p>
        </div>
        <a class="ccg-policy__contact-link" href="mailto:{{ section.settings.contact_email }}">
          {{ section.settings.contact_button }}
        </a>
      </div>
    {% endif %}
  </section>
{% else %}
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div class="section page-width-content{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--column
        section-content-wrapper
        mobile-column
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      "
    >
      {% content_for 'blocks' %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .ccg-policy {
    --policy-paper: #f7f3ec;
    --policy-card: #ede7dc;
    --policy-rule: rgba(45, 39, 32, 0.2);
    background: var(--policy-paper);
    color: var(--ccg-ink);
    font-family: 'Karla', system-ui, sans-serif;
  }

  .ccg-policy__container,
  .ccg-policy__body,
  .ccg-policy__contact {
    width: min(1180px, calc(100% - 80px));
    margin-inline: auto;
  }

  .ccg-policy__hero {
    padding: 42px 0 56px;
    border-bottom: 1px solid var(--policy-rule);
    background:
      linear-gradient(135deg, rgba(185, 138, 82, 0.1), transparent 46%),
      var(--ccg-sand);
  }

  .ccg-policy__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 62px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ccg-policy__breadcrumbs a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .ccg-policy__breadcrumbs span:last-child {
    color: var(--ccg-muted);
  }

  .ccg-policy__eyebrow {
    margin: 0 0 14px;
    color: var(--ccg-tan);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    letter-spacing: 0.24em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ccg-policy__title {
    max-width: 760px;
    margin: 0;
    color: var(--ccg-ink);
    font-family: 'Rye', serif;
    font-size: clamp(42px, 6vw, 78px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .ccg-policy__intro {
    max-width: 650px;
    margin-top: 24px;
    color: var(--ccg-muted);
    font-size: 19px;
    line-height: 1.7;
  }

  .ccg-policy__intro p {
    margin: 0;
  }

  .ccg-policy__highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 52px;
    border-top: 1px solid var(--policy-rule);
    border-bottom: 1px solid var(--policy-rule);
  }

  .ccg-policy__highlight {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    padding: 22px 28px;
    border-right: 1px solid var(--policy-rule);
  }

  .ccg-policy__highlight:first-child {
    padding-left: 0;
  }

  .ccg-policy__highlight:last-child {
    border-right: 0;
  }

  .ccg-policy__highlight-number {
    color: var(--ccg-tan);
    font-family: 'Rye', serif;
    font-size: 15px;
  }

  .ccg-policy__highlight strong,
  .ccg-policy__highlight span:not(.ccg-policy__highlight-number) {
    display: block;
  }

  .ccg-policy__highlight strong {
    margin-bottom: 3px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ccg-policy__highlight span:not(.ccg-policy__highlight-number) {
    color: var(--ccg-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .ccg-policy__body {
    padding-block: 78px 88px;
  }

  .ccg-policy__content {
    max-width: 820px;
    margin-inline: auto;
    color: var(--ccg-muted);
    font-size: 17px;
    line-height: 1.8;
  }

  .ccg-policy__content > p:first-child {
    width: fit-content;
    margin: 0 0 24px;
    padding: 7px 12px;
    border: 1px solid var(--policy-rule);
    color: var(--ccg-muted);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ccg-policy__content > p:nth-child(2) {
    margin-bottom: 54px;
    color: var(--ccg-ink);
    font-family: 'Rye', serif;
    font-size: clamp(22px, 3vw, 32px);
    line-height: 1.45;
  }

  .ccg-policy__content h2 {
    margin: 56px 0 18px;
    padding-top: 24px;
    border-top: 1px solid var(--policy-rule);
    color: var(--ccg-ink);
    font-family: 'Rye', serif;
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 400;
    line-height: 1.25;
  }

  .ccg-policy__content p {
    margin: 0 0 20px;
  }

  .ccg-policy__content ul,
  .ccg-policy__content ol {
    display: grid;
    gap: 12px;
    margin: 18px 0 26px;
    padding: 0;
    list-style: none;
  }

  .ccg-policy__content li {
    position: relative;
    padding: 18px 22px 18px 48px;
    border: 1px solid var(--policy-rule);
    background: var(--policy-card);
  }

  .ccg-policy__content li::before {
    content: '◆';
    position: absolute;
    top: 20px;
    left: 20px;
    color: var(--ccg-tan);
    font-size: 10px;
  }

  .ccg-policy__content strong {
    color: var(--ccg-ink);
    font-weight: 600;
  }

  .ccg-policy__content a {
    color: var(--ccg-ink);
    text-decoration-color: var(--ccg-tan);
    text-underline-offset: 4px;
  }

  .ccg-policy__content h2:last-of-type + p {
    padding: 24px;
    border-left: 3px solid var(--ccg-tan);
    background: var(--policy-card);
  }

  .ccg-policy__contact {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 36px;
    padding-block: 56px;
    border-top: 1px solid var(--policy-rule);
  }

  .ccg-policy__contact h2 {
    margin: 0 0 8px;
    color: var(--ccg-ink);
    font-family: 'Rye', serif;
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 400;
  }

  .ccg-policy__contact p:not(.ccg-policy__eyebrow) {
    max-width: 600px;
    margin: 0;
    color: var(--ccg-muted);
    font-size: 16px;
    line-height: 1.6;
  }

  .ccg-policy__contact-link {
    flex: 0 0 auto;
    padding: 15px 22px 13px;
    border: 1px solid var(--ccg-ink);
    background: var(--ccg-ink);
    color: var(--policy-paper);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .ccg-policy__contact-link:hover {
    background: transparent;
    color: var(--ccg-ink);
  }

  @media screen and (max-width: 749px) {
    .ccg-policy__container,
    .ccg-policy__body,
    .ccg-policy__contact {
      width: min(100% - 36px, 1180px);
    }

    .ccg-policy__hero {
      padding: 28px 0 36px;
    }

    .ccg-policy__breadcrumbs {
      margin-bottom: 42px;
      font-size: 11px;
    }

    .ccg-policy__title {
      font-size: clamp(38px, 13vw, 56px);
    }

    .ccg-policy__intro {
      margin-top: 18px;
      font-size: 17px;
    }

    .ccg-policy__highlights {
      grid-template-columns: 1fr;
      margin-top: 38px;
    }

    .ccg-policy__highlight,
    .ccg-policy__highlight:first-child {
      padding: 18px 0;
      border-right: 0;
      border-bottom: 1px solid var(--policy-rule);
    }

    .ccg-policy__highlight:last-child {
      border-bottom: 0;
    }

    .ccg-policy__body {
      padding-block: 52px 60px;
    }

    .ccg-policy__content {
      font-size: 16px;
      line-height: 1.72;
    }

    .ccg-policy__content > p:nth-child(2) {
      margin-bottom: 42px;
    }

    .ccg-policy__content h2 {
      margin-top: 44px;
    }

    .ccg-policy__content li {
      padding: 16px 18px 16px 42px;
    }

    .ccg-policy__content li::before {
      left: 17px;
    }

    .ccg-policy__contact {
      align-items: flex-start;
      flex-direction: column;
      padding-block: 44px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "page_layout",
      "label": "Page layout",
      "options": [
        {
          "value": "original",
          "label": "Layout 1 — Original"
        },
        {
          "value": "policy",
          "label": "Layout 2 — Branded policy"
        },
        {
          "value": "faq",
          "label": "Layout 3 — FAQ accordion"
        }
      ],
      "default": "original"
    },
    {
      "type": "header",
      "content": "Layout 2 — Branded policy"
    },
    {
      "type": "text",
      "id": "policy_eyebrow",
      "label": "Eyebrow",
      "default": "Shipping & delivery",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "richtext",
      "id": "policy_intro",
      "label": "Introduction",
      "default": "<p>Handmade in Arizona and packed with care. Here is everything you need to know about processing, delivery, and getting your order home.</p>",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "checkbox",
      "id": "show_policy_highlights",
      "label": "Show quick facts",
      "default": true,
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "highlight_1_label",
      "label": "Quick fact 1 heading",
      "default": "Ready to ship",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "highlight_1_text",
      "label": "Quick fact 1 text",
      "default": "Leaves the studio in 1–3 business days",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "highlight_2_label",
      "label": "Quick fact 2 heading",
      "default": "Made to order",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "highlight_2_text",
      "label": "Quick fact 2 text",
      "default": "Created by hand in approximately 1–2 weeks",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "highlight_3_label",
      "label": "Quick fact 3 heading",
      "default": "US shipping",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "highlight_3_text",
      "label": "Quick fact 3 text",
      "default": "Free sitewide with tracking included",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "checkbox",
      "id": "show_contact_cta",
      "label": "Show contact callout",
      "default": true,
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "contact_eyebrow",
      "label": "Contact eyebrow",
      "default": "Need a hand?",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Questions about your order?",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "textarea",
      "id": "contact_text",
      "label": "Contact text",
      "default": "Send Melissa a note before ordering if you are working toward a special date or need help choosing a shipping option.",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "canyoncreekgoods@gmail.com",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "text",
      "id": "contact_button",
      "label": "Contact button",
      "default": "Email Melissa",
      "visible_if": "{{ section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' }}"
    },
    {
      "type": "header",
      "content": "Layout 1 — Original"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.page_layout == 'original' and section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.page_layout == 'original' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.page_layout == 'original' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding",
      "visible_if": "{{ section.settings.page_layout == 'original' }}"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.page_layout == 'original' }}"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.page_layout == 'original' }}"
    }
  ]
}
{% endschema %}