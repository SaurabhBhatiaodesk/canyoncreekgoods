  }

  .ccg-about__content a {
    color: var(--ccg-ink);
    text-decoration-color: var(--ccg-tan);
    text-underline-offset: 4px;
  }

  .ccg-about__portrait {
    position: sticky;
    top: 32px;
    min-height: 560px;
    overflow: hidden;
    border: 1px solid var(--about-rule);
    background: rgba(185, 138, 82, 0.12);
  }

  .ccg-about__portrait::after {
    content: '';
    position: absolute;
    inset: 14px;
    z-index: 1;
    border: 1px solid rgba(247, 243, 236, 0.65);
    pointer-events: none;
  }

  .ccg-about__portrait > img,
  .ccg-about__portrait > p,
  .ccg-about__portrait > p > img {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .ccg-about__portrait img {
    position: absolute;
    inset: 0;
    object-fit: cover;
