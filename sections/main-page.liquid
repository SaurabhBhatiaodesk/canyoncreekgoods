{% liquid
  if section.settings.background_color != blank and section.settings.page_layout == 'original'
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% if section.settings.page_layout == 'contact' or page.handle == 'contact' %}
  <section class="ccg-contact-page">
    <div class="ccg-contact-page__hero">
      <div class="ccg-contact-page__container">
        <nav class="ccg-contact-page__breadcrumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span aria-hidden="true">/</span>
          <span>{{ page.title }}</span>
        </nav>

        {% if section.settings.contact_page_eyebrow != blank %}
          <p class="ccg-contact-page__eyebrow">{{ section.settings.contact_page_eyebrow }}</p>
        {% endif %}

        <h1 class="ccg-contact-page__title">{{ page.title }}</h1>

        {% if section.settings.contact_page_intro != blank %}
          <div class="ccg-contact-page__intro">{{ section.settings.contact_page_intro }}</div>
        {% endif %}
      </div>
    </div>

    <div class="ccg-contact-page__body">
      <article class="ccg-contact-page__content rte">
        {{ page.content }}
      </article>
    </div>
  </section>
{% elsif section.settings.page_layout == 'about' or page.handle == 'about-me' %}
  <section class="ccg-about">
    <div class="ccg-about__hero">
      <div class="ccg-about__container">
        <nav class="ccg-about__breadcrumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span aria-hidden="true">/</span>
          <span>{{ page.title }}</span>
        </nav>

        {% if section.settings.about_eyebrow != blank %}
          <p class="ccg-about__eyebrow">{{ section.settings.about_eyebrow }}</p>
        {% endif %}

        <h1 class="ccg-about__title">{{ page.title }}</h1>

        {% if section.settings.about_intro != blank %}
          <div class="ccg-about__intro">{{ section.settings.about_intro }}</div>
        {% endif %}
      </div>
    </div>

    <div class="ccg-about__body">
      <div class="ccg-about__body-grid">
        <article class="ccg-about__content rte" data-about-content>
          {{ page.content }}
        </article>

        <div class="ccg-about__portrait" data-about-portrait aria-label="Portrait of Melissa"></div>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const root = document.querySelector('#shopify-section-{{ section.id }} .ccg-about');
      if (!root) return;

      const content = root.querySelector('[data-about-content]');
      const portrait = root.querySelector('[data-about-portrait]');
      const image = content?.querySelector('img');
      if (!content || !portrait || !image) return;

      const wrapper = image.parentElement;
      const imageNode =
        wrapper?.tagName === 'P' && wrapper.children.length === 1
          ? wrapper
          : image;

      portrait.append(imageNode);
      portrait.classList.add('ccg-about__portrait--ready');
    })();
  </script>
{% elsif section.settings.page_layout == 'policy' or section.settings.page_layout == 'faq' %}
  <section class="ccg-policy">
    <div class="ccg-policy__hero">
      <div class="ccg-policy__container">
        <nav class="ccg-policy__breadcrumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span aria-hidden="true">/</span>
          <span>{{ page.title }}</span>
        </nav>

        {% if section.settings.policy_eyebrow != blank %}
          <p class="ccg-policy__eyebrow">{{ section.settings.policy_eyebrow }}</p>
        {% endif %}

        <h1 class="ccg-policy__title">{{ page.title }}</h1>

        {% if section.settings.policy_intro != blank %}
          <div class="ccg-policy__intro">{{ section.settings.policy_intro }}</div>
        {% endif %}

        {% if section.settings.show_policy_highlights %}
          <div class="ccg-policy__highlights" role="list">
            {% for i in (1..3) %}
              {% liquid
                assign label_key = 'highlight_' | append: i | append: '_label'
                assign text_key = 'highlight_' | append: i | append: '_text'
                assign highlight_label = section.settings[label_key]
                assign highlight_text = section.settings[text_key]
              %}
              {% if highlight_label != blank or highlight_text != blank %}
                <div class="ccg-policy__highlight" role="listitem">
                  <span class="ccg-policy__highlight-number">0{{ i }}</span>
                  <div>
                    {% if highlight_label != blank %}
                      <strong>{{ highlight_label }}</strong>
                    {% endif %}
                    {% if highlight_text != blank %}
                      <span>{{ highlight_text }}</span>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ccg-policy__body">
      <article class="ccg-policy__content rte">
        {% if section.settings.page_layout == 'faq' %}
<div class="ccg-faq" data-ccg-faq>{{ page.content }}</div>
<style>
#shopify-section-{{ section.id }} .ccg-faq h2{font-size:32px;margin:48px 0 12px;border-top:0;padding-top:0}#shopify-section-{{ section.id }} .ccg-faq__item{border:0;border-bottom:1px solid #cfc5b5;interpolate-size:allow-keywords}#shopify-section-{{ section.id }} .ccg-faq__item::details-content{block-size:0;opacity:0;overflow:hidden;transition:block-size .35s ease,opacity .25s ease,content-visibility .35s;transition-behavior:allow-discrete}#shopify-section-{{ section.id }} .ccg-faq__item[open]::details-content{block-size:auto;opacity:1}#shopify-section-{{ section.id }} .ccg-faq__item summary{cursor:pointer;list-style:none;padding:20px 42px 20px 0;font-size:18px;font-weight:700;color:#211c17;position:relative}#shopify-section-{{ section.id }} .ccg-faq__item summary::-webkit-details-marker{display:none}#shopify-section-{{ section.id }} .ccg-faq__item summary:after{content:'+';position:absolute;right:4px;font-size:26px;font-weight:400}#shopify-section-{{ section.id }} .ccg-faq__item[open] summary:after{content:'−'}#shopify-section-{{ section.id }} .ccg-faq__answer{padding:0 42px 20px 0}
</style>
<script>
(()=>{const r=document.querySelector('#shopify-section-{{ section.id }} [data-ccg-faq]');if(!r)return;let d;[...r.children].forEach(e=>{const s=e.tagName==='P'&&e.firstElementChild?.tagName==='STRONG'&&e.firstElementChild.textContent.trim().endsWith('?');if(e.tagName==='H2'){d=null;return}if(s){d=document.createElement('details');d.className='ccg-faq__item';const q=document.createElement('summary'),a=document.createElement('div'),st=e.firstElementChild;q.textContent=st.textContent.trim();a.className='ccg-faq__answer';d.append(q,a);e.before(d);st.remove();if(e.firstElementChild?.tagName==='BR')e.firstElementChild.remove();e.textContent.trim()?a.append(e):e.remove()}else if(d)d.lastElementChild.append(e)});r.querySelectorAll('p').forEach(p=>{if(p.innerHTML.includes('[Contact Page]'))p.innerHTML=p.innerHTML.replace('[Contact Page]','<a href="/pages/contact">Contact Page</a>')})})();
</script>
{% else %}
{{ page.content }}
{% endif %}
      </article>
    </div>

    {% if section.settings.show_contact_cta %}
      <div class="ccg-policy__contact">
        <div>
          <p class="ccg-policy__eyebrow">{{ section.settings.contact_eyebrow }}</p>
          <h2>{{ section.settings.contact_heading }}</h2>
          <p>{{ section.settings.contact_text }}</p>
        </div>
        <a class="ccg-policy__contact-link" href="mailto:{{ section.settings.contact_email }}">
          {{ section.settings.contact_button }}
        </a>
      </div>
    {% endif %}
  </section>
{% else %}
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div class="section page-width-content{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--column
        section-content-wrapper
        mobile-column
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      "
    >
      {% content_for 'blocks' %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .ccg-contact-page {
    --contact-paper: #ede7dc;
    --contact-sand: #f3ede2;
    --contact-card: #f7f3ec;
    --contact-rule: rgba(45, 39, 32, 0.2);
    background: var(--contact-paper);
    color: var(--ccg-ink);
    font-family: 'Karla', system-ui, sans-serif;
  }

  .ccg-contact-page__container {
    width: min(1180px, calc(100% - 80px));
    margin-inline: auto;
  }

  .ccg-contact-page__hero {
    padding: 42px 0 68px;
    border-bottom: 1px solid var(--contact-rule);
    background:
      linear-gradient(135deg, rgba(185, 138, 82, 0.12), transparent 48%),
      var(--contact-sand);
  }

  .ccg-contact-page__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 62px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ccg-contact-page__breadcrumbs a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .ccg-contact-page__breadcrumbs span:last-child {
    color: var(--ccg-muted);
  }

  .ccg-contact-page__eyebrow {
    margin: 0 0 14px;
    color: var(--ccg-tan);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    letter-spacing: 0.24em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ccg-contact-page__title {
    max-width: 900px;
    margin: 0;
    color: var(--ccg-ink);
    font-family: 'Rye', serif;
    font-size: clamp(42px, 6vw, 78px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .ccg-contact-page__intro {
    max-width: 680px;
    margin-top: 24px;
    color: var(--ccg-muted);
    font-size: 19px;
    line-height: 1.7;
  }

  .ccg-contact-page__intro p {
    margin: 0;
  }

  .ccg-contact-page__body {
    width: min(1040px, calc(100% - 80px));
    margin-inline: auto;
    padding-block: 72px 84px;
  }

  .ccg-contact-page__content {
    color: var(--ccg-muted);
    font-size: 17px;
    line-height: 1.78;
  }

  .ccg-contact-page__content > p:first-child {
    max-width: 760px;
    margin: 0 0 42px;
    color: var(--ccg-ink);
    font-family: 'Rye', serif;
    font-size: clamp(22px, 2.6vw, 31px);
    line-height: 1.5;
  }

  .ccg-contact-page__content > p {
    margin: 0 0 24px;
  }

  .ccg-contact-page__content h2 {
    margin: 48px 0 16px;
    color: var(--ccg-ink);
    font-family: 'Rye', serif;
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 400;
    line-height: 1.25;
  }

  .ccg-contact-page__content hr {
    margin: 46px 0;
    border: 0;
    border-top: 1px solid var(--contact-rule);
  }

  .ccg-contact-page__content ul,
  .ccg-contact-page__content ol {
    display: grid;
    gap: 12px;
    margin: 18px 0 26px;
    padding: 0;
    list-style: none;
  }

  .ccg-contact-page__content li {
    position: relative;
    padding-left: 28px;
  }

  .ccg-contact-page__content li::before {
    content: '◆';
    position: absolute;
    top: 7px;
    left: 0;
    color: var(--ccg-tan);
    font-size: 9px;
  }

  .ccg-contact-page__content strong {
    color: var(--ccg-ink);
    font-weight: 600;
  }

  .ccg-contact-page__content a {
    color: var(--ccg-ink);
    text-decoration-color: var(--ccg-tan);
    text-underline-offset: 4px;
  }

