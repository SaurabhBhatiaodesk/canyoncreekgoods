{% render 'ccg-section-spacing' %}

{%- liquid
  case section.settings.image_ratio
    when 'square'
      assign ccg_sellers_ratio = '1 / 1'
    when 'portrait'
      assign ccg_sellers_ratio = '3 / 4'
    when 'landscape'
      assign ccg_sellers_ratio = '4 / 3'
    when 'wide'
      assign ccg_sellers_ratio = '16 / 9'
    else
      assign ccg_sellers_ratio = '3 / 4'
  endcase
-%}

{%- capture ccg_rec_cards -%}
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {%- for rec_product in recommendations.products limit: section.settings.product_limit -%}
      {%- liquid
        assign badge = rec_product.metafields.custom.custom_product_tag.value
        assign second_image = rec_product.images[1]
      -%}
      <a href="{{ rec_product.url }}" class="ccg-seller-card">
        <span class="ccg-seller-card__media{% if second_image != blank %} ccg-seller-card__media--has-alt{% endif %}">
          {%- if rec_product.featured_image != blank -%}
            {{
              rec_product.featured_image
              | image_url: width: 800
              | image_tag: widths: '300, 500, 800', alt: rec_product.title, class: 'ccg-seller-card__img ccg-seller-card__img--primary'
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          {%- if second_image != blank -%}
            {{
              second_image
              | image_url: width: 800
              | image_tag: widths: '300, 500, 800', alt: rec_product.title, class: 'ccg-seller-card__img ccg-seller-card__img--secondary'
            }}
          {%- endif -%}
          {%- if badge != blank -%}
            <span class="ccg-seller-card__badge">{{ badge }}</span>
          {%- endif -%}
        </span>
        <span class="ccg-seller-card__meta">
          <span class="ccg-seller-card__title">{{ rec_product.title }}</span>
          <span class="ccg-seller-card__price">{{ rec_product.price | money }}</span>
        </span>
      </a>
    {%- endfor -%}
  {%- elsif recommendations.performed -%}
    {%- for rec_product in collections.all.products limit: section.settings.product_limit -%}
      {%- if rec_product.id != product.id -%}
        {%- liquid
          assign badge = rec_product.metafields.custom.custom_product_tag.value
          assign second_image = rec_product.images[1]
        -%}
        <a href="{{ rec_product.url }}" class="ccg-seller-card">
          <span class="ccg-seller-card__media{% if second_image != blank %} ccg-seller-card__media--has-alt{% endif %}">
            {%- if rec_product.featured_image != blank -%}
              {{
                rec_product.featured_image
                | image_url: width: 800
                | image_tag: widths: '300, 500, 800', alt: rec_product.title, class: 'ccg-seller-card__img ccg-seller-card__img--primary'
              }}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
            {%- if second_image != blank -%}
              {{
                second_image
                | image_url: width: 800
                | image_tag: widths: '300, 500, 800', alt: rec_product.title, class: 'ccg-seller-card__img ccg-seller-card__img--secondary'
              }}
            {%- endif -%}
            {%- if badge != blank -%}
              <span class="ccg-seller-card__badge">{{ badge }}</span>
            {%- endif -%}
          </span>
          <span class="ccg-seller-card__meta">
            <span class="ccg-seller-card__title">{{ rec_product.title }}</span>
            <span class="ccg-seller-card__price">{{ rec_product.price | money }}</span>
          </span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div
  class="ccg-sellers section"
  data-ccg-pdp-recommendations="{{ section.id }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.product_limit }}&intent=related"
  style="--ccg-sellers-ratio: {{ ccg_sellers_ratio }};"
  {% if ccg_rec_cards == blank %}hidden{% endif %}
>
  <div class="ccg-sellers__inner">
    <div class="ccg-sellers__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="ccg-sellers__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="ccg-sellers__note">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
    </div>

    <div class="ccg-sellers__grid" data-ccg-pdp-recommendations-content>
      {{ ccg_rec_cards }}
    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.querySelector('[data-ccg-pdp-recommendations="{{ section.id }}"]');
    if (!section || section.getAttribute('data-ccg-pdp-recommendations-loaded') === 'true') return;

    var url = section.getAttribute('data-url');
    var target = section.querySelector('[data-ccg-pdp-recommendations-content]');
    if (!url || !target) return;

    section.setAttribute('data-ccg-pdp-recommendations-loaded', 'true');

    fetch(url, { credentials: 'same-origin' })
      .then(function (response) {
        if (!response.ok) throw new Error('Failed to load recommendations');
        return response.text();
      })
      .then(function (text) {
        var html = document.createElement('div');
        html.innerHTML = text;
        var source = html.querySelector('[data-ccg-pdp-recommendations-content]');

        if (source && source.innerHTML.trim().length) {
          target.innerHTML = source.innerHTML;
          section.hidden = false;
        } else if (window.Shopify && window.Shopify.designMode) {
          section.hidden = false;
        }
      })
      .catch(function (error) {
        console.warn('[ccg-pdp-recommendations] Failed to render recommendations:', error);
      });
  })();
</script>

{% stylesheet %}
  .ccg-sellers {
    font-family: 'Karla', system-ui, sans-serif;
  }

  .ccg-sellers__inner {
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  .ccg-sellers__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    border: 0;
    padding: 0;
  }

  .ccg-sellers__heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 33px;
    color: var(--ccg-ink);
  }
  .ccg-sellers__note {
      margin: 0;
      font-family: Barlow Condensed,sans-serif;
      font-weight: 400;
      text-transform: uppercase;
      white-space: nowrap;
      font-size: 18px;
      letter-spacing: 0.12em;
      color: rgb(138, 90, 50);
      text-decoration: none;
      border-bottom: 1px solid rgba(138, 90, 50, 0.5);
      padding-bottom: 3px;
  }
  .ccg-sellers__note a{
    text-decoration: none;
    color: rgb(138, 90, 50);
  }
  .ccg-sellers__note a:hover{
    color: rgb(138, 90, 50) !important;
  }

  .ccg-sellers__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .ccg-seller-card {
    display: flex;
    flex-direction: column;
    gap: 13px;
    text-decoration: none;
    color: var(--ccg-ink);
  }

  .ccg-seller-card__media {
    position: relative;
    display: block;
    aspect-ratio: var(--ccg-sellers-ratio, 3 / 4);
    overflow: hidden;
    background: var(--ccg-sand);
  }

  .ccg-seller-card__media img,
  .ccg-seller-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .ccg-seller-card:hover .ccg-seller-card__media img {
    transform: scale(1.04);
  }

  .ccg-seller-card__media--has-alt .ccg-seller-card__img {
    position: absolute;
    inset: 0;
    transition: transform 0.5s ease, opacity 0.4s ease;
  }

  .ccg-seller-card__media--has-alt .ccg-seller-card__img--secondary {
    opacity: 0;
  }

  .ccg-seller-card:hover .ccg-seller-card__media--has-alt .ccg-seller-card__img--primary {
    opacity: 0;
  }

  .ccg-seller-card:hover .ccg-seller-card__media--has-alt .ccg-seller-card__img--secondary {
    opacity: 1;
  }

  .ccg-seller-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.16em;
    background: var(--ccg-cream-soft);
    color: var(--ccg-ink);
    padding: 5px 11px;
    text-transform: uppercase;
  }

  .ccg-seller-card__meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ccg-seller-card__title {
    font-size: 17px;
    line-height: 1.35;
    color: var(--ccg-ink);
  }

  .ccg-seller-card__price {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px;
    letter-spacing: 0.08em;
    color: var(--ccg-stone);
  }

  @media screen and (max-width: 989px) {
    .ccg-sellers__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ccg-sellers__inner {
      gap: 24px;
    }

    .ccg-sellers__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .ccg-sellers__heading {
      font-size: 22px;
    }

    .ccg-sellers__note {
      white-space: normal;
      font-size: 15px;
    }

    .ccg-sellers__grid {
      gap: 14px;
    }

    .ccg-seller-card {
      gap: 8px;
    }

    .ccg-seller-card__meta {
      gap: 2px;
    }

    .ccg-seller-card__title {
      font-size: 15px;
      line-height: 1.3;
    }

    .ccg-seller-card__price {
      font-size: 14px;
    }

    .ccg-seller-card__badge {
      font-size: 10px;
      padding: 4px 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Recommended product",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Uses Shopify's own product recommendation engine for the current product - same visual design as Ready to Ride Out. Section hides itself automatically if Shopify has no recommendations for this product."
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Note (right side)",
      "default": "YOU MAY ALSO LIKE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete your kit"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "wide", "label": "Wide (16:9)" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f5ee"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "CCG Recommended product",
      "category": "Products"
    }
  ]
}
{% endschema %}
