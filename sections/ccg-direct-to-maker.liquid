{% render 'ccg-section-spacing' %}

<div class="ccg-dtm ccg-dtm--{{ section.settings.media_position }}">
  <div class="ccg-dtm__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ccg-dtm__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ccg-dtm__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="ccg-dtm__description">{{ section.settings.description }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="ccg-dtm__link">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>

  <div class="ccg-dtm__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag: widths: '480, 750, 1000, 1600', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ccg-dtm {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--ccg-sand);
    font-family: 'Karla', system-ui, sans-serif;
  }

  .ccg-dtm--left {
    grid-template-areas: 'media content';
  }

  .ccg-dtm--right {
    grid-template-areas: 'content media';
  }

  .ccg-dtm__media {
    grid-area: media;
    min-height: 540px;
    overflow: hidden;
  }

  .ccg-dtm__content {
    grid-area: content;
  }

  .ccg-dtm__media img,
  .ccg-dtm__media svg {
    width: 100%;
    height: 100%;
    min-height: 540px;
    object-fit: cover;
    display: block;
  }

  .ccg-dtm__content {
    padding: 96px 72px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: center;
  }

  .ccg-dtm__eyebrow {
    margin: 0;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ccg-tan);
  }

  .ccg-dtm__heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 32px;
    line-height: 1.3;
    color: var(--ccg-ink);
  }

  .ccg-dtm__description,
  .ccg-dtm__description p {
    margin: 0;
    font-size: 17px;
    line-height: 1.75;
    color: var(--ccg-muted);
    text-wrap: pretty;
  }

  .ccg-dtm__link {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ccg-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ccg-ink);
    align-self: flex-start;
    padding-bottom: 3px;
    margin-top: 8px;
  }

  @media screen and (max-width: 989px) {
    .ccg-dtm__content {
      padding: 64px 40px;
    }

    .ccg-dtm__heading {
      font-size: 26px;
    }
  }

  @media screen and (max-width: 749px) {
    .ccg-dtm {
      grid-template-columns: 1fr;
      grid-template-areas: 'media' 'content';
    }

    .ccg-dtm__media,
    .ccg-dtm__media img,
    .ccg-dtm__media svg {
      min-height: 320px;
    }

    .ccg-dtm__content {
      padding: 40px var(--ccg-container-pad) 56px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Direct to Maker",
  "tag": "section",
  "class": "container ccg-flush",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DIRECT TO MAKER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every piece leaves my hands before it reaches yours."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>No production line, no overseas factory. I hand cut, stitch and finish each cowl and jacket in a small-batch home studio in Arizona, using premium wool milled in the US. You are buying from the woman who made it, and she answers her own email.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read the whole story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ede7dc"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "CCG Direct to Maker"
    }
  ]
}
{% endschema %}
