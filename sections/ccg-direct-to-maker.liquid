{% render 'ccg-section-spacing' %}

<div class="ccg-dtm section">
  <div class="ccg-dtm__row ccg-dtm--{{ section.settings.media_position }}">
    <div class="ccg-dtm__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ccg-dtm__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ccg-dtm__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="ccg-dtm__description">{{ section.settings.description }}</div>
      {%- endif -%}


      {% if section.blocks.size > 0 %}
        <div class="ccg-dtm__list">

          {% for block in section.blocks %}
            <div class="ccg-dtm__list-item" {{ block.shopify_attributes }}>

              <span class="ccg-dtm__number">
                {{ forloop.index | prepend: '0' }}
              </span>

              <span class="ccg-dtm__text">
                {{ block.settings.text }}
              </span>

            </div>
          {% endfor %}

        </div>
      {% endif %}


      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="ccg-dtm__link">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>

    <div class="ccg-dtm__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag: widths: '480, 750, 1000, 1600', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .ccg-dtm {
    background: var(--ccg-sand);
    font-family: 'Karla', system-ui, sans-serif;
  }

  .ccg-dtm__row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
  }

  .ccg-dtm--left {
    grid-template-areas: 'media content';
  }

  .ccg-dtm--right {
    grid-template-areas: 'content media';
  }

  .ccg-dtm__media {
    grid-area: media;
    min-height: 540px;
    overflow: hidden;
  }

  .ccg-dtm__content {
    grid-area: content;
  }

  .ccg-dtm__media img,
  .ccg-dtm__media svg {
    width: 100%;
    height: 100%;
    min-height: 540px;
    object-fit: cover;
    display: block;
  }

  .ccg-dtm__content {
    padding:0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: center;
  }

  .ccg-dtm__eyebrow {
    margin: 0;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ccg-tan);
  }
  .ccg-dtm__heading {
      margin: 0;
      font-family: Rye,serif;
      font-weight: 400;
      font-size: 32px;
      line-height: 1.3;
      color: var(--ccg-ink);
      max-width: 483px;
  }
  .ccg-dtm__description,
  .ccg-dtm__description p {
    margin: 0;
    font-size: 17px;
    line-height: 1.75;
    color: var(--ccg-muted);
    text-wrap: pretty;
  }

  .ccg-dtm__link {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ccg-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ccg-ink);
    align-self: flex-start;
    padding-bottom: 3px;
    margin-top: 8px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .ccg-dtm__link:hover {
    color: var(--ccg-tan);
    border-color: var(--ccg-tan);
  }



  .ccg-dtm__list{
  display:flex;
  flex-direction:column;
  gap:18px;
  margin-top:10px;
}

.ccg-dtm__list-item {
    display: flex;
    align-items: center;
    gap: 20px;
}


.ccg-dtm__number {
    font-family: Rye, serif;
    font-size: 19px;
    color: rgb(185, 138, 82);
    line-height: 1;
    min-width: 30px;
}

.ccg-dtm__text {
    font-family: 'Karla', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.5;
    color: rgb(92, 81, 69);
    letter-spacing: .04em;
    font-weight: 300;
}


  @media screen and (max-width: 989px) {
    .ccg-dtm__content {
      padding: 64px 40px;
    }

    .ccg-dtm__heading {
      font-size: 22px;
    }
  }

  @media screen and (max-width: 749px) {
    .ccg-dtm__row {
      grid-template-columns: 1fr;
      grid-template-areas: 'media' 'content';
      gap:40px;
    }

    .ccg-dtm__media,
    .ccg-dtm__media img,
    .ccg-dtm__media svg {
      min-height: 320px;
    }
    .ccg-dtm__description,
    .ccg-dtm__description p{
      font-size: 16px;
    }
   .ccg-dtm__content {
      padding: 0;
    }
    .ccg-dtm__link {
      font-size: 14px;
    }
    .ccg-dtm {
       padding-bottom: 50px;
    }


    .ccg-dtm__list-item{
      gap:18px;
    }

    .ccg-dtm__number{
      font-size:20px;
    }

    .ccg-dtm__text{
      font-size:15px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Direct to Maker",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DIRECT TO MAKER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every piece leaves my hands before it reaches yours."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>No production line, no overseas factory. I hand cut, stitch and finish each cowl and jacket in a small-batch home studio in Arizona, using premium wool milled in the US. You are buying from the woman who made it, and she answers her own email.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read the whole story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ede7dc"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "list_item",
      "name": "List Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Pulled up over the ears for early feeding, jacket collar over the top."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CCG Direct to Maker"
    }
  ]
}
{% endschema %}
