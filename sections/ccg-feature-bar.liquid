{% render 'ccg-section-spacing' %}

<div class="ccg-features">
  {%- for block in section.blocks -%}
    <div class="ccg-features__item" {{ block.shopify_attributes }}>
      {%- if block.settings.icon != blank -%}
        <span class="ccg-features__icon">
          {{ block.settings.icon | image_url: width: 80 | image_tag: widths: '40, 60, 80', alt: block.settings.title }}
        </span>
      {%- endif -%}
      <span class="ccg-features__title">{{ block.settings.title }}</span>
      <span class="ccg-features__text">{{ block.settings.text }}</span>
    </div>
  {%- endfor -%}
</div>

{% stylesheet %}
  .ccg-features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--ccg-cream);
    border-top: 1px solid var(--ccg-hairline);
    font-family: 'Karla', system-ui, sans-serif;
  }

  .ccg-features__item {
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-right: 1px solid rgba(33, 28, 23, 0.12);
  }

  .ccg-features__item:last-child {
    border-right: 0;
  }

  .ccg-features__icon {
    width: 28px;
    height: 28px;
    margin-bottom: 4px;
  }

  .ccg-features__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ccg-features__title {
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 16px;
    color: var(--ccg-ink);
  }

  .ccg-features__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ccg-stone);
  }

  @media screen and (max-width: 749px) {
    .ccg-features {
      grid-template-columns: 1fr 1fr;
    }

    .ccg-features__item {
      padding: 28px 20px;
    }

    .ccg-features__item:nth-child(2n) {
      border-right: 0;
    }

    .ccg-features__item:nth-child(-n + 2) {
      border-bottom: 1px solid rgba(33, 28, 23, 0.12);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Feature Bar",
  "tag": "section",
  "class": "container ccg-flush",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f5ee"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon (optional)" },
        { "type": "text", "id": "title", "label": "Title", "default": "100% handmade" },
        { "type": "text", "id": "text", "label": "Text", "default": "Every piece hand cut, stitched and finished in a small-batch home studio." }
      ]
    }
  ],
  "presets": [
    {
      "name": "CCG Feature Bar",
      "blocks": [
        { "type": "feature", "settings": { "title": "100% handmade", "text": "Every piece hand cut, stitched and finished in a small-batch home studio." } },
        { "type": "feature", "settings": { "title": "Premium US wool", "text": "Sourced from American woolen mills for warmth and lasting texture." } },
        { "type": "feature", "settings": { "title": "One of a kind", "text": "No two cowls or jackets are identical. Your style stays your own." } },
        { "type": "feature", "settings": { "title": "Direct to maker", "text": "You buy from the artisan who made it, and she picks up the phone." } }
      ]
    }
  ]
}
{% endschema %}
