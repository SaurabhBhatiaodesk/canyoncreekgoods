<div class="ccg-features page-width">
  {%- for block in section.blocks -%}
    <div class="ccg-features__item" {{ block.shopify_attributes }}>
      <span class="ccg-features__icon">
        {%- if block.settings.icon != blank -%}
          {{ block.settings.icon | image_url: width: 80 | image_tag: widths: '40, 60, 80', alt: block.settings.title }}
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="12" cy="12" r="10.5" stroke="currentColor"></circle>
            <path d="M8 12.5l2.5 2.5L16 9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        {%- endif -%}
      </span>
      <span class="ccg-features__title">{{ block.settings.title }}</span>
      <span class="ccg-features__text">{{ block.settings.text }}</span>
    </div>
  {%- endfor -%}
</div>

{% stylesheet %}
  .ccg-features {
    --ccg-ink: #211c17;
    --ccg-tan: #7a6d5d;

    font-family: 'Karla', system-ui, sans-serif;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    padding-block: 56px;
    border-top: 1px solid var(--ccg-ink);
    border-bottom: 1px solid var(--ccg-ink);
  }

  .ccg-features__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }

  .ccg-features__icon {
    width: 32px;
    height: 32px;
    color: var(--ccg-ink);
  }

  .ccg-features__icon svg,
  .ccg-features__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ccg-features__title {
    font-family: 'Rye', serif;
    font-size: 16px;
    color: var(--ccg-ink);
  }

  .ccg-features__text {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ccg-tan);
    max-width: 26ch;
  }

  @media screen and (max-width: 749px) {
    .ccg-features {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px 16px;
      padding-block: 36px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Feature Bar",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon (optional)" },
        { "type": "text", "id": "title", "label": "Title", "default": "100% handmade" },
        { "type": "text", "id": "text", "label": "Text", "default": "Every piece hand cut, stitched and finished in a small-batch home studio." }
      ]
    }
  ],
  "presets": [
    {
      "name": "CCG Feature Bar",
      "blocks": [
        { "type": "feature", "settings": { "title": "100% handmade", "text": "Every piece hand cut, stitched and finished in a small-batch home studio." } },
        { "type": "feature", "settings": { "title": "Premium US wool", "text": "Sourced from American woolen mills for warmth and lasting texture." } },
        { "type": "feature", "settings": { "title": "One of a kind", "text": "No two cowls or jackets are identical. Your style stays your own." } },
        { "type": "feature", "settings": { "title": "Direct to maker", "text": "You buy from the artisan who made it, and she picks up the phone." } }
      ]
    }
  ]
}
{% endschema %}
