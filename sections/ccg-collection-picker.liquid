{% render 'ccg-section-spacing' %}

<div class="ccg-picker">
  <div class="ccg-picker__head">
    <div class="ccg-picker__head-text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ccg-picker__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ccg-picker__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link | default: '#' }}" class="ccg-picker__link">{{ section.settings.link_label }} →</a>
    {%- endif -%}
  </div>

  <div class="ccg-picker__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tile_image = block.settings.image
        assign tile_title = block.settings.title
        assign tile_subtitle = block.settings.subtitle
        assign tile_link = block.settings.link
        if block.settings.collection != blank
          assign coll = block.settings.collection
          if tile_image == blank
            assign tile_image = coll.featured_image
          endif
          if tile_title == blank
            assign tile_title = coll.title
          endif
          if tile_link == blank
            assign tile_link = coll.url
          endif
        endif
      -%}
      <a
        href="{{ tile_link | default: '#' }}"
        class="ccg-picker__tile"
        {{ block.shopify_attributes }}
      >
        <span class="ccg-picker__tile-media">
          {%- if tile_image != blank -%}
            {{
              tile_image
              | image_url: width: 1200
              | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 990px) 25vw, 50vw', alt: tile_title
            }}
          {%- else -%}
            {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </span>
        <span class="ccg-picker__tile-caption">
          <span class="ccg-picker__tile-title">{{ tile_title }}</span>
          {%- if tile_subtitle != blank -%}
            <span class="ccg-picker__tile-subtitle">{{ tile_subtitle }}</span>
          {%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .ccg-picker {
    font-family: 'Karla', system-ui, sans-serif;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .ccg-picker__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }

  .ccg-picker__head-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ccg-picker__eyebrow {
    margin: 0;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ccg-tan);
  }

  .ccg-picker__heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 33px;
    color: var(--ccg-ink);
  }

  .ccg-picker__link {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ccg-tan);
    text-decoration: none;
    border-bottom: 1px solid rgba(138, 90, 50, 0.5);
    padding-bottom: 3px;
    white-space: nowrap;
  }

  .ccg-picker__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .ccg-picker__tile {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
  }

  .ccg-picker__tile-media {
    display: block;
    height: 420px;
    overflow: hidden;
    background: var(--ccg-sand);
  }

  .ccg-picker__tile-media img,
  .ccg-picker__tile-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .ccg-picker__tile:hover .ccg-picker__tile-media img {
    transform: scale(1.04);
  }

  .ccg-picker__tile-caption {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ccg-picker__tile-title {
    font-family: 'Rye', serif;
    font-size: 19px;
    font-weight: 400;
    color: var(--ccg-ink);
  }

  .ccg-picker__tile-subtitle {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ccg-stone);
  }

  @media screen and (max-width: 989px) {
    .ccg-picker__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ccg-picker__tile-media {
      height: 320px;
    }
  }

  @media screen and (max-width: 599px) {
    .ccg-picker {
      gap: 28px;
    }

    .ccg-picker__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .ccg-picker__heading {
      font-size: 26px;
    }

    .ccg-picker__grid {
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .ccg-picker__tile-media {
      height: 220px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Collection Picker",
  "tag": "section",
  "class": "container",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SHOP COLLECTIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick your armor"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Everything in the shop"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f5ee"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "24 pieces · from $59"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CCG Collection Picker",
      "blocks": [
        { "type": "tile", "settings": { "title": "Wool Cowls", "subtitle": "24 pieces · from $59" } },
        { "type": "tile", "settings": { "title": "Sling Bags", "subtitle": "Pairs with the cowls" } },
        { "type": "tile", "settings": { "title": "Denim & Dusters", "subtitle": "4 collections" } },
        { "type": "tile", "settings": { "title": "Sweatshirts", "subtitle": "Buttery soft" } }
      ]
    }
  ]
}
{% endschema %}
