{% render 'ccg-section-spacing' %}

<div class="ccg-sellers">
  <div class="ccg-sellers__head">
    {%- if section.settings.heading != blank -%}
      <h2 class="ccg-sellers__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}
      <p class="ccg-sellers__note">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
  </div>

  <div class="ccg-sellers__grid">
    {%- if section.settings.collection != blank -%}
      {%- for product in section.settings.collection.products limit: section.settings.product_limit -%}
        {%- liquid
          assign badge = ''
          if product.tags contains 'best-seller'
            assign badge = 'Best seller'
          elsif product.tags contains 'last-one'
            assign badge = 'Last one'
          elsif product.tags contains 'one-of-one'
            assign badge = 'One of one'
          elsif product.tags contains 'new'
            assign badge = 'New'
          endif
        -%}
        <a href="{{ product.url }}" class="ccg-seller-card">
          <span class="ccg-seller-card__media">
            {%- if product.featured_image != blank -%}
              {{ product.featured_image | image_url: width: 800 | image_tag: widths: '300, 500, 800', alt: product.title }}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
            {%- if badge != blank -%}
              <span class="ccg-seller-card__badge">{{ badge }}</span>
            {%- endif -%}
          </span>
          <span class="ccg-seller-card__meta">
            <span class="ccg-seller-card__title">{{ product.title }}</span>
            <span class="ccg-seller-card__price">{{ product.price | money }}</span>
          </span>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign card_image = product.featured_image | default: block.settings.image
          assign card_title = product.title | default: block.settings.title
          assign card_price = product.price | money | default: block.settings.price
          assign card_url = product.url | default: block.settings.link
        -%}
        <a href="{{ card_url | default: '#' }}" class="ccg-seller-card" {{ block.shopify_attributes }}>
          <span class="ccg-seller-card__media">
            {%- if card_image != blank -%}
              {{ card_image | image_url: width: 800 | image_tag: widths: '300, 500, 800', alt: card_title }}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
            {%- if block.settings.badge_text != blank -%}
              <span class="ccg-seller-card__badge">{{ block.settings.badge_text }}</span>
            {%- endif -%}
          </span>
          <span class="ccg-seller-card__meta">
            <span class="ccg-seller-card__title">{{ card_title }}</span>
            <span class="ccg-seller-card__price">{{ card_price }}</span>
          </span>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ccg-sellers {
    font-family: 'Karla', system-ui, sans-serif;
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  .ccg-sellers__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    border-top: 1px solid var(--ccg-hairline);
    padding-top: 34px;
  }

  .ccg-sellers__heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 33px;
    color: var(--ccg-ink);
  }

  .ccg-sellers__note {
    margin: 0;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--ccg-stone);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ccg-sellers__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .ccg-seller-card {
    display: flex;
    flex-direction: column;
    gap: 13px;
    text-decoration: none;
    color: var(--ccg-ink);
  }

  .ccg-seller-card__media {
    position: relative;
    display: block;
    height: 410px;
    overflow: hidden;
    background: var(--ccg-sand);
  }

  .ccg-seller-card__media img,
  .ccg-seller-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .ccg-seller-card:hover .ccg-seller-card__media img {
    transform: scale(1.04);
  }

  .ccg-seller-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.16em;
    background: var(--ccg-cream-soft);
    color: var(--ccg-ink);
    padding: 5px 11px;
    text-transform: uppercase;
  }

  .ccg-seller-card__meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ccg-seller-card__title {
    font-size: 17px;
    line-height: 1.35;
    color: var(--ccg-ink);
  }

  .ccg-seller-card__price {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px;
    letter-spacing: 0.08em;
    color: var(--ccg-stone);
  }

  @media screen and (max-width: 989px) {
    .ccg-sellers__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ccg-seller-card__media {
      height: 340px;
    }
  }

  @media screen and (max-width: 749px) {
    .ccg-sellers {
      gap: 24px;
    }

    .ccg-sellers__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .ccg-sellers__heading {
      font-size: 26px;
    }

    .ccg-sellers__note {
      white-space: normal;
    }

    .ccg-seller-card__media {
      height: 260px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Best Sellers",
  "tag": "section",
  "class": "container",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Note (right side)",
      "default": "OUT THE DOOR IN 1–2 DAYS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to ride out"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f5ee"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Pulls products automatically from this collection. Leave blank to add products manually below."
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.collection != blank }}"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "price", "label": "Price override" },
        { "type": "url", "id": "link", "label": "Link override" },
        {
          "type": "select",
          "id": "badge_text",
          "label": "Badge",
          "options": [
            { "value": "", "label": "None" },
            { "value": "Best seller", "label": "Best seller" },
            { "value": "Last one", "label": "Last one" },
            { "value": "One of one", "label": "One of one" },
            { "value": "New", "label": "New" }
          ],
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CCG Best Sellers",
      "blocks": [
        { "type": "product", "settings": { "title": "Wool Cowl Scarf — Nehalem", "price": "$79.00", "badge_text": "Best seller" } },
        { "type": "product", "settings": { "title": "Wool Cowl Scarf — Turquoise Chief", "price": "$79.00", "badge_text": "Last one" } },
        { "type": "product", "settings": { "title": "Western Cowl — Grey Aztec", "price": "$59.00", "badge_text": "One of one" } },
        { "type": "product", "settings": { "title": "Wool Cowl Scarf — Journey West", "price": "$79.00", "badge_text": "New" } }
      ]
    }
  ]
}
{% endschema %}
