<div class="ccg-sellers page-width">
  <div class="ccg-sellers__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ccg-sellers__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ccg-sellers__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="ccg-sellers__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign product = block.settings.product
        assign card_image = product.featured_image | default: block.settings.image
        assign card_title = product.title | default: block.settings.title
        assign card_price = product.price | money | default: block.settings.price
        assign card_url = product.url | default: block.settings.link
      -%}
      <a href="{{ card_url | default: '#' }}" class="ccg-seller-card" {{ block.shopify_attributes }}>
        <span class="ccg-seller-card__media">
          {%- if card_image != blank -%}
            {{ card_image | image_url: width: 800 | image_tag: widths: '300, 500, 800', alt: card_title }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          {%- if block.settings.badge_text != blank -%}
            <span class="ccg-seller-card__badge">{{ block.settings.badge_text }}</span>
          {%- endif -%}
        </span>
        <span class="ccg-seller-card__title">{{ card_title }}</span>
        <span class="ccg-seller-card__price">{{ card_price }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .ccg-sellers {
    --ccg-ink: #211c17;
    --ccg-tan: #7a6d5d;

    font-family: 'Karla', system-ui, sans-serif;
    padding-block: 72px;
  }

  .ccg-sellers__head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-bottom: 36px;
  }

  .ccg-sellers__eyebrow {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ccg-tan);
  }

  .ccg-sellers__heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: clamp(26px, 3vw, 34px);
    color: var(--ccg-ink);
  }

  .ccg-sellers__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .ccg-seller-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: var(--ccg-ink);
  }

  .ccg-seller-card__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #eee7db;
  }

  .ccg-seller-card__media img,
  .ccg-seller-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .ccg-seller-card:hover .ccg-seller-card__media img {
    transform: scale(1.04);
  }

  .ccg-seller-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--ccg-ink);
    color: #fbf8f2;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 9px;
  }

  .ccg-seller-card__title {
    font-size: 14px;
    line-height: 1.4;
    margin-top: 4px;
  }

  .ccg-seller-card__price {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--ccg-tan);
  }

  @media screen and (max-width: 989px) {
    .ccg-sellers__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .ccg-sellers {
      padding-block: 44px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Best Sellers",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUT THE DOOR IN 1–2 DAYS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to ride out"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "price", "label": "Price override" },
        { "type": "url", "id": "link", "label": "Link override" },
        {
          "type": "select",
          "id": "badge_text",
          "label": "Badge",
          "options": [
            { "value": "", "label": "None" },
            { "value": "BEST SELLER", "label": "Best seller" },
            { "value": "LAST ONE", "label": "Last one" },
            { "value": "ONE OF ONE", "label": "One of one" },
            { "value": "NEW", "label": "New" }
          ],
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CCG Best Sellers",
      "blocks": [
        { "type": "product", "settings": { "title": "Wool Cowl Scarf — Nehalem", "price": "$79.00", "badge_text": "BEST SELLER" } },
        { "type": "product", "settings": { "title": "Wool Cowl Scarf — Turquoise Chief", "price": "$79.00", "badge_text": "LAST ONE" } },
        { "type": "product", "settings": { "title": "Western Cowl — Grey Aztec", "price": "$59.00", "badge_text": "ONE OF ONE" } },
        { "type": "product", "settings": { "title": "Wool Cowl Scarf — Journey West", "price": "$79.00", "badge_text": "NEW" } }
      ]
    }
  ]
}
{% endschema %}
