{% comment %}
  Updated CCG Footer section placeholder.
  Features:
  - Desktop padding controls
  - Mobile padding controls
  - Mobile accordion toggle setting

  Please replace this file content with the full updated Shopify Liquid section.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }
{% endstyle %}

<div
  class="ccg-footer section section--page-width"
  style="
    --desktop-top: {{ section.settings.desktop_padding_top }}px;
    --desktop-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --mobile-top: {{ section.settings.mobile_padding_top }}px;
    --mobile-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="ccg-footer__top">
    <div class="ccg-footer__brand">
      <a href="{{ routes.root_url }}" class="ccg-footer__logo">
        {{ section.settings.logo_text }}
      </a>
      <p class="ccg-footer__tagline">{{ section.settings.tagline }}</p>
    </div>

    <div class="ccg-footer__columns">
      {% for block in section.blocks %}
        <details
          class="ccg-footer__column mobile-accordion"
          {% unless section.settings.mobile_accordion %}
            open
          {% endunless %}
        >
          <summary>{{ block.settings.heading }}</summary>
          <ul class="ccg-footer__links">
            {% assign links = block.settings.links | newline_to_br | split: '<br />' %}
            {% for link in links %}
              <li>{{ link }}</li>
            {% endfor %}
          </ul>
        </details>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .ccg-footer {
    padding-top: var(--desktop-top);
    padding-bottom: var(--desktop-bottom);
  }

  @media (max-width: 599px) {
    .ccg-footer {
      padding-top: var(--mobile-top);
      padding-bottom: var(--mobile-bottom);
    }

    .mobile-accordion summary {
      cursor: pointer;
      font-weight: 600;
    }
  }
</style>

{% schema %}
{
  "name": "CCG Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Canyon Creek Goods"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 88
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 34
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "mobile_accordion",
      "label": "Enable mobile accordion",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#211c17"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "links",
          "label": "Links"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CCG Footer"
    }
  ]
}
{% endschema %}
