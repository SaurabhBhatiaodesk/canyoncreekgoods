{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }
{% endstyle %}

{%- assign footer_logo_text = section.settings.logo_text | default: shop.name -%}

<div class="ccg-footer section section--page-width" style="--ccg-ink: {{ section.settings.ink_color }}; --ccg-tan: {{ section.settings.tan_color }}; --ccg-heading: {{ section.settings.heading_color }}; --ccg-link: {{ section.settings.link_color }}; --ccg-logo: {{ section.settings.logo_color }}; --ccg-divider: {{ section.settings.divider_color }}; --ccg-bottom: {{ section.settings.bottom_text_color }}; --ccg-logo-width: {{ section.settings.logo_width }}px;">
  <div class="ccg-footer__top">
    <div class="ccg-footer__brand">
      <a href="{{ routes.root_url }}" class="ccg-footer__logo" aria-label="{{ footer_logo_text }}">
        {%- if section.settings.logo_image != blank -%}
          {{
            section.settings.logo_image
            | image_url: width: 320
            | image_tag: widths: '120, 180, 240, 320', alt: footer_logo_text, class: 'ccg-footer__logo-image'
          }}
        {%- else -%}
          {{ footer_logo_text }}
        {%- endif -%}
      </a>
      {%- if section.settings.tagline != blank -%}
        <p class="ccg-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
      {%- if section.settings.instagram_url != blank or section.settings.facebook_url != blank or section.settings.tiktok_url != blank or section.settings.pinterest_url != blank -%}
        <div class="ccg-footer__social">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}">Instagram</a>
          {%- endif -%}
          {%- if section.settings.facebook_url != blank -%}
            <a href="{{ section.settings.facebook_url }}">Facebook</a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <a href="{{ section.settings.tiktok_url }}">TikTok</a>
          {%- endif -%}
          {%- if section.settings.pinterest_url != blank -%}
            <a href="{{ section.settings.pinterest_url }}">Pinterest</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="ccg-footer__columns">
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div class="ccg-footer__column" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <p class="ccg-footer__column-heading">{{ block.settings.heading }}</p>
            {%- endif -%}
            <ul class="ccg-footer__links">
              {%- assign lines = block.settings.links | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign line = line | strip -%}
                {%- if line != blank -%}
                  {%- assign parts = line | split: '|' -%}
                  <li>
                    <a href="{{ parts[1] | strip | default: '#' }}">{{ parts[0] | strip }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="ccg-footer__bottom">
    {%- if section.settings.copyright_text != blank -%}
      <p class="ccg-footer__copyright">{{ section.settings.copyright_text }}</p>
    {%- else -%}
      <p class="ccg-footer__copyright">© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    {%- endif -%}
    {%- if section.settings.payment_text != blank -%}
      <p class="ccg-footer__payment">{{ section.settings.payment_text }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ccg-footer {
    font-family: 'Karla', system-ui, sans-serif;
    padding-block: 88px 34px;
    border-top: 1px solid var(--ccg-divider);
  }

  .ccg-footer__top {
    display: grid;
    grid-template-columns: minmax(260px, 1.4fr) repeat(3, minmax(150px, 0.8fr));
    gap: clamp(40px, 7vw, 104px);
    padding-bottom: 78px;
  }

  .ccg-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ccg-footer__logo {
    font-family: 'Rye', serif;
    font-size: 20px;
    color: var(--ccg-logo);
    text-decoration: none;
    width: fit-content;
    line-height: 1.1;
  }

  .ccg-footer__logo-image {
    width: min(var(--ccg-logo-width), 100%);
    height: auto;
    display: block;
    object-fit: contain;
  }

  .ccg-footer__tagline {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.9;
    color: var(--ccg-tan);
    max-width: 38ch;
  }

  .ccg-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
    margin-top: 10px;
  }

  .ccg-footer__social a {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ccg-heading);
    text-decoration: none;
  }

  .ccg-footer__social a:not(:last-child)::after {
    content: '·';
    margin-inline: 8px;
    color: var(--ccg-tan);
  }

  .ccg-footer__social a:hover {
    text-decoration: underline;
  }

  .ccg-footer__columns {
    display: contents;
  }

  .ccg-footer__column {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ccg-footer__column-heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-size: 18px;
    font-weight: 400;
    color: var(--ccg-heading);
  }

  .ccg-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .ccg-footer__links a {
    font-size: 16px;
    color: var(--ccg-link);
    text-decoration: none;
  }

  .ccg-footer__links a:hover {
    color: var(--ccg-heading);
    text-decoration: underline;
  }

  .ccg-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 30px;
    border-top: 1px solid var(--ccg-divider);
  }

  .ccg-footer__copyright,
  .ccg-footer__payment {
    margin: 0;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 16px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ccg-bottom);
  }

  .ccg-footer__payment {
    text-align: right;
  }

  @media screen and (max-width: 989px) {
    .ccg-footer__top {
      grid-template-columns: 1.2fr repeat(3, 1fr);
      gap: 28px;
    }

    .ccg-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 599px) {
    .ccg-footer {
      padding-block: 48px 28px;
    }

    .ccg-footer__top {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-bottom: 40px;
    }

    .ccg-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .ccg-footer__payment {
      text-align: left;
    }
  }
{% endstylesheet %}

