{% render 'ccg-section-spacing' %}

<div class="ccg-shows">
  <div class="ccg-shows__intro">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ccg-shows__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ccg-shows__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="ccg-shows__description">{{ section.settings.description }}</div>
    {%- endif -%}
  </div>

  <ul class="ccg-shows__list">
    {%- for block in section.blocks -%}
      <li class="ccg-shows__row" {{ block.shopify_attributes }}>
        <span class="ccg-shows__date">{{ block.settings.date_range }}</span>
        <span class="ccg-shows__copy">
          <span class="ccg-shows__name">{{ block.settings.name }}</span>
          <span class="ccg-shows__location">{{ block.settings.location }}</span>
        </span>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="ccg-shows__link" aria-label="{{ block.settings.name }}"></a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .ccg-shows {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 64px;
    font-family: 'Karla', system-ui, sans-serif;
    background: var(--ccg-sand);
  }

  .ccg-shows__intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ccg-shows__eyebrow {
    margin: 0;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ccg-tan);
  }

  .ccg-shows__heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: 32px;
    line-height: 1.25;
    color: var(--ccg-ink);
  }

  .ccg-shows__description,
  .ccg-shows__description p {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ccg-muted);
    max-width: 380px;
    text-wrap: pretty;
  }

  .ccg-shows__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .ccg-shows__row {
    position: relative;
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 20px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--ccg-hairline);
  }

  .ccg-shows__date {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 19px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ccg-tan);
  }

  .ccg-shows__copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .ccg-shows__name {
    font-size: 18px;
    color: var(--ccg-ink);
  }

  .ccg-shows__location {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 16px;
    letter-spacing: 0.1em;
    color: var(--ccg-stone);
    text-transform: uppercase;
  }

  .ccg-shows__link {
    position: absolute;
    inset: 0;
  }

  @media screen and (max-width: 989px) {
    .ccg-shows {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media screen and (max-width: 749px) {
    .ccg-shows__heading {
      font-size: 26px;
    }

    .ccg-shows__row {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .ccg-shows__description,
    .ccg-shows__description p {
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Shows List",
  "tag": "section",
  "class": "container",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ON THE ROAD"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Come find the booth"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Most pieces sell at shows before they ever reach the site. If you are close to one of these, come try things on.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ede7dc"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "show",
      "name": "Show",
      "settings": [
        { "type": "text", "id": "date_range", "label": "Date range", "default": "AUGUST 8–9" },
        { "type": "text", "id": "name", "label": "Show name", "default": "Ridgway Rendezvous" },
        { "type": "text", "id": "location", "label": "Location", "default": "RIDGWAY, COLORADO" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CCG Shows List",
      "blocks": [
        { "type": "show", "settings": { "date_range": "AUGUST 8–9", "name": "Ridgway Rendezvous", "location": "RIDGWAY, COLORADO" } },
        { "type": "show", "settings": { "date_range": "SEPTEMBER 4–6", "name": "High Country Art Association", "location": "PINETOP-LAKESIDE, ARIZONA" } },
        { "type": "show", "settings": { "date_range": "SEPTEMBER 19–20", "name": "Durango Autumn Arts Festival", "location": "DURANGO, COLORADO" } },
        { "type": "show", "settings": { "date_range": "SEPTEMBER 24–27", "name": "Telluride Autumn Classic", "location": "MOUNTAIN VILLAGE, COLORADO" } },
        { "type": "show", "settings": { "date_range": "OCTOBER 10–11", "name": "Sedona Arts Festival", "location": "SEDONA, ARIZONA" } }
      ]
    }
  ]
}
{% endschema %}
