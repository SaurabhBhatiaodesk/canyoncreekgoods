<div class="ccg-shows section section--page-width">
  <div class="ccg-shows__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ccg-shows__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ccg-shows__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="ccg-shows__description">{{ section.settings.description }}</div>
    {%- endif -%}
  </div>

  <ul class="ccg-shows__list">
    {%- for block in section.blocks -%}
      <li class="ccg-shows__row" {{ block.shopify_attributes }}>
        <span class="ccg-shows__date">{{ block.settings.date_range }}</span>
        <span class="ccg-shows__name">{{ block.settings.name }}</span>
        <span class="ccg-shows__location">{{ block.settings.location }}</span>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="ccg-shows__link" aria-label="{{ block.settings.name }}"></a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .ccg-shows {
    --ccg-ink: #211c17;
    --ccg-tan: #7a6d5d;

    font-family: 'Karla', system-ui, sans-serif;
    padding-block: 72px;
  }

  .ccg-shows__head {
    max-width: 56ch;
    margin: 0 auto 36px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .ccg-shows__eyebrow {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ccg-tan);
  }

  .ccg-shows__heading {
    margin: 0;
    font-family: 'Rye', serif;
    font-weight: 400;
    font-size: clamp(26px, 3vw, 34px);
    color: var(--ccg-ink);
  }

  .ccg-shows__description {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ccg-ink);
  }

  .ccg-shows__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ccg-ink);
  }

  .ccg-shows__row {
    position: relative;
    display: grid;
    grid-template-columns: 160px 1fr auto;
    align-items: center;
    gap: 20px;
    padding: 20px 4px;
    border-bottom: 1px solid var(--ccg-ink);
  }

  .ccg-shows__date {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ccg-tan);
  }

  .ccg-shows__name {
    font-family: 'Rye', serif;
    font-size: 19px;
    color: var(--ccg-ink);
  }

  .ccg-shows__location {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ccg-tan);
    text-align: right;
  }

  .ccg-shows__link {
    position: absolute;
    inset: 0;
  }

  @media screen and (max-width: 749px) {
    .ccg-shows {
      padding-block: 44px;
    }

    .ccg-shows__row {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 16px 2px;
    }

    .ccg-shows__location {
      text-align: left;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CCG Shows List",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ON THE ROAD"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Come find the booth"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Most pieces sell at shows before they ever reach the site. If you are close to one of these, come try things on.</p>"
    }
  ],
  "blocks": [
    {
      "type": "show",
      "name": "Show",
      "settings": [
        { "type": "text", "id": "date_range", "label": "Date range", "default": "AUGUST 8–9" },
        { "type": "text", "id": "name", "label": "Show name", "default": "Ridgway Rendezvous" },
        { "type": "text", "id": "location", "label": "Location", "default": "RIDGWAY, COLORADO" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CCG Shows List",
      "blocks": [
        { "type": "show", "settings": { "date_range": "AUGUST 8–9", "name": "Ridgway Rendezvous", "location": "RIDGWAY, COLORADO" } },
        { "type": "show", "settings": { "date_range": "SEPTEMBER 4–6", "name": "High Country Art Association", "location": "PINETOP-LAKESIDE, ARIZONA" } },
        { "type": "show", "settings": { "date_range": "SEPTEMBER 19–20", "name": "Durango Autumn Arts Festival", "location": "DURANGO, COLORADO" } },
        { "type": "show", "settings": { "date_range": "SEPTEMBER 24–27", "name": "Telluride Autumn Classic", "location": "MOUNTAIN VILLAGE, COLORADO" } },
        { "type": "show", "settings": { "date_range": "OCTOBER 10–11", "name": "Sedona Arts Festival", "location": "SEDONA, ARIZONA" } }
      ]
    }
  ]
}
{% endschema %}
